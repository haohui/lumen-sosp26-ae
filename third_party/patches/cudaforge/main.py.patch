+def _resolve_prompt_gpu_name(gpu_name: str) -> str:
+    """Prompt templates require GPU name keys from gpu_specs.py; fallback when unknown."""
+    try:
+        specs = _load_gpu_spec()
+    except Exception:
+        return gpu_name
+
+    if gpu_name in specs:
+        return gpu_name
+
+    normalized = gpu_name.strip().lower()
+    # Normalize common ROCm runtime names to prompt-table keys.
+    if "mi300x" in normalized:
+        for name in ("MI300X", "AMD Instinct MI300X"):
+            if name in specs:
+                return name
+
+    preferred = ["MI300X", "AMD Instinct MI300X"]
+    fallback = next(
+        (name for name in preferred if name in specs),
+        next(iter(specs), gpu_name),
+    )
+    print(f"[Prompt GPU] '{gpu_name}' not found in gpu_specs.py, fallback to '{fallback}'.")
+    return fallback
+
+
+def _looks_nvidia_gpu_name(gpu_name: str) -> bool:
+    markers = (
+        "NVIDIA",
+        "H100",
+        "H200",
+        "A100",
+        "L40",
+        "RTX",
+        "GEFORCE",
+        "TESLA",
+        "T4",
+        "A10",
+        "QUADRO",
+    )
+    up = str(gpu_name or "").strip().upper()
+    return any(m in up for m in markers)
+
+
+def _looks_amd_gpu_name(gpu_name: str) -> bool:
+    markers = ("AMD", "MI", "INSTINCT", "RADEON", "CDNA", "RDNA", "GFX")
+    up = str(gpu_name or "").strip().upper()
+    return any(m in up for m in markers)
+
+
+def _validate_backend_gpu_combo(*, backend: str, gpu_name: str) -> None:
+    b = str(backend or "").strip().lower()
+    g = str(gpu_name or "").strip()
+    if not g:
+        return
+    if b == "hip" and _looks_nvidia_gpu_name(g):
+        raise ValueError(
+            f"backend=hip but --gpu={gpu_name!r} looks NVIDIA-oriented. "
+            "For ROCm runs, use an AMD target (for example: --gpu MI300X)."
+        )
+    if b == "cuda" and _looks_amd_gpu_name(g):
+        raise ValueError(
+            f"backend=cuda but --gpu={gpu_name!r} looks AMD-oriented. "
+            "For MI300X/ROCm runs, use --backend hip."
+        )
+
+
