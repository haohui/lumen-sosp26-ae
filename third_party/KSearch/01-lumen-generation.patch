diff --git a/k_search/utils/round_artifacts.py b/k_search/utils/round_artifacts.py
new file mode 100644
index 0000000..0207218
--- /dev/null
+++ b/k_search/utils/round_artifacts.py
@@ -0,0 +1,170 @@
+from __future__ import annotations
+
+import json
+import uuid
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Optional
+
+from k_search.utils.paths import get_ksearch_artifacts_dir
+
+
+def _json_safe(value: Any) -> Any:
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, dict):
+        out: dict[str, Any] = {}
+        for k, v in value.items():
+            out[str(k)] = _json_safe(v)
+        return out
+    if isinstance(value, (list, tuple, set)):
+        return [_json_safe(v) for v in value]
+    try:
+        enum_value = getattr(value, "value", None)
+        if enum_value is not None:
+            return _json_safe(enum_value)
+    except Exception:
+        pass
+    return str(value)
+
+
+def _safe_relative_path(path_text: str) -> str:
+    p = Path(str(path_text or ""))
+    s = str(p.as_posix()).strip()
+    if not s:
+        return "unknown.txt"
+    s = s.lstrip("/")
+    s = s.replace("..", "__")
+    return s
+
+
+class RoundArtifactWriter:
+    """
+    Persist per-round generation/evaluation artifacts under:
+      <artifacts>/<definition>/rounds/<run_id>/round_XXX/
+    """
+
+    def __init__(
+        self,
+        *,
+        definition_name: str,
+        model_name: str,
+        language: str,
+        target_gpu: str,
+        llm_backend: str,
+        reasoning_effort: str,
+        artifacts_dir: Optional[str],
+    ) -> None:
+        root = get_ksearch_artifacts_dir(
+            base_dir=artifacts_dir,
+            task_name=str(definition_name or "__unknown__"),
+        ).resolve()
+        ts = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
+        self.run_id = f"{ts}_{uuid.uuid4().hex[:8]}"
+        self.run_dir = root / "rounds" / self.run_id
+        self.run_dir.mkdir(parents=True, exist_ok=True)
+
+        run_meta = {
+            "definition": str(definition_name or ""),
+            "model_name": str(model_name or ""),
+            "language": str(language or ""),
+            "target_gpu": str(target_gpu or ""),
+            "llm_backend": str(llm_backend or ""),
+            "reasoning_effort": str(reasoning_effort or ""),
+            "run_id": str(self.run_id),
+            "created_at_utc": datetime.utcnow().isoformat(timespec="seconds") + "Z",
+        }
+        (self.run_dir / "run_meta.json").write_text(
+            json.dumps(_json_safe(run_meta), ensure_ascii=False, indent=2),
+            encoding="utf-8",
+        )
+
+    def write_round(
+        self,
+        *,
+        round_num: int,
+        prompt_text: str,
+        raw_response_text: str,
+        cleaned_code: Any,
+        eval_result: Any,
+        solution: Any,
+        trace_logs_text: str = "",
+        world_model_text: str = "",
+        extra: Optional[dict[str, Any]] = None,
+    ) -> Path:
+        round_dir = self.run_dir / f"round_{int(round_num):03d}"
+        round_dir.mkdir(parents=True, exist_ok=True)
+
+        if str(prompt_text or "").strip():
+            (round_dir / "prompt.txt").write_text(str(prompt_text), encoding="utf-8")
+        if str(raw_response_text or "").strip():
+            (round_dir / "raw_response.txt").write_text(str(raw_response_text), encoding="utf-8")
+        if str(trace_logs_text or "").strip():
+            (round_dir / "trace_logs_for_prompt.txt").write_text(str(trace_logs_text), encoding="utf-8")
+        if str(world_model_text or "").strip():
+            (round_dir / "world_model.json").write_text(str(world_model_text), encoding="utf-8")
+
+        cleaned_dir = round_dir / "cleaned"
+        cleaned_dir.mkdir(parents=True, exist_ok=True)
+        if isinstance(cleaned_code, dict):
+            for path_text, content in cleaned_code.items():
+                safe_rel = _safe_relative_path(str(path_text or ""))
+                out_path = cleaned_dir / safe_rel
+                out_path.parent.mkdir(parents=True, exist_ok=True)
+                out_path.write_text(str(content or ""), encoding="utf-8")
+        else:
+            (cleaned_dir / "main.py").write_text(str(cleaned_code or ""), encoding="utf-8")
+
+        eval_payload: dict[str, Any]
+        if hasattr(eval_result, "to_dict") and callable(getattr(eval_result, "to_dict")):
+            try:
+                eval_payload = eval_result.to_dict(include_log_excerpt=True, max_str_chars=20000, max_log_chars=20000)
+            except Exception:
+                eval_payload = _json_safe(getattr(eval_result, "__dict__", {}))
+        else:
+            eval_payload = _json_safe(getattr(eval_result, "__dict__", {}))
+        (round_dir / "eval_result.json").write_text(
+            json.dumps(_json_safe(eval_payload), ensure_ascii=False, indent=2),
+            encoding="utf-8",
+        )
+
+        try:
+            perf_lines = eval_result.perf_summary_lines(prefix="round")
+        except Exception:
+            perf_lines = []
+        if perf_lines:
+            (round_dir / "eval_summary.txt").write_text("\n".join([str(x) for x in perf_lines]) + "\n", encoding="utf-8")
+
+        sol_payload = None
+        if hasattr(solution, "to_dict") and callable(getattr(solution, "to_dict")):
+            try:
+                sol_payload = solution.to_dict()
+            except Exception:
+                sol_payload = None
+        if sol_payload is None:
+            sol_payload = _json_safe(getattr(solution, "__dict__", {}))
+        (round_dir / "solution.json").write_text(
+            json.dumps(_json_safe(sol_payload), ensure_ascii=False, indent=2),
+            encoding="utf-8",
+        )
+
+        meta = {
+            "round_num": int(round_num),
+            "saved_at_utc": datetime.utcnow().isoformat(timespec="seconds") + "Z",
+            "status": str(getattr(eval_result, "status", "") or ""),
+            "score": (
+                float(eval_result.score())
+                if hasattr(eval_result, "score") and callable(getattr(eval_result, "score"))
+                else None
+            ),
+            "prompt_chars": len(str(prompt_text or "")),
+            "raw_response_chars": len(str(raw_response_text or "")),
+            "trace_logs_chars": len(str(trace_logs_text or "")),
+            "world_model_chars": len(str(world_model_text or "")),
+            "extra": (extra or {}),
+        }
+        (round_dir / "round_meta.json").write_text(
+            json.dumps(_json_safe(meta), ensure_ascii=False, indent=2),
+            encoding="utf-8",
+        )
+        return round_dir
