, mask=o_mask)\\n\\n\\ndef kernel_function(Q: torch.Tensor, K: torch.Tensor, V: torch.Tensor) -> torch.Tensor:\\n    assert isinstance(Q, torch.Tensor) and isinstance(K, torch.Tensor) and isinstance(V, torch.Tensor)\\n    assert Q.is_hip and K.is_hip and V.is_hip\\n    assert Q.dtype == torch.bfloat16 and K.dtype == torch.bfloat16 and V.dtype == torch.bfloat16\\n    assert Q.ndim == 4 and K.ndim == 4 and V.ndim == 4\\n\\n    B, HQ, S, D = Q.shape\\n    BK, HKV, SK, DK = K.shape\\n    BV, HKV2, SV, DV = V.shape\\n\\n    assert B == BK == BV\\n    assert S == SK == SV\\n    assert D == DK == DV == 128\\n    assert HKV == HKV2\\n    assert HKV == 1 or HKV == HQ\\n\\n    O = torch.empty_like(Q)\\n    scale = 1.0 / (D ** 0.5)\\n\\n    BLOCK_M = 64\\n    BLOCK_N = 128\\n    BLOCK_D = 128\\n\\n    grid = (triton.cdiv(S, BLOCK_M), B * HQ)\\n\\n    _fused_causal_attention_opt[grid](\\n        Q, K, V, O,\\n        B, HQ, HKV, S, D,\\n        Q.stride(0), Q.stride(1), Q.stride(2), Q.stride(3),\\n        K.stride(0), K.stride(1), K.stride(2), K.stride(3),\\n        V.stride(0), V.stride(1), V.stride(2), V.stride(3),\\n        O.stride(0), O.stride(1), O.stride(2), O.stride(3),\\n        scale,\\n        BLOCK_M=BLOCK_M,\\n        BLOCK_N=BLOCK_N,\\n        BLOCK_D=BLOCK_D,\\n        num_warps=8,\\n        num_stages=2,\\n    )\\n    return O\\n```\\n\\nTEST RESULTS:\\nError output: Traceback (most recent call last):\\n  File \\\"/workspace/kernel_benchmark/kernelflacon/workspace/KernelAgent/opt_worker_runs/attention97_beam_r10_20260323_032654/opt_manager_logs_real/workers/w0/r4/test_kernel.py\\\", line 95, in test_kernel\\n    y = kernel_function(q, k, v)\\n        ^^^^^^^^^^^^^^^^^^^^^^^^\\n  File \\\"/workspace/kernel_benchmark/kernelflacon/workspace/KernelAgent/opt_worker_runs/attention97_beam_r10_20260323_032654/opt_manager_logs_real/workers/w0/r4/kernel.py\\\", line 100, in kernel_function\\n    assert Q.is_hip and K.is_hip and V.is_hip\\n           ^^^^^^^^\\nAttributeEr