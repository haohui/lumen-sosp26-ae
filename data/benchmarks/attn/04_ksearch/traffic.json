Q_BLOCK;\\n    const int h = static_cast<int>(blockIdx.y);\\n    const int b = static_cast<int>(blockIdx.z);\\n\\n    if(threadIdx.x >= 64 || b >= B || h >= Hq || t_block >= S)\\n    {\\n        return;\\n    }\\n\\n    const int hkv = (Hkv == 1) ? 0 : h;\\n\\n    const int d0 = lane;\\n    const int d1 = lane + 64;\\n\\n    const int64_t q_s_stride = static_cast<int64_t>(Hq) * static_cast<int64_t>(D);\\n    const int64_t kv_s_stride = static_cast<int64_t>(Hkv) * static_cast<int64_t>(D);\\n    const int64_t q_bh_base = (static_cast<int64_t>(b) * static_cast<int64_t>(S) * static_cast<int64_t>(Hq) +\\n                               static_cast<int64_t>(h)) *\\n                              static_cast<int64_t>(D);\\n    const int64_t kv_bh_base = (static_cast<int64_t>(b) * static_cast<int64_t>(S) * static_cast<int64_t>(Hkv) +\\n                                static_cast<int64_t>(hkv)) *\\n                               static_cast<int64_t>(D);\\n\\n    __shared__ bfloat16_t s_qtile[WMMA_M * 128];\\n    __shared__ bfloat16_t s_ktile[WMMA_N * 128];\\n    __shared__ float s_scores[WMMA_M * WMMA_N];\\n\\n    const bfloat16_t* q_b = reinterpret_cast<const bfloat16_t*>(q);\\n    const bfloat16_t* k_b = reinterpret_cast<const bfloat16_t*>(k);\\n\\n    for(int i = lane; i < WMMA_M * 128; i += 64)\\n    {\\n        const int row = i / 128;\\n        const int d = i - row * 128;\\n        const int tq = t_block + row;\\n        if(tq < S)\\n        {\\n            s_qtile[i] = q_b[q_bh_base + static_cast<int64_t>(tq) * q_s_stride + d];\\n        }\\n        else\\n        {\\n            s_qtile[i] = bfloat16_t{};\\n        }\\n    }\\n    __syncthreads();\\n\\n    float acc0[Q_BLOCK];\\n    float acc1[Q_BLOCK];\\n#pragma unroll\\n    for(int qi = 0; qi < Q_BLOCK; ++qi)\\n    {\\n        acc0[qi] = 0.0f;\\n        acc1[qi] = 0.0f;\\n    }\\n\\n    const bool lane_is_q = (lane < Q_BLOCK);\\n    const int tq_lane = t_block + lane;\\n    float m_local = -INFINITY;\\n    float l_local = 0.0f;\\n\\n    fragment<accumulator, WMMA_M, WMMA_N, WMMA_K, float> cFrag;\\n    fragment<matrix_a, WMMA_M, WMMA_N, WMMA_K, bfloat16_t, row_major> aFrag;\\n    fragment<matrix_b, WMMA_M, WMMA_N, WMMA_K, bfloat16_t, col_major> bFrag;\\n\\n    int t_max = t_block + Q_BLOCK - 1;\\n    if(t_max >= S)\\n    {\\n        t_max = S - 1;\\n    }\\n\\n    for(int ks = 0; ks <= t_max; ks += WMMA_N)\\n    {\\n        for(int i = lane; i < WMMA_N * 128; i += 64)\\n        {\\n            const int row = i / 128;\\n            const int d = i - row * 128;\\n            const int s_idx = ks + row;\\n            if(s_idx < S)\\n            {\\n                s_ktile[i] = k_b[kv_bh_base + static_cast<int64_t>(s_idx) * kv_s_stride + d];\\n            }\\n            else\\n            {\\n                s_ktile[i] = bfloat16_t{};\\n            }\\n        }\\n        __syncthreads();\\n\\n        fill_fragment(cFrag, 0.0f);\\n#pragma unroll\\n        for(int kd = 0; kd < 128; kd += WMMA_K)\\n        {\\n            load_matrix_sync(aFrag, s_qtile + kd, 128);\\n            load_matrix_sync(bFrag, s_ktile + kd, 128);\\n            mma_sync(cFrag, aFrag, bFrag, cFrag);\\n        }\\n\\n        store_matrix_sync(s_scores, cFrag, WMMA_N, mem_row_major);\\n        __syncthreads();\\n\\n#pragma unroll\\n        for(int col = 0; col < WMMA_N; ++col)\\n        {\\n            const int s_idx = ks + col;\\n            if(s_idx >= S)\\n            {\\n                continue;\\n            }\\n\\n            const int64_t kv_base = kv_bh_base + static_cast<int64_t>(s_idx) * kv_s_stride;\\n            const float vv0 = __bfloat162float(v[kv_base + d0]);\\n            const float vv1 = __bfloat162float(v[kv_base + d1]);\\n\\n            float alpha_lane = 1.0f;\\n            float beta_lane = 0.0f;\\n\\n            if(lane_is_q && tq_lane < S && s_idx <= tq_lane)\\n            {\\n                const float score = s_scores[lane * WMMA_N + col] * sm_scale;\\n                const float