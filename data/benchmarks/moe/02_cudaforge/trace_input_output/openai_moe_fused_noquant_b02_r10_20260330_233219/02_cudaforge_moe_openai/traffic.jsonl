break;\\n                default:\\n                    hipLaunchKernelGGL(\\n                        fused_moe_token_kernel_reg_out,\\n                        dim3(T), dim3(threads), smem_x_act, 0,\\n                        input_ptr, w1_ptr, w2_ptr,\\n                        topk_weights_f32.data_ptr<float>(),\\n                        topk_ids_i32.data_ptr<int32_t>(),\\n                        input_scale_f32.data_ptr<float>(),\\n                        fc1_scale_f32.data_ptr<float>(),\\n                        fc2_scale_f32.data_ptr<float>(),\\n                        out_ptr,\\n                        T, D, E, I, K,\\n                        D_blocks, I_blocks,\\n                        fc1_stride, fc2_stride\\n                    );\\n                    break;\\n            }\\n        } else if (smem_smemout <= 64 * 1024) {\\n            hipLaunchKernelGGL(\\n                fused_moe_token_kernel_smem_out,\\n                dim3(T), dim3(threads), smem_smemout, 0,\\n                input_ptr, w1_ptr, w2_ptr,\\n                topk_weights_f32.data_ptr<float>(),\\n                topk_ids_i32.data_ptr<int32_t>(),\\n                input_scale_f32.data_ptr<float>(),\\n                fc1_scale_f32.data_ptr<float>(),\\n                fc2_scale_f32.data_ptr<float>(),\\n                out_ptr,\\n                T, D, E, I, K,\\n                D_blocks, I_blocks,\\n                fc1_stride, fc2_stride\\n            );\\n        } else {\\n            auto out_acc = torch::empty({T64, D64}, input_q_bf16.options().dtype(torch::kFloat32));\\n            float* out_acc_ptr = out_acc.data_ptr<float>();\\n\\n            hipLaunchKernelGGL(\\n                fused_moe_token_kernel_global_out,\\n                dim3(T), dim3(threads), smem_x_act, 0,\\n                input_ptr, w1_ptr, w2_ptr,\\n                topk_weights_f32.data_ptr<float>(),\\n                topk_ids_i32.data_ptr<int32_t>(),\\n                input_scale_f32.data_ptr<float>(),\\n              