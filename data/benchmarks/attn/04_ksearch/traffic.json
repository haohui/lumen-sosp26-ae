se_attention\\n\\nAxes:\\n  batch_size: variable (Batch size.)\\n  num_q_heads: constant = 8\\n  num_kv_heads: variable (KV heads for dense prefill; must be 8 (MHA) or 1 (GQA-style shared KV).)\\n  seq_len: variable (Sequence length for prefill. q/k/v share the same sequence length.)\\n  head_dim: constant = 128\\n\\nInputs:\\n  q: [batch_size, seq_len, num_q_heads, head_dim] (DType.BFLOAT16)\\n  k: [batch_size, seq_len, num_kv_heads, head_dim] (DType.BFLOAT16)\\n  v: [batch_size, seq_len, num_kv_heads, head_dim] (DType.BFLOAT16)\\n  sm_scale: scalar (DType.FLOAT32) - Softmax scale, usually 1/sqrt(head_dim).\\n\\nOutputs:\\n  output: [batch_size, seq_len, num_q_heads, head_dim] (DType.BFLOAT16) - Dense causal prefill attention output.\\n\\n\\nReference Implementation:\\nimport torch\\n\\n\\n@torch.no_grad()\\ndef run(q, k, v, sm_scale):\\n    # AITER-style main path only (branches removed):\\n    # causal=True, dropout=0, no padding/window/alibi.\\n    # input/output layout for this task: [B, S, H, D]\\n    assert q.ndim == 4 and k.ndim == 4 and v.ndim == 4\\n    bq, sq, hq, dq = q.shape\\n    bk, sk, hk, dk = k.shape\\n    bv, sv, hv, dv = v.shape\\n\\n    assert (bq, sq, dq) == (bk, sk, dk) == (bv, sv, dv)\\n    assert hq == 8\\n    assert hk in (1, 8)\\n    assert hv == hk\\n    assert dq == 128\\n\\n    if hk != hq:\\n        groups = hq // hk\\n        k = k.repeat_interleave(groups, dim=2)\\n        v = v.repeat_interleave(groups, dim=2)\\n\\n    qf = q.to(torch.float32)\\n    kf = k.to(torch.float32)\\n    vf = v.to(torch.float32)\\n\\n    scores = torch.einsum(\\\"bthd,bshd->bhts\\\", qf * float(sm_scale), kf)\\n    causal_mask = torch.triu(\\n        torch.ones((sq, sk), device=q.device, dtype=torch.bool),\\n        diagonal=1,\\n    )\\n    scores = scores.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), float(\\\"-inf\\\"))\\n    probs = torch.softmax(scores, dim=-1)\\n    out = torch.einsum(\\\"bhts,bshd->bthd\\\", probs, vf)\\n    return out.to(torch.