diff --git a/scripts/gpumode_trimul_wm_rocm.sh b/scripts/gpumode_trimul_wm_rocm.sh
new file mode 100755
index 0000000..2420494
--- /dev/null
+++ b/scripts/gpumode_trimul_wm_rocm.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# ROCm-first GPUMode TriMul launcher for k-search (World Model generator).
+#
+# Defaults:
+# - LANGUAGE=triton
+# - GPU_VENDOR=amd
+# - RUNTIME=rocm
+# - TARGET_GPU=MI300X
+
+set -euo pipefail
+
+KSEARCH_ROOT="${KSEARCH_ROOT:-}"
+MODEL_NAME="${MODEL_NAME:-gpt-5.2}"
+API_KEY="${API_KEY:-${LLM_API_KEY:-}}"
+BASE_URL="${BASE_URL:-https://us.api.openai.com/v1}"
+
+LANGUAGE="${LANGUAGE:-triton}"
+GPU_VENDOR="${GPU_VENDOR:-amd}"
+RUNTIME="${RUNTIME:-rocm}"
+TARGET_GPU="${TARGET_GPU:-MI300X}"
+MAX_OPT_ROUNDS="${MAX_OPT_ROUNDS:-300}"
+ARTIFACTS_DIR="${ARTIFACTS_DIR:-.ksearch-output-gpumode-rocm}"
+CONTINUE_FROM_SOLUTION="${CONTINUE_FROM_SOLUTION:-}"
+
+WM="${WM:-1}"
+WM_STAGNATION_WINDOW="${WM_STAGNATION_WINDOW:-5}"
+
+GPUMODE_MODE="${GPUMODE_MODE:-benchmark}"
+GPUMODE_KEEP_TMP="${GPUMODE_KEEP_TMP:-0}"
+GPUMODE_TASK_DIR="${GPUMODE_TASK_DIR:-$KSEARCH_ROOT/k_search/tasks/gpu_mode/trimul}"
+
+WANDB="${WANDB:-0}"
+WANDB_PROJECT="${WANDB_PROJECT:-ksearch-gpumode-rocm}"
+RUN_NAME="${RUN_NAME:-${MODEL_NAME}-${LANGUAGE}-gpumode-trimul-rocm-opt${MAX_OPT_ROUNDS}}"
+
+if [[ -z "${KSEARCH_ROOT}" ]]; then
+  echo "ERROR: KSEARCH_ROOT is required" >&2
+  exit 2
+fi
+if [[ -z "${MODEL_NAME}" ]]; then
+  echo "ERROR: MODEL_NAME is required" >&2
+  exit 2
+fi
+if [[ -z "${API_KEY}" ]]; then
+  echo "ERROR: API key is required (set LLM_API_KEY or API_KEY)" >&2
+  exit 2
+fi
+
+CONT_ARGS=()
+if [[ -n "${CONTINUE_FROM_SOLUTION}" ]]; then
+  CONT_ARGS+=(--continue-from-solution "${CONTINUE_FROM_SOLUTION}")
+fi
+
+WM_ARGS=()
+if [[ "${WM}" == "1" ]]; then
+  WM_ARGS+=(--world-model --wm-stagnation-window "${WM_STAGNATION_WINDOW}")
+fi
+
+WANDB_ARGS=()
+if [[ "${WANDB}" == "1" ]]; then
+  WANDB_ARGS+=(--wandb --run-name "${RUN_NAME}" --wandb-project "${WANDB_PROJECT}")
+fi
+
+python3 -u "${KSEARCH_ROOT}/generate_kernels_and_eval.py" \
+  --task-source gpumode \
+  --model-name "${MODEL_NAME}" \
+  --api-key "${API_KEY}" \
+  --base-url "${BASE_URL}" \
+  --language "${LANGUAGE}" \
+  --target-gpu "${TARGET_GPU}" \
+  --gpu-vendor "${GPU_VENDOR}" \
+  --runtime "${RUNTIME}" \
+  --max-opt-rounds "${MAX_OPT_ROUNDS}" \
+  --save-solutions \
+  --artifacts-dir "${ARTIFACTS_DIR}" \
+  --gpumode-mode "${GPUMODE_MODE}" \
+  --gpumode-task-dir "${GPUMODE_TASK_DIR}" \
+  "${WM_ARGS[@]}" \
+  "${CONT_ARGS[@]}" \
+  "${WANDB_ARGS[@]}"
