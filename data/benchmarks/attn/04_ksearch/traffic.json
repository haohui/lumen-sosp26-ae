ad_dim] (DType.BFLOAT16) - Dense causal prefill attention output.\\n\\n\\nReference Implementation:\\nimport torch\\n\\n\\n@torch.no_grad()\\ndef run(q, k, v, sm_scale):\\n    # AITER-style main path only (branches removed):\\n    # causal=True, dropout=0, no padding/window/alibi.\\n    # input/output layout for this task: [B, S, H, D]\\n    assert q.ndim == 4 and k.ndim == 4 and v.ndim == 4\\n    bq, sq, hq, dq = q.shape\\n    bk, sk, hk, dk = k.shape\\n    bv, sv, hv, dv = v.shape\\n\\n    assert (bq, sq, dq) == (bk, sk, dk) == (bv, sv, dv)\\n    assert hq == 8\\n    assert hk in (1, 8)\\n    assert hv == hk\\n    assert dq == 128\\n\\n    if hk != hq:\\n        groups = hq // hk\\n        k = k.repeat_interleave(groups, dim=2)\\n        v = v.repeat_interleave(groups, dim=2)\\n\\n    qf = q.to(torch.float32)\\n    kf = k.to(torch.float32)\\n    vf = v.to(torch.float32)\\n\\n    scores = torch.einsum(\\\"bthd,bshd->bhts\\\", qf * float(sm_scale), kf)\\n    causal_mask = torch.triu(\\n        torch.ones((sq, sk), device=q.device, dtype=torch.bool),\\n        diagonal=1,\\n    )\\n    scores = scores.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), float(\\\"-inf\\\"))\\n    probs = torch.softmax(scores, dim=-1)\\n    out = torch.einsum(\\\"bhts,bshd->bthd\\\", probs, vf)\\n    return out.to(torch.bfloat16)\\n\\nCycle-Best Base Implementation (reference):\\n<header_file name=\\\"kernel.h\\\">\\n#ifndef KSEARCH_KERNEL_H_\\n#define KSEARCH_KERNEL_H_\\n\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1or8_d128(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int B,\\n    int S,\\n    int Hq,\\n    int Hkv,\\n    int D,\\n    float sm_scale);\\n\\n#endif  // KSEARCH_KERNEL_H_\\n</header_file>\\n\\n<cuda_file name=\\\"kernel.cu\\\">\\n#inclu