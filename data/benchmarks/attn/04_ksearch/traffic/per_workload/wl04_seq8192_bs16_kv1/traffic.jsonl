kv_seq_base);\\n    }\\n\\n    const uint32_t q_pack = reinterpret_cast<const uint32_t*>(q + q_row_base)[lane];\\n    float q0, q1;\\n    unpack_bf16x2(q_pack, q0, q1);\\n\\n    float acc0 = 0.0f;\\n    float acc1 = 0.0f;\\n    float m_i = -INFINITY;\\n    float l_i = 0.0f;\\n\\n    __shared__ uint32_t sh_k_pack0[kWaveSize];\\n    __shared__ uint32_t sh_v_pack0[kWaveSize];\\n    __shared__ uint32_t sh_k_pack1[kWaveSize];\\n    __shared__ uint32_t sh_v_pack1[kWaveSize];\\n\\n    for (int key = 0; key <= q_pos; key += 2) {\\n        const int key1 = key + 1;\\n        const bool has_key1 = (key1 <= q_pos);\\n\\n        if (warp_id == 0) {\\n            const int64_t kv_row0 = kv_seq_base + static_cast<int64_t>(key) * kHeadDim;\\n            sh_k_pack0[lane] = reinterpret_cast<const uint32_t*>(k + kv_row0)[lane];\\n            sh_v_pack0[lane] = reinterpret_cast<const uint32_t*>(v + kv_row0)[lane];\\n\\n            if (has_key1) {\\n                const int64_t kv_row1 = kv_seq_base + static_cast<int64_t>(key1) * kHeadDim;\\n                sh_k_pack1[lane] = reinterpret_cast<const uint32_t*>(k + kv_row1)[lane];\\n                sh_v_pack1[lane] = reinterpret_cast<const uint32_t*>(v + kv_row1)[lane];\\n            }\\n        }\\n\\n        __syncthreads();\\n\\n        process_one_key(\\n            sh_k_pack0[lane], sh_v_pack0[lane], q0, q1, sm_scale, lane, m_i, l_i, acc0, acc1);\\n\\n        if (has_key1) {\\n            process_one_key(\\n                sh_k_pack1[lane], sh_v_pack1[lane], q0, q1, sm_scale, lane, m_i, l_i, acc0, acc1);\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    reinterpret_cast<uint32_t*>(out + q_row_base)[lane] = pack_float2_to_bf16x2(acc0, acc1);\\n}\\n\\nhipError_t ksearch_launch_online_row_streaming_causal_attention(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_l