 import argparse
 import os
+import shutil
 from datetime import datetime
 import uuid
 from pathlib import Path
 from typing import Any, List, Optional
 import json
+import importlib.metadata as importlib_metadata
+
+
+_ALLOWED_GPU_VENDORS = {"amd", "nvidia"}
+_ALLOWED_RUNTIMES = {"rocm", "cuda"}
+
+
+def _normalize_choice(name: str, value: Optional[str], allowed: set[str]) -> Optional[str]:
+    if value is None:
+        return None
+    norm = str(value).strip().lower()
+    if not norm:
+        return None
+    if norm not in allowed:
+        raise ValueError(f"Unsupported {name}={value!r}; expected one of {sorted(allowed)}")
+    return norm
+
+
+def _infer_vendor_runtime_from_target_gpu(target_gpu: str) -> tuple[Optional[str], Optional[str]]:
+    tg = str(target_gpu or "").strip().upper()
+    if not tg:
+        return None, None
+
+    amd_markers = ("AMD", "MI", "INSTINCT", "RADEON", "CDNA", "RDNA")
+    nvidia_markers = (
+        "NVIDIA",
+        "H100",
+        "H200",
+        "B200",
+        "A100",
+        "A10",
+        "L40",
+        "V100",
+        "T4",
+        "RTX",
+        "GEFORCE",
+        "TESLA",
+    )
+    if any(m in tg for m in amd_markers):
+        return "amd", "rocm"
+    if any(m in tg for m in nvidia_markers):
+        return "nvidia", "cuda"
+    return None, None
+
+
+def _resolve_gpu_vendor_runtime(
+    *,
+    target_gpu: str,
+    gpu_vendor: Optional[str],
+    runtime: Optional[str],
+) -> tuple[str, str]:
+    explicit_vendor = _normalize_choice("gpu_vendor", gpu_vendor, _ALLOWED_GPU_VENDORS)
+    explicit_runtime = _normalize_choice("runtime", runtime, _ALLOWED_RUNTIMES)
+    inferred_vendor, inferred_runtime = _infer_vendor_runtime_from_target_gpu(target_gpu)
+
+    resolved_vendor = explicit_vendor or inferred_vendor
+    resolved_runtime = explicit_runtime or inferred_runtime
+
+    if resolved_vendor and not resolved_runtime:
+        resolved_runtime = "rocm" if resolved_vendor == "amd" else "cuda"
+    if resolved_runtime and not resolved_vendor:
+        resolved_vendor = "amd" if resolved_runtime == "rocm" else "nvidia"
+
+    if not resolved_vendor or not resolved_runtime:
+        raise ValueError(
+            "Could not infer gpu vendor/runtime from --target-gpu. "
+            "Please pass both --gpu-vendor and --runtime explicitly."
+        )
+
+    if resolved_vendor == "amd" and resolved_runtime != "rocm":
+        raise ValueError("Invalid combination: gpu_vendor=amd requires runtime=rocm")
+    if resolved_vendor == "nvidia" and resolved_runtime != "cuda":
+        raise ValueError("Invalid combination: gpu_vendor=nvidia requires runtime=cuda")
+    return resolved_vendor, resolved_runtime
+
+
+def _probe_environment(
+    *,
+    language: str,
+    gpu_vendor: str,
+    runtime: str,
+    target_gpu: str,
+) -> None:
+    print(
+        "[env] requested config: "
+        f"language={language} gpu_vendor={gpu_vendor} runtime={runtime} target_gpu={target_gpu}"
+    )
+
+    torch_mod = None
+    try:
+        import torch as torch_mod  # type: ignore
+
+        print(
+            "[env] torch: "
+            f"version={getattr(torch_mod, '__version__', '')} "
+            f"cuda_version={getattr(getattr(torch_mod, 'version', None), 'cuda', None)} "
+            f"hip_version={getattr(getattr(torch_mod, 'version', None), 'hip', None)} "
+            f"cuda_available={bool(torch_mod.cuda.is_available())} "
+            f"device_count={int(torch_mod.cuda.device_count() if torch_mod.cuda.is_available() else 0)}"
+        )
+        if torch_mod.cuda.is_available():
+            try:
+                print(f"[env] torch device[0]: {torch_mod.cuda.get_device_name(0)}")
+            except Exception as e:
+                print(f"[env] torch device[0] lookup failed: {e}")
+    except Exception as e:
+        print(f"[env] torch import failed: {e}")
+
+    triton_ok = False
+    triton_version = None
+    try:
+        import triton as triton_mod  # type: ignore
+
+        triton_ok = True
+        triton_version = getattr(triton_mod, "__version__", None)
+    except Exception as e:
+        print(f"[env] triton import failed: {e}")
+    if triton_ok:
+        print(f"[env] triton: version={triton_version}")
+
+    lang = str(language or "").strip().lower()
+    if lang == "triton" and not triton_ok:
+        raise RuntimeError("language=triton requested but Triton is not importable in this environment")
+    if lang == "substrate":
+        try:
+            import substrate as _substrate_mod  # type: ignore
+
+            print(f"[env] substrate: module={getattr(_substrate_mod, '__file__', None)}")
+        except Exception as e:
+            print(f"[env][warn] language=substrate requested but `import substrate` failed: {e}")
+    if lang == "hip" and runtime != "rocm":
+        raise RuntimeError("language=hip requires runtime=rocm")
+
+    if torch_mod is None:
+        raise RuntimeError("PyTorch is required to validate runtime/backend but torch could not be imported")
+
+    torch_cuda = getattr(getattr(torch_mod, "version", None), "cuda", None)
+    torch_hip = getattr(getattr(torch_mod, "version", None), "hip", None)
+    if runtime == "rocm" and not torch_hip:
+        raise RuntimeError(
+            "runtime=rocm requested but torch.version.hip is empty. "
+            "Please install a ROCm-enabled PyTorch build."
+        )
+    if runtime == "cuda" and not torch_cuda:
+        raise RuntimeError(
+            "runtime=cuda requested but torch.version.cuda is empty. "
+            "Please install a CUDA-enabled PyTorch build."
+        )
+
+
+def _configure_rocm_compiler_env(*, language: str, runtime: str) -> None:
+    """
+    For C++ GPU kernel paths on ROCm, pin torch cpp_extension's compiler to hipcc.
+    This affects both k-search generated `submission.py` builds and flashinfer-bench TorchBuilder.
+    """
+    lang = str(language or "").strip().lower()
+    rt = str(runtime or "").strip().lower()
+    if rt != "rocm" or lang not in ("cuda", "hip"):
+        return
+
+    hipcc = shutil.which("hipcc")
+    if not hipcc:
+        fallback = "/opt/rocm/bin/hipcc"
+        hipcc = fallback if os.path.exists(fallback) else ""
+    if not hipcc:
+        print("[env][warn] runtime=rocm with C++ GPU kernel path but hipcc was not found in PATH.")
+        return
+
+    prev = os.environ.get("PYTORCH_NVCC")
+    os.environ["PYTORCH_NVCC"] = hipcc
+    if prev and prev != hipcc:
+        print(f"[env] overriding PYTORCH_NVCC: {prev} -> {hipcc}")
+    else:
+        print(f"[env] using PYTORCH_NVCC={hipcc}")
+
+
+def _dist_version_or_none(dist_name: str) -> Optional[str]:
+    try:
+        return str(importlib_metadata.version(dist_name))
+    except Exception:
+        return None
+
+
+def _probe_flashinfer_rocm_preflight(*, enable_smoke: bool = True) -> None:
+    """
+    Preflight check for flashinfer task on ROCm:
+    - verify `amd-flashinfer` is present
+    - detect potential `flashinfer-python` (CUDA) conflict
+    - optionally run a tiny functional smoke test
+    """
+    amd_flashinfer_ver = _dist_version_or_none("amd-flashinfer")
+    cuda_flashinfer_ver = _dist_version_or_none("flashinfer-python")
+    fib_ver = _dist_version_or_none("flashinfer-bench")
+
+    print(
+        "[env] flashinfer packages: "
+        f"amd-flashinfer={amd_flashinfer_ver} "
+        f"flashinfer-python={cuda_flashinfer_ver} "
+        f"flashinfer-bench={fib_ver}"
+    )
+
+    if not amd_flashinfer_ver:
+        raise RuntimeError(
+            "runtime=rocm + task-source=flashinfer requires ROCm flashinfer package `amd-flashinfer`.\n"
+            "Install ROCm flashinfer first (e.g. from https://github.com/ROCm/flashinfer), then retry."
+        )
+    if cuda_flashinfer_ver:
+        print(
+            "[env][warn] `flashinfer-python` is installed. It is typically the CUDA package and can conflict with ROCm flashinfer."
+        )
+
+    try:
+        import flashinfer  # type: ignore
+
+        print(
+            "[env] flashinfer module: "
+            f"version={getattr(flashinfer, '__version__', None)} "
+            f"path={getattr(flashinfer, '__file__', None)}"
+        )
+    except Exception as e:
+        raise RuntimeError(f"Failed to import flashinfer in ROCm flow: {e}") from e
+
+    if not enable_smoke:
+        return
+
+    # Tiny runtime smoke test to fail early on CUDA-only flashinfer installs.
+    try:
+        import torch  # type: ignore
+        import flashinfer  # type: ignore
+
+        if not torch.cuda.is_available():
+            raise RuntimeError("torch.cuda.is_available() is False")
+        q = torch.randn((1, 1, 64), device="cuda", dtype=torch.bfloat16)
+        k = torch.randn((1, 1, 64), device="cuda", dtype=torch.bfloat16)
+        v = torch.randn((1, 1, 64), device="cuda", dtype=torch.bfloat16)
+        _ = flashinfer.single_prefill_with_kv_cache(
+            q, k, v, causal=False, kv_layout="NHD", pos_encoding_mode="NONE"
+        )
+        torch.cuda.synchronize()
+        print("[env] flashinfer ROCm smoke: PASS (single_prefill_with_kv_cache)")
+    except Exception as e:
+        raise RuntimeError(
+            "flashinfer ROCm smoke check failed.\n"
+            "This usually means the CUDA `flashinfer-python` package is taking precedence or ROCm flashinfer is misinstalled.\n"
+            "Suggested fix: uninstall `flashinfer-python`, then reinstall `amd-flashinfer` from ROCm/flashinfer.\n"
+            f"Original error: {e}"
+        ) from e
+
 
