or(int d = lane; d < 128; d += 64)\\n    {\\n        s_qvec[d] = q_b[q_base + d];\\n    }\\n    __syncthreads();\\n\\n    float m = -INFINITY;\\n    float l = 0.0f;\\n\\n    const int d0 = lane;\\n    const int d1 = lane + 64;\\n    float acc0 = 0.0f;\\n    float acc1 = 0.0f;\\n\\n    fragment<accumulator, WMMA_M, WMMA_N, WMMA_K, float> cFrag;\\n    fragment<matrix_a, WMMA_M, WMMA_N, WMMA_K, bfloat16_t, row_major> aFrag;\\n    fragment<matrix_b, WMMA_M, WMMA_N, WMMA_K, bfloat16_t, col_major> bFrag;\\n\\n    for(int ks = 0; ks <= t; ks += WMMA_N)\\n    {\\n        fill_fragment(cFrag, 0.0f);\\n\\n#pragma unroll\\n        for(int kd = 0; kd < 128; kd += WMMA_K)\\n        {\\n#pragma unroll\\n            for(int i = lane; i < WMMA_M * WMMA_K; i += 64)\\n            {\\n                const int kk = i & (WMMA_K - 1);\\n                const int key_local = i >> 4;\\n                const int qd = kd + kk;\\n\\n                s_qrep[i] = s_qvec[qd];\\n\\n                const int s_idx = ks + key_local;\\n                if(s_idx < S && s_idx <= t)\\n                {\\n                    const int64_t k_base = idx4_bshd(b, s_idx, hkv, 0, S, Hkv, D);\\n                    s_kfrag[i] = k_b[k_base + qd];\\n                }\\n                else\\n                {\\n                    s_kfrag[i] = bfloat16_t{};\\n                }\\n            }\\n\\n            __syncthreads();\\n            load_matrix_sync(aFrag, s_qrep, WMMA_K);\\n            load_matrix_sync(bFrag, s_kfrag, WMMA_K);\\n            mma_sync(cFrag, aFrag, bFrag, cFrag);\\n            __syncthreads();\\n        }\\n\\n        store_matrix_sync(s_scores, cFrag, WMMA_N, mem_row_major);\\n        __syncthreads();\\n\\n        int key_limit = ks + WMMA_N;\\n        if(key_limit > t + 1)\\n            key_limit = t + 1;\\n        if(key_limit > S)\\n            key_limit = S;\\n\\n#pragma unroll\\n        for(int s_idx = ks; s_idx < key_limit; ++s_idx)\\n        {\\n            float alpha_lane = 1.0f;\\n            float beta_lane = 0.0f;\\n\\n            if(lane == 0)\\n            {\\n                const float score = s_scores[s_idx - ks] * sm_scale;\\n                const float m_new = fmaxf(m, score);\\n                alpha_lane = expf(m - m_new);\\n                beta_lane = expf(score - m_new);\\n                l = l * alpha_lane + beta_lane;\\n                m = m_new;\\n            }\\n\\n            const float alpha = __shfl(alpha_lane, 0);\\n            const float beta = __shfl(beta_lane, 0);\\n\\n            const int64_t v_base = idx4_bshd(b, s_idx, hkv, 0, S, Hkv, D);\\n            const float vv0 = __bfloat162float(v[v_base + d0]);\\n            const float vv1 = __bfloat162float(v[v_base + d1]);\\n\\n            acc0 = acc0 * alpha + beta * vv0;\\n            acc1 = acc1 * alpha + beta * vv1;\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    const float l_lane = (lane == 0) ? l : 0.0f;\\n    const float l_all = __shfl(l_lane, 0);\\n    const float inv_l = (l_all > 0.0f) ? (1.0f / l_all) : 0.0f;\\n\\n    const int64_t out_base = idx4_bshd(b, t, h, 0, S, Hq, D);\\n    out[out_base + d0] = __float2bfloat16(acc0 * inv_l);\\n    out[out_base + d1] = __float2bfloat16(acc1 * inv_l);\\n#else\\n    (void)q;\\n    (void)k;\\n    (void)v;\\n    (void)out;\\n    (void)B;\\n    (void)S;\\n    (void)Hq;\\n    (void)Hkv;\\n    (void)D;\\n    (void)sm_scale;\\n#endif\\n}\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1or8_d128(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int B,\\n    int S,\\n    int Hq,\\n    int Hkv,\\n    int D,\\n    float sm_scale)\\n{\\n#if !KSEARCH_HAS_ROCWMMA_HEADER\\n    (void)grid;\\n    (void)block;\\n    (void)shared_mem;\\n    (void)stream;\\n    (void)q;\\n    (void)k;\\n    (void)v;\\n    (void)out;\\n    (void)B;\\n    (void)S;\\n    (void)Hq;