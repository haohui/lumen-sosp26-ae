: \"completed\",\n      \"content\": [\n        {\n          \"type\": \"output_text\",\n          \"annotations\": [],\n          \"logprobs\": [],\n          \"text\": \"```python\\nimport sys\\nimport traceback\\nimport inspect\\nimport torch\\nimport torch.nn as nn\\n\\n\\n# Reference from problem description:\\n# C = A @ B^T, where A is (M, K), B is (N, K), output C is (M, N).\\nclass Model(nn.Module):\\n    \\\"\\\"\\\"\\n    Simple model that performs a single matrix multiplication (C = A @ B^T)\\n    \\\"\\\"\\\"\\n\\n    def __init__(self):\\n        super(Model, self).__init__()\\n\\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\\n        return torch.matmul(A, B.T)\\n\\n\\ndef get_inputs():\\n    # EXACT shapes from prompt\\n    M = 1024 * 2\\n    K = 4096 * 2\\n    N = 2048 * 2\\n    A = torch.rand(M, K)\\n    B = torch.rand(N, K)\\n    return [A, B]\\n\\n\\ndef get_init_inputs():\\n    return []\\n\\n\\ndef test_kernel():\\n    \\\"\\\"\\\"Test the Triton-backed kernel_function as a normal Python function.\\\"\\\"\\\"\\n    try:\\n        from kernel import kernel_function\\n\\n        if not callable(kernel_function):\\n            print(\\\"FAIL: kernel_function is not callable\\\")\\n            return False\\n\\n        if not torch.cuda.is_available():\\n            raise RuntimeError(\\\"HIP/ROCm not available: torch.cuda.is_available() is False\\\")\\n\\n        device = torch.device(\\\"cuda\\\")\\n        print(f\\\"[Info] Using device: {device}\\\")\\n        print(f\\\"[Info] torch.version.hip: {torch.version.hip}\\\")\\n\\n        # Per requirement: avoid FP32 inputs for FP32-style problems; use BF16.\\n        dtype = torch.bfloat16\\n        torch.manual_seed(0)\\n\\n        # Build reference model and inputs using provided semantics\\n        model = Model(*get_init_inputs()).to(device).eval()\\n        inputs = get_inputs()\\n        if len(inputs) != 2:\\n            print(f\\\"FAIL: get_inputs() returned {len