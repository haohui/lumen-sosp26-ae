u = static_cast<uint32_t>(x) << 16;\\n    return __uint_as_float(u);\\n}\\n\\n__device__ __forceinline__ uint16_t float_to_bf16_rn(float x) {\\n    uint32_t u = __float_as_uint(x);\\n    uint32_t lsb = (u >> 16) & 1u;\\n    u += 0x7FFFu + lsb;\\n    return static_cast<uint16_t>(u >> 16);\\n}\\n\\n__device__ __forceinline__ float wave64_sum_bcast(float v) {\\n    #pragma unroll\\n    for (int offset = 32; offset > 0; offset >>= 1) {\\n        v += __shfl_down(v, offset, 64);\\n    }\\n    return __shfl(v, 0, 64);\\n}\\n\\ntemplate<int HK, int TILE_S>\\n__device__ __forceinline__ void causal_attn_fwd_core_rpb4_tiled(\\n    const uint16_t* __restrict__ Q,\\n    const uint16_t* __restrict__ K,\\n    const uint16_t* __restrict__ V,\\n    uint16_t* __restrict__ O,\\n    int B,\\n    int S,\\n    int Hq,\\n    float scale\\n) {\\n    constexpr int D = 128;\\n    constexpr int ROWS_PER_BLOCK = 4;\\n\\n    __shared__ uint16_t shK[TILE_S * D];\\n    __shared__ uint16_t shV[TILE_S * D];\\n\\n    const int bh = static_cast<int>(blockIdx.y);\\n    const int tid = static_cast<int>(threadIdx.x);\\n    if (bh >= B * Hq) return;\\n\\n    const int b = bh / Hq;\\n    const int h = bh - b * Hq;\\n    const int kh = (HK == 1) ? 0 : h;\\n\\n    const int group = tid >> 6;  // 0..3\\n    const int lane = tid & 63;   // 0..63\\n\\n    const int t_base = static_cast<int>(blockIdx.x) * ROWS_PER_BLOCK;\\n    const int t_row = t_base + group;\\n    const bool t_valid = (t_row < S);\\n\\n    const int d0 = lane;\\n    const int d1 = lane + 64;\\n\\n    float q0 = 0.0f, q1 = 0.0f;\\n    if (t_valid) {\\n        const int64_t q_base = (((int64_t)b * S + t_row) * Hq + h) * D;\\n        q0 = bf16_to_float(Q[q_base + d0]) * scale;\\n        q1 = bf16_to_float(Q[q_base + d1]) * scale;\\n    }\\n\\n    const int kv_s_stride = HK * D;\\n    int t_max = t_base + ROWS_PER_BLOCK - 1;\\n    if (t_max >= S) t_max = S - 1;\\n\\n    float acc0 = 0.0f, acc1 = 0.0f;\\n    float m = -INFINITY;\\n    float l = 0.0f;\\n\\n    for (int ts = 0; ts <= t_max; ts += TILE_S) {\\n        int tile_len = t_max - ts + 1;\\n        if (tile_len > TILE_S) tile_len = TILE_S;\\n        const int tile_elems = tile_len * D;\\n\\n        const int64_t kv_tile_base = (((int64_t)b * S + ts) * HK + kh) * D;\\n\\n        for (int idx = tid; idx < tile_elems; idx += blockDim.x) {\\n            const int s_local = idx >> 7;   // /128\\n            const int d = idx & 127;        // %128\\n            const int64_t g = kv_tile_base + (int64_t)s_local * kv_s_stride + d;\\n            shK[idx] = K[g];\\n            shV[idx] = V[g];\\n        }\\n        __syncthreads();\\n\\n        if (t_valid) {\\n            int local_end = t_row - ts + 1;\\n            if (local_end > tile_len) local_end = tile_len;\\n\\n            for (int ss = 0; ss < local_end; ++ss) {\\n                const int base = ss * D;\\n\\n                const float k0 = bf16_to_float(shK[base + d0]);\\n                const float k1 = bf16_to_float(shK[base + d1]);\\n                const float partial = fmaf(q0, k0, q1 * k1);\\n                const float score = wave64_sum_bcast(partial);\\n\\n                const float m_new = fmaxf(m, score);\\n                const float alpha = __expf(m - m_new);\\n                const float beta = __expf(score - m_new);\\n                m = m_new;\\n                l = fmaf(l, alpha, beta);\\n\\n                const float v0 = bf16_to_float(shV[base + d0]);\\n                const float v1 = bf16_to_float(shV[base + d1]);\\n                acc0 = fmaf(acc0, alpha, beta * v0);\\n                acc1 = fmaf(acc1, alpha, beta * v1);\\n            }\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    if (t_valid) {\\n        const int64_t o_base = (((int64_t)b * S + t_row) * Hq + h) * D;\\n        const float inv_l = 1.0f / l;\\n        O[o_base + d0] = float_to_bf16_rn(acc0 * inv_l);\\n        O[o_base + d1] = float_to_bf16_rn(acc1 * inv_l);\\n    }\\n}\\n\\n__launch_bounds__(256, 