    return out;\\n}\\n\\n__device__ __forceinline__ float warp_reduce_sum(float v) {\\n    for (int offset = warpSize / 2; offset > 0; offset >>= 1) {\\n        v += __shfl_down(v, offset, warpSize);\\n    }\\n    return v;\\n}\\n\\n__device__ __forceinline__ float block_reduce_sum(float v, float* shared_warp_sums) {\\n    const int lane = threadIdx.x % warpSize;\\n    const int wid = threadIdx.x / warpSize;\\n    const int num_warps = (blockDim.x + warpSize - 1) / warpSize;\\n\\n    v = warp_reduce_sum(v);\\n    if (lane == 0) {\\n        shared_warp_sums[wid] = v;\\n    }\\n    __syncthreads();\\n\\n    float out = 0.0f;\\n    if (wid == 0) {\\n        out = (lane < num_warps) ? shared_warp_sums[lane] : 0.0f;\\n        out = warp_reduce_sum(out);\\n        if (lane == 0) {\\n            shared_warp_sums[0] = out;\\n        }\\n    }\\n    __syncthreads();\\n    return shared_warp_sums[0];\\n}\\n\\n}  // namespace\\n\\n__global__ __launch_bounds__(kHeadDim)\\nvoid dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass_kernel(\\n    const __hip_bfloat16* __restrict__ q,\\n    const __hip_bfloat16* __restrict__ k,\\n    const __hip_bfloat16* __restrict__ v,\\n    __hip_bfloat16* __restrict__ out,\\n    int seq_len,\\n    float sm_scale) {\\n    const int t = static_cast<int>(blockIdx.x);\\n    const int h = static_cast<int>(blockIdx.y);\\n    const int b = static_cast<int>(blockIdx.z);\\n    const int d = static_cast<int>(threadIdx.x);\\n\\n    if (b >= kBatchSize || h >= kNumQHeads || t >= seq_len || d >= kHeadDim) {\\n        return;\\n    }\\n\\n    __shared__ float warp_sums[8];\\n    __shared__ float s_alpha;\\n    __shared__ float s_beta;\\n    __shared__ float s_l;\\n    __shared__ volatile float s_mfma_sink;\\n\\n    if (threadIdx.x == 0) {\\n        s_alpha = 1.0f;\\n        s_beta = 0.0f;\\n        s_l = 1.0f;\\n        s_mfma_sink = 0.0f;\\n    }\\n    __syncthreads();\\n\\n    const int64_t q_idx = ((((int64_t)b * kNumQHeads + h) * seq_len + t) * kHeadDim) + d;\\n    const float qd = bf16_to_float(q[q_idx]);\\n\\n    float acc = 0.0f;\\n    float m = -INFINITY;\\n    float l = 0.0f;\\n\\n    for (int j = 0; j <= t; ++j) {\\n        const int64_t kv_idx = ((((int64_t)b * seq_len) + j) * kHeadDim) + d;\\n        const float kd = bf16_to_float(k[kv_idx]);\\n        const float partial = qd * kd;\\n\\n        const float dot = block_reduce_sum(partial, warp_sums);\\n\\n        if (threadIdx.x == 0) {\\n            if (j == 0) {\\n                s_mfma_sink = mfma_probe_f32(qd, kd);\\n            }\\n\\n            const float score = dot * sm_scale;\\n            const float m_new = fmaxf(m, score);\\n            const float alpha = expf(m - m_new);\\n            const float beta = expf(score - m_new);\\n            l = l * alpha + beta;\\n            m = m_new;\\n\\n            s_alpha = alpha;\\n            s_beta = beta;\\n            s_l = l;\\n        }\\n        __syncthreads();\\n\\n        const float vd = bf16_to_float(v[kv_idx]);\\n        acc = acc * s_alpha + s_beta * vd;\\n\\n        __syncthreads();\\n    }\\n\\n    float out_val = acc / s_l;\\n    out[q_idx] = float_to_bf16(out_val);\\n}\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const __hip_bfloat16* q,\\n    const __hip_bfloat16* k,\\n    const __hip_bfloat16* v,\\n    __hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale) {\\n    dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass_kernel<<<grid, block, shared_mem, stream>>>(\\n        q, k, v, out, seq_len, sm_scale);\\n    return hipGetLastError();\\n}\\n</cuda_file>\\n\\n<cpp_file name=\\\"main.cpp\\\">\\n#include <torch/extension.h>\\n#include <pybind11/pybind11.h>\\n#include <hip/hip_runtime.h>\\n#include <hip/hip_bfloat16.h>\\n\\n#include \\\"kernel.h\\\"\\n\\n#include <sstream>\\n#include <string>\\n\\nnamespace py = pybind11;\\n\\n#define HIP_CHECK(cmd) 