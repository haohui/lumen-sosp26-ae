+def _read_prompt_suffix(path: Optional[Path]) -> str:
+    if path is None:
+        return ""
+    return _read_text(Path(path)).strip()
+
+
+def _append_prompt_suffix(prompt: str, suffix: str) -> str:
+    text = str(prompt or "")
+    suffix = str(suffix or "").strip()
+    if not suffix or suffix in text:
+        return text
+    return f"{text.rstrip()}\n\n{suffix}"
+
+def _normalize_inline_args_for_hip(code: str, backend: str) -> tuple[str, int]:
+    """Fix common load_inline arg-name mistakes for HIP runs."""
+    if str(backend).lower() != "hip":
+        return code, 0
+
+    out = str(code or "")
+    replaced = 0
+    out, n = re.subn(r"\bhip_sources\s*=", "cuda_sources=", out)
+    replaced += int(n)
+    out, n = re.subn(r"\bextra_hip_cflags\s*=", "extra_cuda_cflags=", out)
+    replaced += int(n)
+    return out, replaced
+
