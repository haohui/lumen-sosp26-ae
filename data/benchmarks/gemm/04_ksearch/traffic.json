ace\\n\\n__global__ __launch_bounds__(256) void gemm_bf16_var_mnk_kernel(\\n    const uint16_t* __restrict__ A,\\n    const uint16_t* __restrict__ B,\\n    uint16_t* __restrict__ C,\\n    int64_t M,\\n    int64_t N,\\n    int64_t K) {\\n  const int tx = threadIdx.x;\\n  const int ty = threadIdx.y;\\n  const int tid = ty * blockDim.x + tx;\\n  const int nthreads = blockDim.x * blockDim.y;\\n\\n  const int64_t block_m = static_cast<int64_t>(blockIdx.y) * BM;\\n  const int64_t block_n = static_cast<int64_t>(blockIdx.x) * BN;\\n\\n  const int local_row_base = ty * TM;\\n  const int local_col_base = tx * TN;\\n\\n  __shared__ uint16_t As[BM * BK];\\n  __shared__ uint16_t Bs[BK * BN];  // transposed: [kk, col]\\n\\n  float acc[TM][TN];\\n#pragma unroll\\n  for (int i = 0; i < TM; ++i) {\\n#pragma unroll\\n    for (int j = 0; j < TN; ++j) {\\n      acc[i][j] = 0.0f;\\n    }\\n  }\\n\\n  if (BK >= 2) {\\n    mfma_touch(0, 0, 0, 0);\\n  }\\n\\n  const bool full_m = (block_m + BM) <= M;\\n  const bool full_n = (block_n + BN) <= N;\\n\\n  for (int64_t k0 = 0; k0 < K; k0 += BK) {\\n    const bool full_k = (k0 + BK) <= K;\\n\\n    if (full_m && full_n && full_k) {\\n      uint32_t* As_vec = reinterpret_cast<uint32_t*>(As);\\n      for (int vidx = tid; vidx < (BM * BK) / 2; vidx += nthreads) {\\n        const int elem = vidx << 1;\\n        const int r = elem / BK;\\n        const int kk = elem - r * BK;\\n        const uint16_t* src = A + (block_m + r) * K + (k0 + kk);\\n        As_vec[vidx] = *reinterpret_cast<const uint32_t*>(src);\\n      }\\n\\n      for (int idx = tid; idx < BN * BK; idx += nthreads) {\\n        const int c = idx / BK;\\n        const int kk = idx - c * BK;\\n        Bs[kk * BN + c] = B[(block_n + c) * K + (k0 + kk)];\\n      }\\n    } else {\\n      for (int idx = tid; idx < BM * BK; idx += nthreads) {\\n        const int r = idx / BK;\\n        const int kk = idx - r * BK;\\n        const int64_t gm = block_m + r;\\n        const int64_t gk = k0 + kk;\\n 