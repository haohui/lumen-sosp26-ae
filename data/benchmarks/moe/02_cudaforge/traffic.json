5f; // 2^-10\\n        if (sign) out = -out;\\n        return out;\\n    }\\n}\\n\\n__device__ __forceinline__ float silu_f32(float x) {\\n    return x / (1.0f + expf(-x));\\n}\\n\\n__device__ __forceinline__ uint16_t float_to_bf16_bits(float x) {\\n    union { float f; uint32_t u; } v;\\n    v.f = x;\\n    uint32_t lsb = (v.u >> 16) & 1u;\\n    v.u += 0x7FFFu + lsb;\\n    return (uint16_t)(v.u >> 16);\\n}\\n\\ntemplate <bool CACHE_INPUT, typename index_t>\\n__global__ __launch_bounds__(THREADS, 2) void fused_moe_kernel_opt(\\n    const uint8_t* __restrict__ input_q,      // [T, D]\\n    const uint8_t* __restrict__ w1_q,         // [E, 2I, D]\\n    const uint8_t* __restrict__ w2_q,         // [E, D, I]\\n    const float* __restrict__ topk_weights,   // [T, K]\\n    const index_t* __restrict__ topk_ids,     // [T, K]\\n    const float* __restrict__ input_scale,    // [T, D/128]\\n    const float* __restrict__ fc1_scale,      // [E, (2I/128)*(D/128)]\\n    const float* __restrict__ fc2_scale,      // [E, (D/128)*(I/128)]\\n    uint16_t* __restrict__ out,               // [T, D] bf16 bits\\n    int tokens,\\n    int dim,\\n    int inter_dim,\\n    int experts,\\n    int topk\\n) {\\n    const int t = (int)blockIdx.x;\\n    if (t >= tokens) return;\\n    const int tid = (int)threadIdx.x;\\n\\n    extern __shared__ float smem[];\\n    float* out_accum = smem;                 // [dim]\\n    float* activated = smem + dim;           // [inter_dim]\\n    float* x_cache = nullptr;                // [dim] when CACHE_INPUT\\n    if constexpr (CACHE_INPUT) {\\n        x_cache = smem + dim + inter_dim;\\n    }\\n\\n    for (int o = tid; o < dim; o += blockDim.x) {\\n        out_accum[o] = 0.0f;\\n    }\\n\\n    const int dim_blocks = dim / BLOCK_Q;\\n    const int fc1_row_blocks = (2 * inter_dim) / BLOCK_Q;\\n    const int fc1_scale_stride = fc1_row_blocks * dim_blocks;\\n\\n    const int fc2_row_blocks = dim / BLOCK_Q;\\n    const int fc2_col_blocks = inter_dim / BLOCK_Q;\\n    const int fc2_scale_stride = fc2_row_blocks * fc2_col_blocks;\\n\\n    const int64_t input_base = (int64_t)t * (int64_t)dim;\\n    const int64_t topk_base = (int64_t)t * (int64_t)topk;\\n    const int64_t in_scale_base = (int64_t)t * (int64_t)dim_blocks;\\n\\n    const uint8_t* x_ptr = input_q + input_base;\\n    const float* in_s_ptr = input_scale + in_scale_base;\\n\\n    // Optimization: cache dequantized/scaled input once per token in LDS when possible.\\n    if constexpr (CACHE_INPUT) {\\n        for (int d = tid; d < dim; d += blockDim.x) {\\n            x_cache[d] = fp8_e4m3fnuz_to_float_fast(x_ptr[d]) * in_s_ptr[d >> 7];\\n        }\\n        __syncthreads();\\n    }\\n\\n    for (int k = 0; k < topk; ++k) {\\n        const int64_t e_raw = (int64_t)topk_ids[topk_base + k];\\n        const int e = (int)e_raw;\\n        const float rw = topk_weights[topk_base + k];\\n        const bool active = ((unsigned)e < (unsigned)experts) && (rw != 0.0f);\\n\\n        if (!active) {\\n            continue;\\n        }\\n\\n        const int64_t w1_e_base = (int64_t)e * (int64_t)(2 * inter_dim) * (int64_t)dim;\\n        const float* fc1_e = fc1_scale + (int64_t)e * (int64_t)fc1_scale_stride;\\n\\n        for (int base_i = tid; base_i < inter_dim; base_i += blockDim.x * FC1_ROWS_PER_THREAD) {\\n            const int i0 = base_i;\\n            const int i1 = base_i + blockDim.x;\\n            const bool v0 = (i0 < inter_dim);\\n            const bool v1 = (i1 < inter_dim);\\n\\n            float gate0 = 0.0f, up0 = 0.0f;\\n            float gate1 = 0.0f, up1 = 0.0f;\\n\\n            int rb_g0 = 0, rb_u0 = 0, rb_g1 = 0, rb_u1 = 0;\\n            int64_t row_g0_base = 0, row_u0_base = 0, row_g1_base = 0, row_u1_base = 0;\\n\\n            if (v0) {\\n                const int row_g0 = i0;\\n                const int row_u0 = i0 + inter_dim;\\n                rb_g0 = row_g0 >> 7;\\n                rb_u0 = row_u0 >> 7;\\n                row_g0_base = w1_e_base + (int64_t)row_g0 * (int64_t)dim;\\n                row_u0_base = w1_e_base + (int64_t)row_u0 * (int64_t)dim;\\n            }\\n            if (v1) {\\n                const int row_g1 = i1;\\n                const int row_u1 = i1 + inter_dim;\\n                rb_g1 = row_g1 >> 7;\\n                rb_u1 = row_u1 >> 7;\\n                row_g1_base = w1_e_base + (int64_t)row_g1 * (int64_t)dim;\\n                row_u1_base = w1_e_base + (int64_t)row_u1 * (int64_t)dim;\\n            }\\n\\n            for (int cb = 0; cb < dim_blocks; ++cb) {\\n                const int d0 = cb * BLOCK_Q;\\n                const float in_sc = in_s_ptr[cb];\\n\\n                float sg0 = 0.0f, su0 = 0.0f, sg1 = 0.0f, su1 = 0.0f;\\n                if (v0) {\\n                    sg0 = fc1_e[rb_g0 * dim_blocks + cb];\\n                    su0 = fc1_e[rb_u0 * dim_blocks + cb];\\n                }\\n                if (v1) {\\n                    sg1 = fc1_e[rb_g1 * dim_blocks + cb];\\n                    su1 = fc1_e[rb_u1 * dim_blocks + cb];\\n                }\\n\\n                #pragma unroll 8\\n                for (int j = 0; j < BLOCK_Q; ++j) {\\n                    const int d = d0 + j;\\n                    float xs;\\n                    if constexpr (CACHE_INPUT) {\\n                        xs = x_cache[d];\\n                    } else {\\n                        xs = fp8_e4m3fnuz_to_float_fast(x_ptr[d]) * in_sc;\\n                    }\\n\\n                    if (v0) {\\n                        const float wg = fp8_e4m3fnuz_to_float_fast(w1_q[row_g0_base + d]) * sg0;\\n                        const float wu = fp8_e4m3fnuz_to_float_fast(w1_q[row_u0_base + d]) * su0;\\n                        gate0 += xs * wg;\\n                        up0 += xs * wu;\\n                    }\\n                    if (v1) {\\n                        const float wg = fp8_e4m3fnuz_to_float_fast(w1_q[row_g1_base + d]) * sg1;\\n                        const float wu = fp8_e4m3fnuz_to_float_fast(w1_q[row_u1_base + d]) * su1;\\n                        gate1 += xs * wg;\\n                        up1 += xs * wu;\\n                    }\\n                }\\n            }\\n\\n            if (v0) activated[i0] = silu_f32(gate0) * up0;\\n            if (v1) activated[i1] = silu_f32(gate1) * up1;\\n        }\\n\\n        __syncthreads();\\n\\n        const int64_t w2_e_base = (int64_t)e * (int64_t)dim * (int64_t)inter_dim;\\n        const float* fc2_e = fc2_scale + (int64_t)e * (int64_t)fc2_scale_stride;\\n\\n        for (int o = tid; o < dim; o += blockDim.x) {\\n            const int ob = o >> 7;\\n            const int ob_off = ob * fc2_col_blocks;\\n            float sum = 0.0f;\\n            const int64_t w2_row_base = w2_e_base + (int64_t)o * (int64_t)inter_dim;\\n\\n            for (int ib = 0; ib < fc2_col_blocks; ++ib) {\\n                const float ws = fc2_e[ob_off + ib];\\n                const int i0 = ib * BLOCK_Q;\\n\\n                #pragma unroll 8\\n                for (int j = 0; j < BLOCK_Q; ++j) {\\n                    const int i = i0 + j;\\n                    const float w = fp8_e4m3fnuz_to_float_fast(w2_q[w2_row_base + i]) * ws;\\n                    sum += activated[i] * w;\\n                }\\n            }\\n            out_accum[o] += rw * sum;\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    const int64_t out_base = (int64_t)t * (int64_t)dim;\\n    for (int o = tid; o < dim; o += blockDim.x) {\\n        out[out_base + o] = float_to_bf16_bits(out_accum[o]);\\n    }\\n}\\n\\n} // namespace\\n\\ntorch::Tensor fused_moe_forward(\\n    torch::Tensor input_q,\\n    torch::Tensor w1_q,\\n    torch::Tensor w2_q,\\n    torch::Tensor topk_weights,\\n    torch::Tensor topk_ids,\\n    torch::Tensor input_scale,\\n    torch::Tensor fc1_scale,\\n    torch::Tensor fc2_scale\\n) {\\n    TORCH_CHECK(input_q.is_cuda(), \\\"input_q must be a GPU tensor\\\");\\n    TORCH_CHECK(w1_q.is_cuda() && w2_q.is_cuda() && topk_weights.is_cuda() && topk_ids.is_cuda() &&\\n                input_scale.is_cuda() && fc1_scale.is_cuda() && fc2_scale.is_cuda(),\\n                \\\"All runtime tensors must be on GPU\\\");\\n\\n    const auto dev = input_q.device();\\n    TORCH_CHECK(w1_q.device() == dev && w2_q.device() == dev && topk_weights.device() == dev &&\\n                topk_ids.device() == dev && input_scale.device() == dev &&\\n                fc1_scale.device() == dev && fc2_scale.device() == dev,\\n                \\\"All runtime tensors must be on the same GPU device\\\");\\n\\n    TORCH_CHECK(input_q.element_size() == 1, \\\"input_q must be FP8/byte-backed tensor\\\");\\n    TORCH_CHECK(w1_q.element_size() == 1, \\\"w1_q must be FP8/byte-backed tensor\\\");\\n    TORCH_CHECK(w2_q.element_size() == 1, \\\"w2_q must be FP8/byte-backed tensor\\\");\\n\\n    TORCH_CHECK(topk_weights.scalar_type() == at::kFloat, \\\"topk_weights must be float32\\\");\\n    TORCH_CHECK(input_scale.scalar_type() == at::kFloat, \\\"input_scale must be float32\\\");\\n    TORCH_CHECK(fc1_scale.scalar_type() == at::kFloat, \\\"fc1_scale must be float32\\\");\\n    TORCH_CHECK(fc2_scale.scalar_type() == at::kFloat, \\\"fc2_scale must be float32\\\");\\n    TORCH_CHECK(topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,\\n                \\\"topk_ids must be int32 or int64\\\");\\n\\n    TORCH_CHECK(input_q.is_contiguous() && w1_q.is_contiguous() && w2_q.is_contiguous() &&\\n                topk_weights.is_contiguous() && topk_ids.is_contiguous() &&\\n                input_scale.is_contiguous() && fc1_scale.is_contiguous() && fc2_scale.is_contiguous(),\\n                \\\"All tensors must be contiguous\\\");\\n\\n    TORCH_CHECK(input_q.dim() == 2, \\\"input_q must be [T, D]\\\");\\n    TORCH_CHECK(w1_q.dim() == 3, \\\"w1_q must be [E, 2I, D]\\\");\\n    TORCH_CHECK(w2_q.dim() == 3, \\\"w2_q must be [E, D, I]\\\");\\n    TORCH_CHECK(topk_weights.dim() == 2 && topk_ids.dim() == 2, \\\"topk tensors must be [T, K]\\\");\\n    T