ide = static_cast<int>((twoI64 / BLOCK_N) * D_blocks);\\n    int fc2_stride = static_cast<int>((D64 / BLOCK_N) * I_blocks);\\n\\n    TORCH_CHECK(input_scale_f32.size(0) == T64 && input_scale_f32.size(1) == D_blocks, \\\"input_scale shape mismatch\\\");\\n    TORCH_CHECK(fc1_scale_f32.size(0) == E64 && fc1_scale_f32.size(1) == fc1_stride, \\\"fc1_scale shape mismatch\\\");\\n    TORCH_CHECK(fc2_scale_f32.size(0) == E64 && fc2_scale_f32.size(1) == fc2_stride, \\\"fc2_scale shape mismatch\\\");\\n\\n    int T = static_cast<int>(T64);\\n    int D = static_cast<int>(D64);\\n    int E = static_cast<int>(E64);\\n    int I = static_cast<int>(I64);\\n    int K = static_cast<int>(K64);\\n\\n    size_t smem_bytes = static_cast<size_t>(D + I) * sizeof(float);\\n    TORCH_CHECK(smem_bytes <= 64 * 1024, \\\"shared memory requirement exceeds 64KB\\\");\\n\\n    auto out_acc = torch::zeros({T64, D64}, input_q_bf16.options().dtype(torch::kFloat32));\\n    auto out_bf16 = torch::empty({T64, D64}, input_q_bf16.options().dtype(torch::kBFloat16));\\n\\n    const uint16_t* input_ptr = reinterpret_cast<const uint16_t*>(input_q_bf16.data_ptr<at::BFloat16>());\\n    const uint16_t* w1_ptr = reinterpret_cast<const uint16_t*>(w1_q_bf16.data_ptr<at::BFloat16>());\\n    const uint16_t* w2_ptr = reinterpret_cast<const uint16_t*>(w2_q_bf16.data_ptr<at::BFloat16>());\\n    float* out_acc_ptr = out_acc.data_ptr<float>();\\n    uint16_t* out_ptr = reinterpret_cast<uint16_t*>(out_bf16.data_ptr<at::BFloat16>());\\n\\n    int routes = T * K;\\n    int threads = 256;\\n\\n    if (routes > 0) {\\n        hipLaunchKernelGGL(\\n            fused_moe_route_kernel,\\n            dim3(routes),\\n            dim3(threads),\\n            smem_bytes,\\n            0,\\n            input_ptr,\\n            w1_ptr,\\n            w2_ptr,\\n            topk_weights_f32.data_ptr<float>(),\\n            topk_ids_i32.data_ptr<int32_t>(),\\n            input_scale_f32.data_ptr<float>(),\\n            fc1_scale_f32.data_