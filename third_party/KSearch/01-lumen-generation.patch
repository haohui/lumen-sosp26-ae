+                out_parts.append(src[i : args_end + 1])
+                i = args_end + 1
+                continue
+
+            kernel_name = src[kstart:kend]
+            if kernel_name not in kernel_sigs:
+                raise ValueError(
+                    f"HIP hard-constraint failed: kernel launch in main.cpp references unknown kernel '{kernel_name}'."
+                )
+
+            cfg_items = self._split_top_level_commas(src[launch_idx + 3 : cfg_end])
+            if len(cfg_items) < 2:
+                raise ValueError(
+                    f"HIP hard-constraint failed: invalid launch config for '{kernel_name}' in main.cpp."
+                )
+            grid_expr = cfg_items[0]
+            block_expr = cfg_items[1]
+            shared_expr = cfg_items[2] if len(cfg_items) >= 3 else "0"
+            stream_expr = cfg_items[3] if len(cfg_items) >= 4 else "0"
+
+            arg_items = self._split_top_level_commas(src[j + 1 : args_end])
+            sig = kernel_sigs[kernel_name]
+            expected = len(sig.get("arg_names", []))
+            if expected != len(arg_items):
+                raise ValueError(
+                    f"HIP hard-constraint failed: launch arg count mismatch for '{kernel_name}' "
+                    f"(expected {expected}, got {len(arg_items)})."
+                )
+
+            wrapper_call = (
+                f"ksearch_launch_{kernel_name}({grid_expr}, {block_expr}, {shared_expr}, {stream_expr}"
+                + (", " + ", ".join(arg_items) if arg_items else "")
+                + ");"
+            )
+
+            out_parts.append(src[i:kstart])
+            out_parts.append(wrapper_call)
+            i = sem + 1
+            replaced += 1
+            if kernel_name not in used_kernels:
+                used_kernels.append(kernel_name)
+
+        return "".join(out_parts), used_kernels, replaced
+
+    def _ensure_public_hip_headers(self, text: str) -> str:
+        s = str(text or "")
+        replacements = [
+            (r"#\s*include\s*<hip/amd_detail/amd_hip_bfloat16\.h>", "#include <hip/hip_bfloat16.h>"),
+            (r"#\s*include\s*<hip/amd_detail/amd_hip_bf16\.h>", "#include <hip/hip_bf16.h>"),
+            (r"#\s*include\s*<hip/amd_detail/amd_hip_fp8\.h>", "#include <hip/hip_fp8.h>"),
+            (r"#\s*include\s*<hip/amd_detail/hip_fp8\.h>", "#include <hip/hip_fp8.h>"),
+        ]
+        for pat, dst in replacements:
+            s = re.sub(pat, dst, s)
+        # Drop any remaining private headers.
+        s = re.sub(r"^\s*#\s*include\s*<hip/amd_detail/[^>]+>\s*$", "", s, flags=re.MULTILINE)
+        return s
+
+    def _ensure_include_line(self, text: str, include_line: str) -> str:
+        s = str(text or "")
+        inc = str(include_line or "").strip()
+        if not inc:
+            return s
+        if inc in s:
+            return s
+        include_matches = list(re.finditer(r"^\s*#\s*include[^\n]*\n", s, flags=re.MULTILINE))
+        if include_matches:
+            idx = include_matches[-1].end()
+            return s[:idx] + inc + "\n" + s[idx:]
+        return inc + "\n" + s
+
+    def _normalize_bf16_intrinsics(self, text: str) -> str:
+        s = str(text or "")
+        if "__bfloat162float" in s:
+            s = re.sub(r"__bfloat162float\s*\(", "static_cast<float>(", s)
+        if "__float2bfloat16_rn" in s:
+            s = re.sub(r"__float2bfloat16_rn\s*\(", "hip_bfloat16(", s)
+        if "__float2bfloat16" in s:
+            s = re.sub(r"__float2bfloat16\s*\(", "hip_bfloat16(", s)
+        return s
+
+    def _normalize_stream_binding_in_main_cpp(self, text: str) -> str:
+        s = str(text or "")
+        # Normalize common ATen stream helper calls to literal stream 0 for portability.
+        stream_call_patterns = [
+            r"at::cuda::getCurrentCUDAStream\s*\([^)]*\)",
+            r"at::hip::getCurrentHIPStreamMasqueradingAsCUDA\s*\([^)]*\)",
+            r"at::hip::getCurrentHIPStream\s*\([^)]*\)",
+            r"c10::hip::getCurrentHIPStreamMasqueradingAsCUDA\s*\([^)]*\)",
+            r"c10::hip::getCurrentHIPStream\s*\([^)]*\)",
+        ]
+        for pat in stream_call_patterns:
+            s = re.sub(pat, "0", s)
+
+        # Keep assignment normalization conservative to avoid corrupting tensor vars
+        # (e.g., `auto C = at::zeros(...)` must never become a stream variable).
+        # 1) Variable name itself contains "stream".
+        stream_named_assign_pat = re.compile(
+            r"^(\s*)(?:auto|hipStream_t|cudaStream_t)\s+([A-Za-z_]\w*stream\w*)\s*=\s*[^;]*(?:at::|c10::)[^;]*;\s*$",
+            flags=re.MULTILINE | re.IGNORECASE,
+        )
+        # 2) RHS clearly calls a stream getter/helper.
+        stream_getter_assign_pat = re.compile(
+            r"^(\s*)(?:auto|hipStream_t|cudaStream_t)\s+([A-Za-z_]\w*)\s*=\s*[^;]*(?:getCurrent\w*Stream|stream\(\s*\)|hipStream|cudaStream)[^;]*;\s*$",
+            flags=re.MULTILINE | re.IGNORECASE,
+        )
+
+        def _repl(m: re.Match[str]) -> str:
+            indent = m.group(1)
+            var_name = m.group(2)
+            return f"{indent}hipStream_t {var_name} = 0;"
+
+        s = stream_named_assign_pat.sub(_repl, s)
+        s = stream_getter_assign_pat.sub(_repl, s)
+        return s
+
+    def _ensure_tile_macros_in_main_cpp(self, main_cpp: str, kernel_cu: str) -> str:
+        """
+        Some generated main.cpp launch helpers use TILE_M/N/K without defining them.
+        Inject conservative defaults (or kernel.cu values when available) to keep
+        compilation robust.
+        """
+        s = str(main_cpp or "")
+        if not s:
+            return s
+
+        defaults = {"TILE_M": "64", "TILE_N": "64", "TILE_K": "16"}
+        if not any(re.search(rf"\b{name}\b", s) for name in defaults):
+            return s
+
+        cu = str(kernel_cu or "")
+
+        def _macro_value(name: str) -> str:
+            m = re.search(rf"^\s*#\s*define\s+{name}\s+(\d+)\b", cu, flags=re.MULTILINE)
+            if m:
+                return str(m.group(1))
+            return defaults[name]
+
+        missing: List[Tuple[str, str]] = []
+        for name in defaults:
+            has_define = re.search(rf"^\s*#\s*define\s+{name}\b", s, flags=re.MULTILINE)
+            has_const_int = re.search(
+                rf"\b(?:const|constexpr)\s+int\s+{name}\b",
+                s,
+                flags=re.MULTILINE,
+            )
+            if not has_define and not has_const_int:
+                missing.append((name, _macro_value(name)))
+        if not missing:
+            return s
+
+        block_parts: List[str] = []
+        for name, value in missing:
+            block_parts.append(f"#ifndef {name}\n#define {name} {value}\n#endif")
+        block = "\n".join(block_parts) + "\n"
+
+        include_matches = list(re.finditer(r"^\s*#\s*include[^\n]*\n", s, flags=re.MULTILINE))
+        if include_matches:
+            idx = include_matches[-1].end()
+            return s[:idx] + block + s[idx:]
+        return block + s
+
+    def _normalize_torch_rocm_device_api_in_main_cpp(self, text: str) -> str:
+        """
+        Some PyTorch ROCm builds still use CUDA-style device APIs in C++ extension
+        code paths. Normalize generated main.cpp to portable forms.
+        """
+        s = str(text or "")
+        if not s or not self._is_amd_rocm_flow():
+            return s
+        s = re.sub(r"\.is_hip\s*\(\s*\)", ".is_cuda()", s)
+        s = re.sub(r"\bat::kHIP\b", "at::kCUDA", s)
+        s = re.sub(r"\bc10::DeviceType::HIP\b", "c10::DeviceType::CUDA", s)
+        s = re.sub(r"\bat::DeviceType::HIP\b", "at::DeviceType::CUDA", s)
+        return s
+
+    def _append_wrapper_declarations_to_header(
+        self,
+        header_text: str,
+        kernel_sigs: Dict[str, Dict[str, List[str]]],
+        used_kernels: List[str],
+    ) -> str:
+        hdr = str(header_text or "")
+        decls: List[str] = []
+        for kname in used_kernels:
+            if f"ksearch_launch_{kname}(" in hdr:
+                continue
+            sig = kernel_sigs.get(kname) or {}
+            param_decls = list(sig.get("param_decls", []))
+            head_params = ["dim3 grid", "dim3 block", "size_t shared_mem", "hipStream_t stream"]
+            all_params = head_params + param_decls
+            decl = (
+                f"hipError_t ksearch_launch_{kname}(\n    "
+                + ",\n    ".join(all_params)
+                + "\n);"
+            )
+            decls.append(decl)
+        if not decls:
+            return hdr
+        block = "\n\n// k-search hard-constraint launch wrappers\n" + "\n\n".join(decls) + "\n"
+        endif_idx = hdr.rfind("#endif")
+        if endif_idx >= 0:
+            return hdr[:endif_idx].rstrip() + "\n" + block + "\n" + hdr[endif_idx:]
+        return hdr.rstrip() + "\n" + block
+
+    def _append_wrapper_definitions_to_kernel_cu(
+        self,
+        cu_text: str,
+        kernel_sigs: Dict[str, Dict[str, List[str]]],
+        used_kernels: List[str],
+    ) -> str:
+        cu = str(cu_text or "")
+        defs: List[str] = []
+        for kname in used_kernels:
+            if f"ksearch_launch_{kname}(" in cu:
+                continue
+            sig = kernel_sigs.get(kname) or {}
+            param_decls = list(sig.get("param_decls", []))
+            arg_names = list(sig.get("arg_names", []))
+            head_params = ["dim3 grid", "dim3 block", "size_t shared_mem", "hipStream_t stream"]
+            all_params = head_params + param_decls
+            call_args = ", ".join(arg_names)
+            body = (
+                f"hipError_t ksearch_launch_{kname}(\n    "
+                + ",\n    ".join(all_params)
+                + "\n) {\n"
+                + f"    {kname}<<<grid, block, shared_mem, stream>>>({call_args});\n"
+                + "    return hipGetLastError();\n"
+                + "}"
+            )
+            defs.append(body)
+        if not defs:
+            return cu
+        block = "\n\n// k-search hard-constraint launch wrappers\n" + "\n\n".join(defs) + "\n"
+        return cu.rstrip() + "\n" + block
+
+    def _apply_hip_rocm_hard_constraints(self, files: Dict[str, str]) -> Dict[str, str]:
+        if (self.language or "").strip().lower() != "hip":
+            return files
+        if not self._is_amd_rocm_flow():
+            return files
+        if not isinstance(files, dict):
+            return files
+
+        out = {str(k): str(v or "") for k, v in files.items()}
+        for k in ("kernel.h", "kernel.cu", "main.cpp"):
+            if k in out:
+                out[k] = self._ensure_public_hip_headers(out[k])
+                out[k] = self._normalize_bf16_intrinsics(out[k])
+                if "hip_bfloat16" in out[k]:
+                    out[k] = self._ensure_include_line(out[k], "#include <hip/hip_bfloat16.h>")
+
+        main_cpp = str(out.get("main.cpp", "") or "")
+        main_cpp = self._normalize_stream_binding_in_main_cpp(main_cpp)
+        main_cpp = self._normalize_torch_rocm_device_api_in_main_cpp(main_cpp)
+        main_cpp = self._ensure_tile_macros_in_main_cpp(main_cpp, str(out.get("kernel.cu", "") or ""))
+        if "hipStream_t" in main_cpp:
+            main_cpp = self._ensure_include_line(main_cpp, "#include <hip/hip_runtime.h>")
+        if "hipLaunchKernelGGL" in main_cpp:
+            raise ValueError(
+                "HIP hard-constraint failed: main.cpp contains forbidden hipLaunchKernelGGL call."
+            )
+
+        kernel_h = str(out.get("kernel.h", "") or "")
+        kernel_sigs = self._extract_kernel_signatures_from_header(kernel_h)
+        new_main, used_kernels, replaced = self._rewrite_main_cpp_launches_to_wrappers(main_cpp, kernel_sigs)
+        out["main.cpp"] = new_main
+        if replaced > 0:
+            out["kernel.h"] = self._append_wrapper_declarations_to_header(
+                str(out.get("kernel.h", "") or ""),
+                kernel_sigs,
+                used_kernels,
+            )
+            out["kernel.cu"] = self._append_wrapper_definitions_to_kernel_cu(
+                str(out.get("kernel.cu", "") or ""),
+                kernel_sigs,
+                used_kernels,
+            )
+
+        # Hard stop: direct launches in main.cpp are forbidden.
+        if "<<<" in str(out.get("main.cpp", "") or "") or "hipLaunchKernelGGL" in str(out.get("main.cpp", "") or ""):
+            raise ValueError(
+                "HIP hard-constraint failed: main.cpp still contains direct kernel launch syntax."
+            )
+
+        for k in ("kernel.h", "kernel.cu", "main.cpp"):
+            if k in out:
+                out[k] = self._ensure_public_hip_headers(out[k])
+
+        return out
