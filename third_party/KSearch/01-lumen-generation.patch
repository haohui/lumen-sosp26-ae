+    @classmethod
+    def _max_abs_error(cls, a: Any, b: Any) -> float:
+        try:
+            import torch  # type: ignore
+        except Exception:
+            return float("inf")
+        ta = cls._flatten_tensors(a)
+        tb = cls._flatten_tensors(b)
+        if len(ta) != len(tb):
+            return float("inf")
+        max_err = 0.0
+        for xa, xb in zip(ta, tb):
+            try:
+                if tuple(xa.shape) != tuple(xb.shape):
+                    return float("inf")
+                err = torch.max(torch.abs(xa.float() - xb.float())).item()
+                max_err = max(max_err, float(err))
+            except Exception:
+                return float("inf")
+        return float(max_err)
+
+    @classmethod
+    def _allclose(cls, a: Any, b: Any, *, rtol: float, atol: float) -> bool:
+        try:
+            import torch  # type: ignore
+        except Exception:
+            return False
+        ta = cls._flatten_tensors(a)
+        tb = cls._flatten_tensors(b)
+        if len(ta) != len(tb):
+            return False
+        for xa, xb in zip(ta, tb):
+            try:
+                if tuple(xa.shape) != tuple(xb.shape):
+                    return False
+                if not torch.allclose(xa.float(), xb.float(), rtol=float(rtol), atol=float(atol), equal_nan=False):
+                    return False
+            except Exception:
+                return False
+        return True
