+    def _gemm_mfma_guardrail_failure(self, *, definition: Any, solution: Any) -> str | None:
+        """
+        Best-effort static guardrail for GEMM HIP submissions:
+        reject pseudo-MFMA / non-MFMA kernels before benchmarking.
+        """
+        try:
+            if str(getattr(definition, "op_type", "") or "").strip().lower() != "gemm":
+                return None
+            spec = getattr(solution, "spec", None)
+            lang_raw = getattr(spec, "language", "") if spec is not None else ""
+            lang = str(getattr(lang_raw, "value", lang_raw) or "").strip().lower()
+            if lang != "hip":
+                return None
+
+            src_by_path: dict[str, str] = {}
+            for sf in list(getattr(solution, "sources", []) or []):
+                p = str(getattr(sf, "path", "") or "").strip()
+                if not p:
+                    continue
+                src_by_path[p] = str(getattr(sf, "content", "") or "")
+
+            kernel_src = str(src_by_path.get("kernel.cu", "") or src_by_path.get("kernel.hip", "") or "")
+            if not kernel_src.strip():
+                return (
+                    "GEMM MFMA guard failed: missing kernel source (kernel.cu/kernel.hip). "
+                    "Expected explicit MFMA kernel implementation."
+                )
+
+            low = kernel_src.lower()
+            has_mfma = ("__builtin_amdgcn_mfma" in kernel_src) or ("v_mfma" in low)
+            if not has_mfma:
+                return (
+                    "GEMM MFMA guard failed: no MFMA intrinsic/instruction found in kernel source. "
+                    "Main accumulation path must use real MFMA."
+                )
+
+            fake_tokens = ("mfma_touch(", "mfma_probe(", "mfma_keepalive(")
+            if any(tok in low for tok in fake_tokens):
+                return (
+                    "GEMM MFMA guard failed: detected forbidden fake-MFMA helper pattern "
+                    "(mfma_touch/mfma_probe/mfma_keepalive)."
+                )
+
+            banned_runtime_tokens = (
+                "torch::matmul(",
+                "at::matmul(",
+                ".matmul(",
+                "einsum(",
+                "bmm(",
+                "hipblas",
+                "rocblas",
+                "hipblaslt",
+            )
+            if any(tok in low for tok in banned_runtime_tokens):
+                return (
+                    "GEMM MFMA guard failed: detected banned fallback/delegation call "
+                    "(matmul/einsum/bmm or BLAS delegate) in timed kernel path."
+                )
+            return None
+        except Exception:
+            # Guardrail is best-effort; never crash evaluation due to checker issues.
+            return None
