eam,\\n    const uint16_t* A,\\n    const uint16_t* B,\\n    uint16_t* C,\\n    int64_t M,\\n    int64_t N,\\n    int64_t K) {\\n  gemm_bf16_var_mnk_kernel<<<grid, block, shared_mem, stream>>>(A, B, C, M, N, K);\\n  return hipGetLastError();\\n}\\n</cuda_file>\\n\\n<cpp_file name=\\\"main.cpp\\\">\\n#include <torch/extension.h>\\n#include <hip/hip_runtime.h>\\n\\n#include <cstdint>\\n#include <string>\\n\\n#include \\\"kernel.h\\\"\\n\\nnamespace py = pybind11;\\n\\nstatic inline void check_hip(hipError_t err, const char* msg) {\\n  TORCH_CHECK(err == hipSuccess, msg, \\\" (\\\", hipGetErrorString(err), \\\")\\\");\\n}\\n\\ntorch::Tensor run(torch::Tensor A, torch::Tensor B) {\\n  TORCH_CHECK(A.dim() == 2, \\\"A must be 2D, got dim=\\\", A.dim());\\n  TORCH_CHECK(B.dim() == 2, \\\"B must be 2D, got dim=\\\", B.dim());\\n\\n  const bool return_cpu = (!A.is_cuda() && !B.is_cuda());\\n\\n  auto M = A.size(0);\\n  auto K = A.size(1);\\n  TORCH_CHECK(B.size(1) == K, \\\"K mismatch: A.shape[1]=\\\", K, \\\", B.shape[1]=\\\", B.size(1));\\n  auto N = B.size(0);\\n\\n  auto A_bf16 = A.to(torch::kBFloat16).contiguous();\\n  auto B_bf16 = B.to(torch::kBFloat16).contiguous();\\n\\n  torch::Device device = A_bf16.is_cuda()\\n                             ? A_bf16.device()\\n                             : (B_bf16.is_cuda() ? B_bf16.device() : torch::Device(torch::kCUDA, 0));\\n  TORCH_CHECK(device.is_cuda(), \\\"HIP device is required\\\");\\n\\n  int device_index = device.has_index() ? device.index() : 0;\\n  check_hip(hipSetDevice(device_index), \\\"hipSetDevice failed\\\");\\n\\n  if (!A_bf16.is_cuda() || A_bf16.get_device() != device_index) {\\n    A_bf16 = A_bf16.to(device).contiguous();\\n  }\\n  if (!B_bf16.is_cuda() || B_bf16.get_device() != device_index) {\\n    B_bf16 = B_bf16.to(device).contiguous();\\n  }\\n\\n  auto C_dev = torch::empty(\\n      {M, N},\\n      torch::TensorOptions().dtype(torch::kBFloat16).device(device).layout(torch::kStrided));\\n\\n  if (M > 0 &&