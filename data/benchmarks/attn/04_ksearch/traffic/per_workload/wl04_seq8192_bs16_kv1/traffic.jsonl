": "{\"input\":\"You are improving a HIP C++ kernel on MI300X.\\nThe current implementation may be correct-but-slower-than-desired, or it may have regressed.\\n\\nOriginal Specification:\\nName: dense_qkv_prefill_causal_h8_kv1_d128_bs16\\nType: dense_attention\\n\\nAxes:\\n  batch_size: constant = 16\\n  num_q_heads: constant = 8\\n  num_kv_heads: constant = 1\\n  seq_len: variable (Sequence length for prefill. q/k/v share the same sequence length.)\\n  head_dim: constant = 128\\n\\nInputs:\\n  q: [batch_size, num_q_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  k: [batch_size, num_kv_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  v: [batch_size, num_kv_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  sm_scale: scalar (DType.FLOAT32) - Softmax scale, usually 1/sqrt(head_dim).\\n\\nOutputs:\\n  output: [batch_size, num_q_heads, seq_len, head_dim] (DType.BFLOAT16) - Dense causal prefill attention output.\\n\\nConstraints:\\n  - batch_size == 16\\n  - head_dim == 128\\n  - num_kv_heads == 1\\n  - num_q_heads == 8\\n\\n\\nReference Implementation:\\nimport torch\\n\\n\\n@torch.no_grad()\\ndef run(q, k, v, sm_scale):\\n    # dense SDPA reference (forward-only, causal prefill)\\n    assert q.ndim == 4 and k.ndim == 4 and v.ndim == 4\\n    bq, hq, sq, dq = q.shape\\n    bk, hk, sk, dk = k.shape\\n    bv, hv, sv, dv = v.shape\\n\\n    assert (bq, sq, dq) == (bk, sk, dk) == (bv, sv, dv)\\n    assert hq == 8\\n    assert bq == 16\\n    assert hk == 1\\n    assert hv == hk\\n    assert dq == 128\\n\\n    if hk == 1:\\n        k = k.repeat_interleave(8, dim=1)\\n        v = v.repeat_interleave(8, dim=1)\\n\\n    q = q.to(torch.float32)\\n    k = k.to(torch.float32)\\n    v = v.to(torch.float32)\\n\\n    out = torch.nn.functional.scaled_dot_product_attention(\\n        q,\\n        k,\\n        v,\\n        attn_mask=None,\\n        dropout_p=0.0,\\n        is_causal=True,\\n        scale=float(sm_scale),\\n    )\\n    return out.to(torch.bfloat16)\\n\\nCycle-Best Base Implementation (reference):\\n<header_file name=\\\"kernel.h\\\">\\n#ifndef KERNEL_H_\\n#define KERNEL_H_\\n\\n#include <cstddef>\\n#include <cstdint>\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16_shared_kv_kernel(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale);\\n\\n#endif  // KERNEL_H_\\n</header_file>\\n\\n<cuda_file name=\\\"kernel.cu\\\">\\n#include \\\"kernel.h\\\"\\n\\n#include <cmath>\\n#include <cstdint>\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\nnamespace {\\n\\nconstexpr int kBatchSize = 16;\\nconstexpr int kNumQHeads = 8;\\nconstexpr int kHeadDim = 128;\\nconstexpr int kWaveSize = 64;\\n\\nunion Bf16Bits {\\n    hip_bfloat16 bf16;\\n    uint16_t u16;\\n};\\n\\nunion F32Bits {\\n    float f32;\\n    uint32_t u32;\\n};\\n\\n#if defined(__has_builtin)\\n#if __has_builtin(__builtin_amdgcn_mfma_f32_16x16x4f32)\\n#define KSEARCH_HAS_MFMA_F32 1\\nusing fp32x4 = float __attribute__((ext_vector_type(4)));\\n__device__ __forceinline__ float ksearch_mfma_probe(float a, float b) {\\n    fp32x4 c = {0.f, 0.f, 0.f, 0.f};\\n    c = __builtin_amdgcn_mfma_f32_16x16x4f32(a, b, c, 0, 0, 0);\\n    return c[0] + c[1] + c[2] + c[3];\\n}\\n#else\\n#define KSEARCH_HAS_MFMA_F32 0\\n__device__ __forceinline__ float ksearch_mfma_probe(float a, float b) {\\n    return a * b;\\n}\\n#endif\\n#else\\n#define KSEARCH_HAS_MFMA_F32 0\\n__device__ __forceinline__ float ksearch_mfma_probe(float a, float b) {\\n    return a * b;\\n}\\n#endif\\n\\n__device__ __forceinline__ float bf16_to_float(hip_bfloat16 x) {\\n    Bf16Bits in;\\n    in.bf16 = x;\\n    F32Bits out;\\n    out.u32 = static_cast<uint32_t>(in.u16) << 16;\\n    return out.f32;\\n}\\n\\n__device__ __forceinline__ hip_bfloat16 float_to_bf16(float x) {\\n    F32Bits in;\\n    in.f32 = x;\\n    const uint32_t lsb = (in.u32 >> 16) & 1u;\\n    const uint32_t rounding_bias = 0x7FFFu + lsb;\\n    in.u32 += rounding_bias;\\n\\n    Bf16Bits out;\\n    out.u16 = static_cast<uint16_t>(in.u32 >> 16);\\n    return out.bf16;\\n}\\n\\n__device__ __forceinline__ float wave_reduce_sum(float v) {\\n#pragma unroll\\n    for (int offset = kWaveSize / 2; offset > 0; offset >>= 1) {\\n        v += __shfl_down(v, offset, kWaveSize);\\n    }\\n    return v;\\n}\\n\\n__global__ __launch_bounds__(512) void dense_qkv_prefill_causal_h8_kv1_d128_bs16_shared_kv_kernel(\\n    const hip_bfloat16* __restrict__ q,\\n    const hip_bfloat16* __restrict__ k,\\n    const hip_bfloat16* __restrict__ v,\\n    hip_bfloat16* __restrict__ out,\\n    int seq_len,\\n    float sm_scale) {\\n    const int tid = static_cast<int>(threadIdx.x);\\n    const int wave_id = tid / kWaveSize;  // one wave per q head\\n    const int lane = tid % kWaveSize;\\n\\n    const int q_pos = static_cast<int>(blockIdx.x);\\n    const int b = static_cast<int>(blockIdx.y);\\n\\n    if (wave_id >= kNumQHeads || q_pos >= seq_len || b >= kBatchSize) {\\n        return;\\n    }\\n\\n    __shared__ float s_k[kHeadDim];\\n    __shared__ float s_v[kHeadDim];\\n\\n    const int d0 = lane;\\n    const int d1 = lane + kWaveSize;\\n\\n    const int64_t q_base =\\n        (((static_cast<int64_t>(b) * kNumQHeads + wave_id) * seq_len + q_pos) * kHeadDim);\\n\\n    const float q0 = bf16_to_float(q[q_base + d0]);\\n    const float q1 = bf16_to_float(q[q_base + d1]);\\n\\n    float m_i = -INFINITY;\\n    float l_i = 0.0f;\\n    float acc0 = 0.0f;\\n    float acc1 = 0.0f;\\n\\n    for (int key_idx = 0; key_idx <= q_pos; ++key_idx) {\\n        if (tid < kHeadDim) {\\n            const int64_t kv_base = ((static_cast<int64_t>(b) * seq_len + key_idx) * kHeadDim);\\n            s_k[tid] = bf16_to_float(k[kv_base + tid]);\\n            s_v[tid] = bf16_to_float(v[kv_base + tid]);\\n        }\\n\\n        __syncthreads();\\n\\n        float partial = fmaf(q0, s_k[d0], q1 * s_k[d1]);\\n\\n#if KSEARCH_HAS_MFMA_F32\\n        if ((key_idx & 15) == 0) {\\n            volatile float mfma_sink = ksearch_mfma_probe(q0, s_k[d0]);\\n            partial += (mfma_sink != mfma_sink) ? 0.0f : 0.0f;\\n        }\\n#endif\\n\\n        float dot = wave_reduce_sum(partial);\\n        dot = __shfl(dot, 0, kWaveSize);\\n\\n        const float s_ij = dot * sm_scale;\\n        const float m_new = fmaxf(m_i, s_ij);\\n        const float alpha = expf(m_i - m_new);\\n        const float beta = expf(s_ij - m_new);\\n\\n        acc0 = acc0 * alpha + beta * s_v[d0];\\n        acc1 = acc1 * alpha + beta * s_v[d1];\\n        l_i = l_i * alpha + beta;\\n        m_i = m_new;\\n\\n        __syncthreads();\\n    }\\n\\n    const float inv_l = 1.0f / l_i;\\n    const int64_t out_base =\\n        (((static_cast<int64_t>(b) * kNumQHeads + wave_id) * seq_len + q_pos) * kHeadDim);\\n\\n    out[out_base + d0] = float_to_bf16(acc0 * inv_l);\\n    out[out_base + d1] = float_to_bf16(acc1 * inv_l);\\n}\\n\\n}  // namespace\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16_shared_kv_kernel(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale) {\\n    if (q == nullptr || k == nullptr || v == nullptr || out == nullptr || seq_len < 0) {\\n        return hipErrorInvalidValue;\\n    }\\n\\n    dense_qkv_prefill_causal_h8_kv1_d128_bs16_shared_kv_kernel<<<grid, block, shared_mem, stream>>>(\\n        q, k, v, out, seq_len, sm_scale);\\n\\n    return hipGetLastError();\\n}\\n</cuda_file>\\n\\n<cpp_file name=\\\"main.cpp\\\">\\n#include <torch/extension.h>\\n#include <pybind11/pybind11.h>\\n\\n#include <cstdint>\\n#include <vector>\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\n#in