 dim=\\\", A.dim());\\n  TORCH_CHECK(B.dim() == 2, \\\"B must be 2D, got dim=\\\", B.dim());\\n\\n  auto A_bf16 = (A.scalar_type() == torch::kBFloat16) ? A : A.to(torch::kBFloat16);\\n  auto B_bf16 = (B.scalar_type() == torch::kBFloat16) ? B : B.to(torch::kBFloat16);\\n\\n  A_bf16 = A_bf16.contiguous();\\n  B_bf16 = B_bf16.contiguous();\\n\\n  const int64_t M64 = A_bf16.size(0);\\n  const int64_t K64 = A_bf16.size(1);\\n  const int64_t N64 = B_bf16.size(0);\\n  TORCH_CHECK(B_bf16.size(1) == K64, \\\"B.shape[1] must equal A.shape[1] (K)\\\");\\n\\n  TORCH_CHECK(M64 >= 0 && N64 >= 0 && K64 >= 0, \\\"Invalid negative tensor dimensions\\\");\\n  TORCH_CHECK(M64 <= INT32_MAX && N64 <= INT32_MAX && K64 <= INT32_MAX,\\n              \\\"M/N/K exceed int32 range\\\");\\n\\n  const int M = static_cast<int>(M64);\\n  const int N = static_cast<int>(N64);\\n  const int K = static_cast<int>(K64);\\n\\n  auto out_cpu_opts = torch::TensorOptions().dtype(torch::kBFloat16).device(torch::kCPU);\\n\\n  if (M == 0 || N == 0) {\\n    return torch::empty({M64, N64}, out_cpu_opts);\\n  }\\n  if (K == 0) {\\n    return torch::zeros({M64, N64}, out_cpu_opts);\\n  }\\n\\n  int device_index = 0;\\n  if (A_bf16.device().is_cuda()) {\\n    device_index = A_bf16.get_device();\\n  } else if (B_bf16.device().is_cuda()) {\\n    device_index = B_bf16.get_device();\\n  }\\n\\n  KSEARCH_HIP_CHECK(hipSetDevice(device_index));\\n\\n  const auto gpu_device = torch::Device(torch::kCUDA, device_index);\\n\\n  auto A_gpu = A_bf16.to(gpu_device).contiguous();\\n  auto B_gpu = B_bf16.to(gpu_device).contiguous();\\n  auto C_gpu = torch::empty({M64, N64}, A_gpu.options().dtype(torch::kBFloat16));\\n\\n  const auto* A_ptr =\\n      reinterpret_cast<const hip_bfloat16*>(A_gpu.data_ptr<c10::BFloat16>());\\n  const auto* B_ptr =\\n      reinterpret_cast<const hip_bfloat16*>(B_gpu.data_ptr<c10::BFloat16>());\\n  auto* C_ptr =\\n      reinterpret_cast<hip_bfloat16*>(C_gpu.data_ptr<c10::BFloat16>());\\n\\n  const dim3