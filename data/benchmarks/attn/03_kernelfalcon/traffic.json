     sequence_length,\\n                num_kv_heads,\\n                head_dim,\\n                dtype=torch.bfloat16,\\n                device=device,\\n            )\\n            V = torch.randn(\\n                batch_size,\\n                sequence_length,\\n                num_kv_heads,\\n                head_dim,\\n                dtype=torch.bfloat16,\\n                device=device,\\n            )\\n            return [Q, K, V]\\n\\n        def get_init_inputs():\\n            return []\\n\\n        model = Model(*get_init_inputs()).to(device)\\n        model.eval()\\n\\n        Q, K, V = get_inputs()\\n\\n        print(\\\"Input info:\\\")\\n        print(f\\\"  Q: shape={tuple(Q.shape)}, dtype={Q.dtype}, device={Q.device}\\\")\\n        print(f\\\"  K: shape={tuple(K.shape)}, dtype={K.dtype}, device={K.device}\\\")\\n        print(f\\\"  V: shape={tuple(V.shape)}, dtype={V.dtype}, device={V.device}\\\")\\n        print(f\\\"  Q sample: {Q.flatten()[:8].float().cpu()}\\\")\\n\\n        with torch.no_grad():\\n            y_ref = model(Q, K, V)\\n\\n        # ---- Call kernel_function as a normal Python function ----\\n        try:\\n            with torch.no_grad():\\n                y_kernel = kernel_function(Q, K, V)\\n        except NameError as e:\\n            print(\\n                f\\\"Test failed: NameError (likely undefined helper in kernel.py): {e}\\\"\\n            )\\n            traceback.print_exc()\\n            return False\\n        except Exception as e:\\n            print(f\\\"kernel_function call failed: {e}\\\")\\n            traceback.print_exc()\\n            return False\\n\\n        # Handle possible tuple/list returns robustly\\n        if isinstance(y_kernel, (tuple, list)):\\n            if len(y_kernel) == 0:\\n                print(\\\"kernel_function returned an empty tuple/list\\\")\\n                return False\\n            print(\\n                \\\"kernel_function returned tuple/list; using first element for validation.\\\"\\n            )\\n            y_kernel = y_kernel[0]\\n\\n        if not isinstance(y_kernel, torch.Tensor):\\n            print(f\\\"kernel_function output is not a torch.Tensor, got {type(y_kernel)}\\\")\\n            return False\\n\\n        # Device check per requirement: compare against input.device directly\\n        if y_kernel.device != Q.device:\\n            print(\\n                f\\\"Device mismatch: result.device={y_kernel.device}, input.device={Q.device}\\\"\\n            )\\n            return False\\n\\n        if y_kernel.shape != y_ref.shape:\\n            print(\\n                f\\\"Shape mismatch: result.shape={tuple(y_kernel.shape)} vs ref.shape={tuple(y_ref.shape)}\\\"\\n            )\\n            return False\\n\\n        # BF16 + large reductions/softmax can accumulate larger numerical error.\\n        # Using slightly looser tolerance than default for stability.\\n        rtol = 1e-2\\n        atol = 2e-2\\n\\n        try:\\n            close = torch.allclose(y_kernel, y_ref, rtol=rtol, atol=atol)\\n        except Exception as cmp_e:\\n            print(f\\\"Numerical comparison failed with exception: {cmp_e}\\\")\\n            traceback.print_exc()\\n            return False\\n\\n        if not close:\\n            yk_f = y_kernel.float()\\n            yr_f = y_ref.float()\\n            abs_diff = (yk_f - yr_f).abs()\\n            rel_diff = abs_diff / (yr_f.abs() + 1e-8)\\n\\n            max_abs = abs_diff.max().item()\\n            max_rel = rel_diff.max().item()\\n            mean_abs = abs_diff.mean().item()\\n\\n            print(\\\"NUMERICAL MISMATCH:\\\")\\n            print(f\\\"  tolerances: rtol={rtol}, atol={atol}\\\")\\n            print(f\\\"  result shape={tuple(y_kernel.shape)}, dtype={y_kernel.dtype}\\\")\\n            print(f\\\"  ref    shape={tuple(y_ref.shape)}, dtype={y_ref.dtype}\\\")\\n            print(f\\\"  max_abs_diff={max_abs}\\\")\\n            print(f\\\"  max_rel_diff={max_rel}\\\")\\n            print(f\\\"  mean_abs_diff={mean_abs}\\\")\\n            print(f\\\"  expected sample: {y_ref.flatten()[:10].float().cpu()}\\\")\\n            print(f\\\"  got      sample: {y_kernel.flatten()[:10].float().cpu()}\\\")\\n            print(f\\\"  Q sample: {Q.flatten()[:10].float().cpu()}\\\")\\n            print(f\\\"  K sample: {K.flatten()[:10].float().cpu()}\\\")\\n            print(f\\\"  V sample: {V.flatten()[:10].float().cpu()}\\\")\\n\\n            # NaN/Inf diagnostics\\n            print(\\n                f\\\"  y_ref NaNs={torch.isnan(y_ref).sum().item()}, Infs={torch.isinf(y_ref).sum().item()}\\\"\\n            )\\n            print(\\n                f\\\"  y_kernel NaNs={torch.isnan(y_kernel).sum().item()}, Infs={torch.isinf(y_kernel).sum().item()}\\\"\\n            )\\n            return False\\n\\n        print(\\\"Test passed: kernel output matches reference within tolerance.\\\")\\n        return True\\n\\n    except Exception as e:\\n        if isinstance(e, NameError):\\n            print(\\n                f\\\"Test failed: NameError (likely undefined helper in kernel.py): {e}\\\"\\n            )\\n        else:\\n            print(f\\\"Test failed: {e}\\\")\\n        traceback.print_exc()\\n        return False\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    success = test_kernel()\\n    sys.exit(0 if success else 1)\\n```\"\n        }\n      ],\n      \"phase\": \"final_answer\",\n      \"role\": \"assistant\"\n    }\n  ],\n  \"parallel_tool_calls\": true,\n  \"presence_penalty\": 0.0,\n  \"previous_response_id\": null,\n  \"prompt_cache_key\": null,\n  \"prompt_cache_retention\": null,\n  \"reasoning\": {\n    \"effort\": \"high\",\n    \"summary\": null\n  },\n  \"safety_identifier\": null,\n  \"service_tier\": \"default\",\n  \"store\": true,\n  \"temperature\": 1.0,\n  \"text\": {\n    \"format\": {\n      \"type\": \"text\"\n    },\n    \"verbosity\": \"medium\"\n  },\n  \"tool_choice\": \"auto\",\n  \"tools\": [],\n  \"top_logp