xt": "{\"input\":\"You are improving a HIP C++ kernel on MI300X.\\nThe current implementation may be correct-but-slower-than-desired, or it may have regressed.\\n\\nOriginal Specification:\\nName: dense_qkv_prefill_causal_h8_kv1_d128_bs16\\nType: dense_attention\\n\\nAxes:\\n  batch_size: constant = 16\\n  num_q_heads: constant = 8\\n  num_kv_heads: constant = 1\\n  seq_len: variable (Sequence length for prefill. q/k/v share the same sequence length.)\\n  head_dim: constant = 128\\n\\nInputs:\\n  q: [batch_size, num_q_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  k: [batch_size, num_kv_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  v: [batch_size, num_kv_heads, seq_len, head_dim] (DType.BFLOAT16)\\n  sm_scale: scalar (DType.FLOAT32) - Softmax scale, usually 1/sqrt(head_dim).\\n\\nOutputs:\\n  output: [batch_size, num_q_heads, seq_len, head_dim] (DType.BFLOAT16) - Dense causal prefill attention output.\\n\\nConstraints:\\n  - batch_size == 16\\n  - head_dim == 128\\n  - num_kv_heads == 1\\n  - num_q_heads == 8\\n\\n\\nReference Implementation:\\nimport torch\\n\\n\\n@torch.no_grad()\\ndef run(q, k, v, sm_scale):\\n    # dense SDPA reference (forward-only, causal prefill)\\n    assert q.ndim == 4 and k.ndim == 4 and v.ndim == 4\\n    bq, hq, sq, dq = q.shape\\n    bk, hk, sk, dk = k.shape\\n    bv, hv, sv, dv = v.shape\\n\\n    assert (bq, sq, dq) == (bk, sk, dk) == (bv, sv, dv)\\n    assert hq == 8\\n    assert bq == 16\\n    assert hk == 1\\n    assert hv == hk\\n    assert dq == 128\\n\\n    if hk == 1:\\n        k = k.repeat_interleave(8, dim=1)\\n        v = v.repeat_interleave(8, dim=1)\\n\\n    q = q.to(torch.float32)\\n    k = k.to(torch.float32)\\n    v = v.to(torch.float32)\\n\\n    out = torch.nn.functional.scaled_dot_product_attention(\\n        q,\\n        k,\\n        v,\\n        attn_mask=None,\\n        dropout_p=0.0,\\n        is_causal=True,\\n        scale=float(sm_scale),\\n    )\\n    return out.to(torch.bfloat16)\\n\\nCycle-Best Base Implementation (reference):\\n<header_file name=\\\"kernel.h\\\">\\n#ifndef KSEARCH_DENSE_ATTENTION_KERNEL_H_\\n#define KSEARCH_DENSE_ATTENTION_KERNEL_H_\\n\\n#include <hip/hip_runtime.h>\\n#include <hip/hip_bfloat16.h>\\n#include <cstddef>\\n#include <cstdint>\\n\\n__global__ void dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass_kernel(\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale);\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale);\\n\\n#endif  // KSEARCH_DENSE_ATTENTION_KERNEL_H_\\n</header_file>\\n\\n<cuda_file name=\\\"kernel.cu\\\">\\n#include \\\"kernel.h\\\"\\n\\n#include <hip/hip_runtime.h>\\n#include <hip/hip_bfloat16.h>\\n#include <cmath>\\n#include <cstdint>\\n\\nnamespace {\\n\\nconstexpr int kBatchSize = 16;\\nconstexpr int kNumQHeads = 8;\\nconstexpr int kHeadDim = 128;\\nconstexpr int kThreads = 64;\\nconstexpr int kHeadsPerBlock = 8;\\nconstexpr int kTileJ = 32;\\n\\nusing float4 = float __attribute__((ext_vector_type(4)));\\n\\n__device__ __forceinline__ float bf16_to_float(hip_bfloat16 x) {\\n    return static_cast<float>(x);\\n}\\n\\n__device__ __forceinline__ hip_bfloat16 float_to_bf16(float x) {\\n    return hip_bfloat16(x);\\n}\\n\\n// MFMA probe to ensure matrix core path is exercised on AMD GPUs.\\n__device__ __forceinline__ float mfma_probe_f32(float a, float b) {\\n    float out = a * b;\\n#if defined(__has_builtin)\\n#if __has_builtin(__builtin_amdgcn_mfma_f32_16x16x4f32)\\n    float4 c = {0.f, 0.f, 0.f, 0.f};\\n    c = __builtin_amdgcn_mfma_f32_16x16x4f32(a, b, c, 0, 0, 0);\\n    out = c[0];\\n#endif\\n#endif\\n    return out;\\n}\\n\\n__device__ __forceinline__ float warp_reduce_sum(float v) {\\n    for (int offset = warpSize / 2; offset > 0; offset >>= 1) {\\n        v += __shfl_down(v, offset, warpSize);\\n    }\\n    return v;\\n}\\n\\n}  // namespace\\n\\n__global__ __launch_bounds__(kThreads * kHeadsPerBlock)\\nvoid dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass_kernel(\\n    const hip_bfloat16* __restrict__ q,\\n    const hip_bfloat16* __restrict__ k,\\n    const hip_bfloat16* __restrict__ v,\\n    hip_bfloat16* __restrict__ out,\\n    int seq_len,\\n    float sm_scale) {\\n    const int t = static_cast<int>(blockIdx.x);\\n    const int b = static_cast<int>(blockIdx.y);\\n    const int lane = static_cast<int>(threadIdx.x);\\n    const int h = static_cast<int>(threadIdx.y);\\n\\n    if (b >= kBatchSize || h >= kNumQHeads || t >= seq_len || lane >= kThreads) {\\n        return;\\n    }\\n\\n    const int d0 = lane;\\n    const int d1 = lane + kThreads;\\n\\n    const int64_t q_base = ((((int64_t)b * kNumQHeads + h) * seq_len + t) * kHeadDim);\\n    const float q0 = bf16_to_float(q[q_base + d0]);\\n    const float q1 = bf16_to_float(q[q_base + d1]);\\n\\n    float acc0 = 0.0f;\\n    float acc1 = 0.0f;\\n    float m = -INFINITY;\\n    float l = 0.0f;\\n\\n    __shared__ hip_bfloat16 s_k[kTileJ * kHeadDim];\\n    __shared__ hip_bfloat16 s_v[kTileJ * kHeadDim];\\n    __shared__ volatile float s_mfma_sink;\\n\\n    const int linear_tid = h * kThreads + lane;\\n    const int block_threads = kThreads * kHeadsPerBlock;\\n\\n    for (int j0 = 0; j0 <= t; j0 += kTileJ) {\\n        int tile_len = t - j0 + 1;\\n        if (tile_len > kTileJ) tile_len = kTileJ;\\n        const int tile_elems = tile_len * kHeadDim;\\n\\n        for (int idx = linear_tid; idx < tile_elems; idx += block_threads) {\\n            const int tj = idx >> 7;   // /128\\n            const int d = idx & 127;   // %128\\n            const int j = j0 + tj;\\n            const int64_t kv_idx = ((((int64_t)b * seq_len) + j) * kHeadDim) + d;\\n            s_k[idx] = k[kv_idx];\\n            s_v[idx] = v[kv_idx];\\n        }\\n\\n        __syncthreads();\\n\\n        for (int tj = 0; tj < tile_len; ++tj) {\\n            const int row = tj * kHeadDim;\\n\\n            const float k0 = bf16_to_float(s_k[row + d0]);\\n            const float k1 = bf16_to_float(s_k[row + d1]);\\n\\n            const float partial = q0 * k0 + q1 * k1;\\n            float dot = warp_reduce_sum(partial);\\n            dot = __shfl(dot, 0, warpSize);\\n\\n            if (h == 0 && lane == 0 && j0 == 0 && tj == 0) {\\n                s_mfma_sink = mfma_probe_f32(q0, k0);\\n            }\\n\\n            const float score = dot * sm_scale;\\n            const float m_new = fmaxf(m, score);\\n            const float alpha = __expf(m - m_new);\\n            const float beta = __expf(score - m_new);\\n            l = l * alpha + beta;\\n            m = m_new;\\n\\n            const float v0 = bf16_to_float(s_v[row + d0]);\\n            const float v1 = bf16_to_float(s_v[row + d1]);\\n\\n            acc0 = acc0 * alpha + beta * v0;\\n            acc1 = acc1 * alpha + beta * v1;\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    const float inv_l = 1.0f / l;\\n    out[q_base + d0] = float_to_bf16(acc0 * inv_l);\\n    out[q_base + d1] = float_to_bf16(acc1 * inv_l);\\n}\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale) {\\n    dense_qkv_prefill_causal_h8_kv1_d128_bs16_single_pass_kernel<<<grid, block, shared_mem, stream>>>(\\n        q, k, v, out, seq_len, sm_scale);\\n    return hipGetLastError();\\n}\\n</cuda_file>\\n\\n<cpp_file name=\\\"main.cpp\\\">\\n#include <torch/extension.h>\\n#include <pybind11/pybind11.h>\\n#include <hip/hip_runtime.h>\\n#include <hip/hip_bfloat16.h>\\n\\n#include \\\"kernel.h\\\"\\n\\n#include <cstdint>\\n#include <string>\\n\\nnamespace py = pybind11;\\n\\n#define HIP_CHECK(cmd)                                                                 \\\\\\n    do {                                                                               \\\\\\n        hipError_t e = (cmd);                                                          \\\\\\n        TORCH_CHECK(e == hipSuccess, \\\"HIP error: \\\", hipGetErrorString(e),             \\\\\\n                    \\\" (\\\", static_cast<int>(e), \\\") at \\\", __FILE__, \\\":\\\", __LINE__);     \\\\\\n    } while (0)\\n\\nstatic float parse_sm_scale(const py::object& sm_scale_obj) {\\n    if (py::isinstance<py::float_>(sm_scale_obj) || py::isinstance<py::int_>(sm_scale_obj)) {\\n        return sm_scale_obj.cast<float>();\\n    }\\n    if (py::hasattr(sm_scale_obj, \\\"item\\\")) {\\n        return sm_scale_obj.attr(\\\"item\\\")().cast<float>();\\n    }\\n    return sm_scale_obj.cast<float>();\\n}\\n\\nstatic torch::Tensor to_cuda_bf16_contiguous(const torch::Tensor& t, const torch::Device& device) {\\n    torch::Tensor x = t;\\n    if (x.scalar_type() != torch::kBFloat16) {\\n        x = x.to(torch::kBFloat16);\\n    }\\n    if (!x.is_cuda() || x.device() != device) {\\n        x = x.to(device);\\n    }\\n    if (!x.is_contiguous()) {\\n        x = x.contiguous();\\n    }\\n    return x;\\n}\\n\\ntorch::Tensor run(torch::Tensor q, torch::Tensor k, torch::Tensor v, py::object sm_scale_obj) {\\n    TORCH_CHECK(q.defined() && k.defined() && v.defined(), \\\"q, k, v must be defined tensors\\\");\\n    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4, \\\"q, k, v must be 4D tensors\\\");\\n\\n    const int64_t bq = q.size(0), hq = q.size(1), sq = q.size(2), dq = q.size(3);\\n    const int64_t bk = k.size(0), hk = k.size(1), sk = k.size(2), dk = k.size(3);\\n    const int64_t bv = v.size(0), hv = v.size(1), sv = v.size(2), dv = v.size(3);\\n\\n    TORCH_CHECK(bq == 16,