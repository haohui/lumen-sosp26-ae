import torch
import torch.nn as nn
import avelang
import avelang.language as al

# ---------------------------------------------------------------------------
# Problem dimensions (fixed by the benchmark)
# ---------------------------------------------------------------------------
BATCH_SIZE = 16
IN_CHANNELS = 3
OUT_CHANNELS = 64
KERNEL_W, KERNEL_H, KERNEL_D = 3, 5, 7
WIDTH, HEIGHT, DEPTH = 64, 64, 64

OUT_W = WIDTH - KERNEL_W + 1   # 62
OUT_H = HEIGHT - KERNEL_H + 1  # 60
OUT_D = DEPTH - KERNEL_D + 1   # 58

K_UNPADDED = IN_CHANNELS * KERNEL_W * KERNEL_H * KERNEL_D  # 315
K_PADDED = ((K_UNPADDED + 15) // 16) * 16                    # 320
M_TOTAL = BATCH_SIZE * OUT_W * OUT_H * OUT_D                 # 3,452,160
N_TOTAL = OUT_CHANNELS                                       # 64

# ---------------------------------------------------------------------------
# GEMM tiling constants
# ---------------------------------------------------------------------------
GROUP_M = 128
GROUP_N = 64
GROUP_K = 16
WARP_SIZE = 64
NUM_WARPS = 4
THREADS = NUM_WARPS * WARP_SIZE       # 256
MMA_M = 32
MMA_N = 32
VEC_ELEMS = 8
BF16_BYTES = 2
ACC_SIZE = 16
WARPS_M = 2
WARPS_N = 2
M_TILES_PER_WARP = GROUP_M // (WARPS_M * MMA_M)  # 2
N_TILES_PER_WARP = GROUP_N // (WARPS_N * MMA_N)  # 1
A_VECS_PER_ROW = GROUP_K // VEC_ELEMS            # 2
B_VECS_PER_ROW = GROUP_K // VEC_ELEMS            # 2
SHM_A_VECS = GROUP_M * A_VECS_PER_ROW            # 256
SHM_B_VECS = GROUP_M * B_VECS_PER_ROW            # 256 (alloc matches SHM_A_VECS for type compat)
SHM_B_VALID = GROUP_N * B_VECS_PER_ROW           # 128 (actual valid rows)
GLOBAL_LOADS_A = (SHM_A_VECS + THREADS - 1) // THREADS  # 1
GLOBAL_LOADS_B = (SHM_B_VALID + THREADS - 1) // THREADS  # 1
ROW_U32 = A_VECS_PER_ROW * 4                     # 8

# im2col launch
IM2COL_THREADS = 256
IM2COL_BLOCKS = 8192

# ---------------------------------------------------------------------------
# Helper: 5D-to-1D index computation (host-side, used for stride setup)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Kernel 1: im2col 3D
#   Flattens each input patch into a row of the (M, K_PAD) matrix.
#   Columns K_UNPADDED .. K_PAD-1 are zero-filled.
# ---------------------------------------------------------------------------
@avelang.jit
def im2col_3d_kernel(
    x_ptr: al.Pointer(al.bf16),
    col_ptr: al.Pointer(al.bf16),
    B_val: al.u32,
    C_val: al.u32,
    W_val: al.u32,
    H_val: al.u32,
    D_val: al.u32,
    KW_val: al.u32,
    KH_val: al.u32,
    KD_val: al.u32,
    OW_val: al.u32,
    OH_val: al.u32,
    OD_val: al.u32,
    K_unpadded: al.u32,
    K_padded: al.u32,
    M_total: al.u32,
):
    tid = al.thread_id(0)
    bid = al.block_id(0)
    block_dim = al.block_dim(0)
    grid_dim = al.grid_dim(0)

    global_tid = bid * block_dim + tid
    total_threads = grid_dim * block_dim

    x_flat = al.make_tensor(x_ptr, al.bf16, al.make_layout((B_val * C_val * D_val * H_val * W_val,), (1,)))
    col_2d = al.make_tensor(col_ptr, al.bf16, al.make_layout((M_total, K_padded), (K_padded, 1)))

    stride_c = D_val * H_val * W_val
    stride_d = H_val * W_val
    stride_h = W_val

    per_batch_od = OD_val
    per_batch_oh = OH_val
    per_plane = OW_val * OH_val

    khw_khd = KH_val * KD_val
    kw_khd = KW_val * KH_val * KD_val

    for row in al.range(global_tid, M_total, total_threads):
        # Decode row -> (b, od, oh, ow)
        b_idx = row // (OD_val * OH_val * OW_val)
        rem = row - b_idx * OD_val * OH_val * OW_val
        od = rem // (OH_val * OW_val)
        rem = rem - od * OH_val * OW_val
        oh = rem // OW_val
        ow = rem - oh * OW_val

        b_off = b_idx * C_val * stride_c
        od_off = od * stride_d
        oh_off = oh * stride_h
        ow_off = ow

        k_idx = al.convert(0, al.u32)
        one = al.convert(1, al.u32)

        for ic in al.range(C_val):
            ic_off = ic * stride_c
            for wk in al.range(KW_val):
                wk_off = wk
                for hk in al.range(KH_val):
                    hk_off = hk * stride_h
                    for dk in al.range(KD_val):
                        dk_off = dk * stride_d
                        g_idx = b_off + ic_off + od_off + oh_off + ow_off + dk_off + hk_off + wk_off
                        col_2d[row, k_idx] = x_flat[g_idx]
                        k_idx = k_idx + one

        zero_bf16 = al.convert(0.0, al.bf16)
        for kk in al.range(K_unpadded, K_padded):
            col_2d[row, kk] = zero_bf16


# ---------------------------------------------------------------------------
# GEMM shared-memory load helpers (adapted from fused-linear-relu example)
# ---------------------------------------------------------------------------
@avelang.jit
def _load_global_a_to_shm(
    shm_a: al.Tensor((SHM_A_VECS, 4), al.u32),
    a_rsrc: al.Tensor((4,), al.u32),
    block_m: al.u32,
    k_base: al.u32,
    k: al.u32,
    tid: al.u32,
):
    zero = al.convert(0, al.u32)
    idx = tid
    for _ in al.range(GLOBAL_LOADS_A):
        if idx < SHM_A_VECS:
            row = idx // A_VECS_PER_ROW
            col_vec = idx - row * A_VECS_PER_ROW
            off = ((block_m * GROUP_M + row) * k + k_base + col_vec * VEC_ELEMS) * BF16_BYTES
            shm_a[idx] = al.amdgpu.raw_buffer_load_x4(a_rsrc, zero, off, 0)
        idx = idx + THREADS


@avelang.jit
def _load_global_b_to_shm(
    shm_b: al.Tensor((SHM_A_VECS, 4), al.u32),
    b_rsrc: al.Tensor((4,), al.u32),
    block_n: al.u32,
    k_base: al.u32,
    k: al.u32,
    tid: al.u32,
):
    zero = al.convert(0, al.u32)
    idx = tid
    for _ in al.range(GLOBAL_LOADS_B):
        if idx < SHM_B_VALID:
            row = idx // B_VECS_PER_ROW
            col_vec = idx - row * B_VECS_PER_ROW
            off = ((block_n * GROUP_N + row) * k + k_base + col_vec * VEC_ELEMS) * BF16_BYTES
            shm_b[idx] = al.amdgpu.raw_buffer_load_x4(b_rsrc, zero, off, 0)
        idx = idx + THREADS


@avelang.jit
def _fetch_mfma_operand_32x32x16(
    ret: al.Tensor((2, 4), al.bf16),
    shm: al.Tensor((SHM_A_VECS, 4), al.u32),
    tile_idx: al.u32,
    lane: al.u32,
):
    ret_u32 = al.view(ret, al.Tensor((4,), al.u32))
    shm_u32 = al.view(shm, al.Tensor((SHM_A_VECS * 4,), al.u32))
    row = tile_idx * MMA_M + (lane % MMA_M)
    k_group_u32 = (lane // MMA_M) * 2
    row_base = row * ROW_U32

    ret_u32[0] = shm_u32[row_base + k_group_u32]
    ret_u32[1] = shm_u32[row_base + k_group_u32 + 1]
    ret_u32[2] = shm_u32[row_base + 4 + k_group_u32]
    ret_u32[3] = shm_u32[row_base + 5 + k_group_u32]


# ---------------------------------------------------------------------------
# Kernel 2: BF16 GEMM (C = A @ B^T)
#   A: (M, K_padded)  row-major
#   B: (N, K_padded)  row-major  → treated as B^T by MFMA
#   C: (M, N)         row-major
# ---------------------------------------------------------------------------
@avelang.jit
def gemm_bf16_kernel(
    a_ptr: al.Pointer(al.bf16),
    b_ptr: al.Pointer(al.bf16),
    c_ptr: al.Pointer(al.bf16),
    M_dim: al.u32,
    N_dim: al.u32,
    K_dim: al.u32,
):
    tid = al.thread_id(0)
    block_n = al.block_id(0)
    block_m = al.block_id(1)
    wid = tid // WARP_SIZE
    lane = tid % WARP_SIZE
    warp_row = wid // WARPS_N
    warp_col = wid % WARPS_N

    a_memref = al.make_tensor(a_ptr, al.bf16, al.make_layout((M_dim * K_dim,), (1,)))
    b_memref = al.make_tensor(b_ptr, al.bf16, al.make_layout((N_dim * K_dim,), (1,)))
    c_out = al.make_tensor(c_ptr, al.bf16, al.make_layout((M_dim, N_dim), (N_dim, 1)))

    a_rsrc = al.amdgpu.make_rsrc(a_memref, M_dim * K_dim * BF16_BYTES)
    b_rsrc = al.amdgpu.make_rsrc(b_memref, N_dim * K_dim * BF16_BYTES)

    shm_a = al.make_shared((SHM_A_VECS, 4), al.u32)
    shm_b = al.make_shared((SHM_A_VECS, 4), al.u32)
    a_reg = al.make_local((M_TILES_PER_WARP, 2, 4), al.bf16)
    b_reg = al.make_local((N_TILES_PER_WARP, 2, 4), al.bf16)
    acc = al.make_local((M_TILES_PER_WARP * N_TILES_PER_WARP, ACC_SIZE), al.f32)

    for i in al.range(M_TILES_PER_WARP * N_TILES_PER_WARP):
        for j in al.range(ACC_SIZE):
            acc[i, j] = al.convert(0.0, al.f32)

    k_tiles = K_dim // GROUP_K
    for kt in al.range(k_tiles):
        k_base = kt * GROUP_K
        _load_global_a_to_shm(shm_a, a_rsrc, block_m, k_base, K_dim, tid)
        _load_global_b_to_shm(shm_b, b_rsrc, block_n, k_base, K_dim, tid)
        al.syncthreads()

        for i in al.range(M_TILES_PER_WARP):
            _fetch_mfma_operand_32x32x16(a_reg[i], shm_a, warp_row * M_TILES_PER_WARP + i, lane)
        for j in al.range(N_TILES_PER_WARP):
            _fetch_mfma_operand_32x32x16(b_reg[j], shm_b, warp_col * N_TILES_PER_WARP + j, lane)

        for i in al.range(M_TILES_PER_WARP):
            for j in al.range(N_TILES_PER_WARP):
                acc_idx = i * N_TILES_PER_WARP + j
                acc[acc_idx] = al.amdgpu.mfma_32x32x8_bf16_f32(a_reg[i, 0], b_reg[j, 0], acc[acc_idx])
                acc[acc_idx] = al.amdgpu.mfma_32x32x8_bf16_f32(a_reg[i, 1], b_reg[j, 1], acc[acc_idx])

        al.syncthreads()

    lane_group = lane // MMA_N
    lane_col = lane % MMA_N
    block_row_base = block_m * GROUP_M
    block_col_base = block_n * GROUP_N

    for j in al.range(N_TILES_PER_WARP):
        col = block_col_base + (warp_col * N_TILES_PER_WARP + j) * MMA_N + lane_col
        for i in al.range(M_TILES_PER_WARP):
            acc_idx = i * N_TILES_PER_WARP + j
            row_base = block_row_base + (warp_row * M_TILES_PER_WARP + i) * MMA_M
            for t in al.range(ACC_SIZE):
                row = row_base + (t // 4) * 8 + lane_group * 4 + (t % 4)
                c_out[row, col] = al.convert(acc[acc_idx, t], al.bf16)


# ---------------------------------------------------------------------------
# Host wrapper: orchestrates im2col + GEMM
# ---------------------------------------------------------------------------
def conv3d_avelang_bf16(
    x: torch.Tensor,
    weight: torch.Tensor,
) -> torch.Tensor:
    if not torch.cuda.is_available():
        raise RuntimeError("CUDA/HIP device is required for AveLang kernels.")

    # Validate shapes
    B, C, W, H, D = x.shape
    OC, IC, KW, KH, KD = weight.shape
    assert C == IC, f"Input channels mismatch: {C} vs {IC}"
    assert B == BATCH_SIZE and C == IN_CHANNELS and OC == OUT_CHANNELS
    assert W == WIDTH and H == HEIGHT and D == DEPTH
    assert KW == KERNEL_W and KH == KERNEL_H and KD == KERNEL_D

    # Convert to BF16 contiguous
    x_bf16 = x.contiguous().to(dtype=torch.bfloat16)
    w_bf16 = weight.contiguous().to(dtype=torch.bfloat16)

    # Reshape weight from (OC, IC, KW, KH, KD) to (OC, IC*KW*KH*KD)
    w_2d = w_bf16.reshape(OC, K_UNPADDED).contiguous()
    # Pad K dimension to K_PADDED with zeros
    w_padded = torch.nn.functional.pad(w_2d, (0, K_PADDED - K_UNPADDED))

    # im2col buffer: (M_TOTAL, K_PADDED)
    col_buf = torch.empty((M_TOTAL, K_PADDED), dtype=torch.bfloat16, device=x.device)

    # Output buffer: (M_TOTAL, N_TOTAL) → reshape later
    out_flat = torch.empty((M_TOTAL, N_TOTAL), dtype=torch.bfloat16, device=x.device)

    # --- im2col ---
    im2col_grid = (IM2COL_BLOCKS, 1, 1)
    im2col_block = (IM2COL_THREADS, 1, 1)
    im2col_3d_kernel[lambda: (im2col_grid, im2col_block)](
        x_bf16, col_buf,
        BATCH_SIZE, IN_CHANNELS, WIDTH, HEIGHT, DEPTH,
        KERNEL_W, KERNEL_H, KERNEL_D,
        OUT_W, OUT_H, OUT_D,
        K_UNPADDED, K_PADDED, M_TOTAL,
    )

    # --- GEMM ---
    grid_m = M_TOTAL // GROUP_M   # 26970
    grid_n = N_TOTAL // GROUP_N   # 1
    gemm_grid = (grid_n, grid_m, 1)
    gemm_block = (THREADS, 1, 1)
    gemm_bf16_kernel[lambda: (gemm_grid, gemm_block)](
        col_buf, w_padded, out_flat,
        M_TOTAL, N_TOTAL, K_PADDED,
    )

    # Reshape output: (M_TOTAL, N_TOTAL) -> (B, OC, OW, OH, OD)
    out = out_flat.reshape(BATCH_SIZE, OUT_CHANNELS, OUT_W, OUT_H, OUT_D)
    return out.contiguous()


# ---------------------------------------------------------------------------
# ModelNew: matches the reference Model interface
# ---------------------------------------------------------------------------
class ModelNew(nn.Module):
    """
    Optimized 3D convolution using im2col + BF16 MFMA GEMM in AveLang DSL.
    """
    def __init__(self, in_channels: int, out_channels: int, kernel_size: tuple, stride: int = 1, padding: int = 0, dilation: int = 1, groups: int = 1, bias: bool = False):
        super(ModelNew, self).__init__()
        # Keep a standard Conv3d for proper weight initialization
        self.conv3d = nn.Conv3d(in_channels, out_channels, kernel_size, stride=stride, padding=padding, dilation=dilation, groups=groups, bias=bias)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        weight = self.conv3d.weight.data
        return conv3d_avelang_bf16(x, weight)


# ---------------------------------------------------------------------------
# Test code and required interface functions
# ---------------------------------------------------------------------------
batch_size = 16
in_channels = 3
out_channels = 64
kernel_size = (3, 5, 7)
width = 64
height = 64
depth = 64

def get_inputs():
    x = torch.rand(batch_size, in_channels, width, height, depth)
    return [x]

def get_init_inputs():
    return [in_channels, out_channels, kernel_size]
