bq), 1);\\n  dim3 block(512, 1, 1);\\n\\n  hipError_t launch_err = ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16(\\n      grid,\\n      block,\\n      0,\\n      nullptr,\\n      q_ptr,\\n      k_ptr,\\n      v_ptr,\\n      out_ptr,\\n      static_cast<int>(sq),\\n      static_cast<float>(sm_scale));\\n\\n  TORCH_CHECK(launch_err == hipSuccess, \\\"Kernel launch failed: \\\", hipGetErrorString(launch_err));\\n\\n  if (q_was_cuda) {\\n    return out_dev;\\n  }\\n  return out_dev.to(torch::TensorOptions().device(torch::kCPU).dtype(torch::kBFloat16));\\n}\\n\\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\\n  m.def(\\\"run\\\", &run, py::arg(\\\"q\\\"), py::arg(\\\"k\\\"), py::arg(\\\"v\\\"), py::arg(\\\"sm_scale\\\"));\\n}\\n</cpp_file>\\n\\nCurrent Implementation (improve THIS code; keep it aligned with the base):\\n<header_file name=\\\"kernel.h\\\">\\n#ifndef KSEARCH_KERNEL_H_\\n#define KSEARCH_KERNEL_H_\\n\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\n#include <cstddef>\\n#include <cstdint>\\n\\n__global__ void dense_qkv_prefill_causal_h8_kv1_d128_bs16_kernel(\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale);\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale);\\n\\n#endif  // KSEARCH_KERNEL_H_\\n</header_file>\\n\\n<cuda_file name=\\\"kernel.cu\\\">\\n#include \\\"kernel.h\\\"\\n\\n#include <hip/hip_bfloat16.h>\\n#include <hip/hip_runtime.h>\\n\\n#include <cmath>\\n#include <cstdint>\\n\\n#ifndef __has_builtin\\n#define __has_builtin(x) 0\\n#endif\\n\\nnamespace {\\nconstexpr int kBatchSize = 16;\\nconstexpr int kNumQHeads = 8;\\nconstexpr int kHeadDim = 128;\\nconstexpr int 