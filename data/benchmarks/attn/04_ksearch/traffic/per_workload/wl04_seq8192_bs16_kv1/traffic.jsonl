1;\\n  (void)b0;\\n  (void)b1;\\n  return 0.0f;\\n#endif\\n}\\n\\n}  // namespace\\n\\n__global__ __launch_bounds__(kThreadsPerBlock, 2) void dense_qkv_prefill_causal_h8_kv1_d128_bs16_kernel(\\n    const hip_bfloat16* __restrict__ q,\\n    const hip_bfloat16* __restrict__ k,\\n    const hip_bfloat16* __restrict__ v,\\n    hip_bfloat16* __restrict__ out,\\n    int seq_len,\\n    float sm_scale) {\\n  const int b = static_cast<int>(blockIdx.y);\\n  const int qi = static_cast<int>(blockIdx.x);\\n\\n  if (b >= kBatchSize || qi >= seq_len) return;\\n\\n  const int tid = static_cast<int>(threadIdx.x);\\n  const int h = tid / kWaveSize;           // 0..7\\n  const int lane = tid & (kWaveSize - 1);  // 0..63\\n\\n  __shared__ __align__(16) ushort2 s_k2[kTilePairs];\\n  __shared__ __align__(16) ushort2 s_v2[kTilePairs];\\n\\n  const int q_base = ((b * kNumQHeads + h) * seq_len + qi) * kHeadDim;\\n  const hip_bfloat16* q_ptr = q + q_base;\\n\\n  const ushort2 qv = reinterpret_cast<const ushort2*>(q_ptr)[lane];\\n  const float q0 = bf16_bits_to_float(static_cast<uint16_t>(qv.x)) * sm_scale;\\n  const float q1 = bf16_bits_to_float(static_cast<uint16_t>(qv.y)) * sm_scale;\\n\\n  const int kv_batch_base = b * seq_len * kHeadDim;\\n  const ushort2* k_batch2 = reinterpret_cast<const ushort2*>(k + kv_batch_base);\\n  const ushort2* v_batch2 = reinterpret_cast<const ushort2*>(v + kv_batch_base);\\n\\n  float acc0 = 0.0f;\\n  float acc1 = 0.0f;\\n\\n  float m = -INFINITY;  // lane0 state for each wave\\n  float l = 0.0f;       // lane0 state for each wave\\n\\n  float mfma_sink = 0.0f;\\n  const int max_k = qi + 1;\\n\\n  int tile_start = 0;\\n\\n#define KSEARCH_PROCESS_STEP()                                                       \\\\\\n  do {                                                                               \\\\\\n    const ushort2 kv = k_row2[lane];                                                 \\\\\\n    const float k0 = bf16_bits_to_float(static_cast<uint16_t>(kv.x))