n            __syncthreads();\\n            __syncthreads();\\n            continue;\\n        }\\n\\n        const int w1_expert_base = e * twoI * D;\\n        const int fc1_expert_base = e * fc1_stride;\\n\\n        for (int i = tid; i < I; i += blockDim.x) {\\n            int row_g = i;\\n            int row_u = i + I;\\n\\n            int rowblk_g = row_g / BLOCK_N;\\n            int rowblk_u = row_u / BLOCK_N;\\n\\n            const uint16_t* w1g = w1_q_bf16 + w1_expert_base + row_g * D;\\n            const uint16_t* w1u = w1_q_bf16 + w1_expert_base + row_u * D;\\n\\n            int s1g_base = fc1_expert_base + rowblk_g * D_blocks;\\n            int s1u_base = fc1_expert_base + rowblk_u * D_blocks;\\n\\n            float gate = 0.0f;\\n            float up = 0.0f;\\n\\n            for (int cb = 0; cb < D_blocks; ++cb) {\\n                float sg = fc1_scale[s1g_base + cb];\\n                float su = fc1_scale[s1u_base + cb];\\n                int d0 = cb * BLOCK_K;\\n                #pragma unroll 4\\n                for (int dd = 0; dd < BLOCK_K; ++dd) {\\n                    int d = d0 + dd;\\n                    float xv = x[d];\\n                    gate = fmaf(xv, bf16_to_float(w1g[d]) * sg, gate);\\n                    up   = fmaf(xv, bf16_to_float(w1u[d]) * su, up);\\n                }\\n            }\\n\\n            act[i] = silu_f(gate) * up;\\n        }\\n        __syncthreads();\\n\\n        const int w2_expert_base = e * D * I;\\n        const int fc2_expert_base = e * fc2_stride;\\n\\n        for (int o = tid; o < D; o += blockDim.x) {\\n            int rowblk = o / BLOCK_N;\\n            int s2_base = fc2_expert_base + rowblk * I_blocks;\\n            const uint16_t* w2row = w2_q_bf16 + w2_expert_base + o * I;\\n\\n            float sum = 0.0f;\\n            for (int cb = 0; cb < I_blocks; ++cb) {\\n                float s2 = fc2_scale[s2_base + cb];\\n                int i0 = cb * BLOCK_K;\\n                #pragma unroll 4\\n                for (int ii = 0; ii < BLOCK_K; ++ii) {\\n                    int idx = i0 + ii;\\n                    sum = fmaf(act[idx], bf16_to_float(w2row[idx]) * s2, sum);\\n                }\\n            }\\n\\n            out_sh[o] += sum * rw;\\n        }\\n        __syncthreads();\\n    }\\n\\n    for (int o = tid; o < D; o += blockDim.x) {\\n        out_bf16[out_base + o] = float_to_bf16_rn(out_sh[o]);\\n    }\\n}\\n\\n__global__ __launch_bounds__(256)\\nvoid fused_moe_token_kernel_global_out(\\n    const uint16_t* __restrict__ input_q_bf16,\\n    const uint16_t* __restrict__ w1_q_bf16,\\n    const uint16_t* __restrict__ w2_q_bf16,\\n    const float* __restrict__ topk_weights,\\n    const int32_t* __restrict__ topk_ids,\\n    const float* __restrict__ input_scale,\\n    const float* __restrict__ fc1_scale,\\n    const float* __restrict__ fc2_scale,\\n    float* __restrict__ out_acc,\\n    uint16_t* __restrict__ out_bf16,\\n    int T, int D, int E, int I, int K,\\n    int D_blocks, int I_blocks,\\n    int fc1_stride, int fc2_stride\\n) {\\n    int t = blockIdx.x;\\n    if (t >= T) return;\\n\\n    int tid = threadIdx.x;\\n    int out_base = t * D;\\n    int x_base = t * D;\\n    int route_base = t * K;\\n    int input_scale_base = t * D_blocks;\\n\\n    extern __shared__ float smem[];\\n    float* x = smem;\\n    float* act = smem + D;\\n\\n    for (int o = tid; o < D; o += blockDim.x) out_acc[out_base + o] = 0.0f;\\n\\n    for (int cb = 0; cb < D_blocks; ++cb) {\\n        float s = input_scale[input_scale_base + cb];\\n        int d0 = cb * BLOCK_K;\\n        for (int dd = tid; dd < BLOCK_K; dd += blockDim.x) {\\n            int d = d0 + dd;\\n            x[d] = bf16_to_float(input_q_bf16[x_base + d]) * s;\\n        }\\n    }\\n    __syncthreads();\\n\\n    const int twoI = 2 * I;\\n\\n    for (int k = 0; k < K; ++k) {\\n        int e = topk_ids[route_base + k];\\n        float rw = topk_weights[route_base + k];\\n\\n        if (e < 0 || e >= E || rw == 0.0f) {\\n            __syncthreads();\\n            __syncthreads();\\n            continue;\\n        }\\n\\n        const int w1_expert_base = e * twoI * D;\\n        const int fc1_expert_base = e * fc1_stride;\\n\\n        for (int i = tid; i < I; i += blockDim.x) {\\n            int row_g = i;\\n            int row_u = i + I;\\n\\n            int rowblk_g = row_g / BLOCK_N;\\n            int rowblk_u = row_u / BLOCK_N;\\n\\n            const uint16_t* w1g = w1_q_bf16 + w1_expert_base + row_g * D;\\n            const uint16_t* w1u = w1_q_bf16 + w1_expert_base + row_u * D;\\n\\n            int s1g_base = fc1_expert_base + rowblk_g * D_blocks;\\n            int s1u_base = fc1_expert_base + rowblk_u * D_blocks;\\n\\n            float gate = 0.0f;\\n            float up = 0.0f;\\n\\n            for (int cb = 0; cb < D_blocks; ++cb) {\\n                float sg = fc1_scale[s1g_base + cb];\\n                float su = fc1_scale[s1u_base + cb];\\n                int d0 = cb * BLOCK_K;\\n                #pragma unroll 4\\n                for (int dd = 0; dd < BLOCK_K; ++dd) {\\n                    int d = d0 + dd;\\n                    float xv = x[d];\\n                    gate = fmaf(xv, bf16_to_float(w1g[d]) * sg, gate);\\n                    up   = fmaf(xv, bf16_to_float(w1u[d]) * su, up);\\n                }\\n            }\\n\\n            act[i] = silu_f(gate) * up;\\n        }\\n        __syncthreads();\\n\\n        const int w2_expert_base = e * D * I;\\n        const int fc2_expert_base = e * fc2_stride;\\n\\n        for (int o = tid; o < D; o += blockDim.x) {\\n            int rowblk = o / BLOCK_N;\\n            int s2_base = fc2_expert_base + rowblk * I_blocks;\\n            const uint16_t* w2row = w2_q_bf16 + w2_expert_base + o * I;\\n\\n            float sum = 0.0f;\\n            for (int cb = 0; cb < I_blocks; ++cb) {\\n                float s2 = fc2_scale[s2_base + cb];\\n                int i0 = cb * BLOCK_K;\\n                #pragma unroll 4\\n                for (int