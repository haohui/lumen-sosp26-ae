+def _append_prompt_suffix_to_messages(
+    messages: list[dict[str, Any]], suffix: str
+) -> list[dict[str, Any]]:
+    suffix = str(suffix or "").strip()
+    if not suffix:
+        return messages
+    out = [dict(m) for m in messages]
+    target_idx = None
+    for idx, msg in enumerate(out):
+        if msg.get("role", "user") == "user":
+            target_idx = idx
+    if target_idx is None:
+        out.append({"role": "user", "content": suffix})
+        return out
+    msg = out[target_idx]
+    content = msg.get("content", "")
+    if isinstance(content, str) and suffix not in content:
+        msg["content"] = f"{content.rstrip()}\n\n{suffix}" if content.strip() else suffix
+    return out
+
