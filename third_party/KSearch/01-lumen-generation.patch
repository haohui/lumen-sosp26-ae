+    @staticmethod
+    def _flatten_tensors(obj: Any) -> list[Any]:
+        out: list[Any] = []
+        try:
+            import torch  # type: ignore
+        except Exception:
+            return out
+        if isinstance(obj, torch.Tensor):
+            out.append(obj)
+            return out
+        if isinstance(obj, (list, tuple)):
+            for x in obj:
+                out.extend(FlashInferBenchTask._flatten_tensors(x))
