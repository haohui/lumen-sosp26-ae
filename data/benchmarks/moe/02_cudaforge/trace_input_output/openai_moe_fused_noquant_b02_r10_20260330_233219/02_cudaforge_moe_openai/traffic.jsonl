\\"topk_weights_f32 must be [T, K]\\\");\\n    TORCH_CHECK(topk_ids_i32.dim() == 2, \\\"topk_ids_i32 must be [T, K]\\\");\\n    TORCH_CHECK(input_scale_f32.dim() == 2, \\\"input_scale_f32 must be [T, D/BLOCK_K]\\\");\\n    TORCH_CHECK(fc1_scale_f32.dim() == 2, \\\"fc1_scale_f32 must be [E, ...]\\\");\\n    TORCH_CHECK(fc2_scale_f32.dim() == 2, \\\"fc2_scale_f32 must be [E, ...]\\\");\\n\\n    int64_t T64 = input_q_bf16.size(0);\\n    int64_t D64 = input_q_bf16.size(1);\\n    int64_t E64 = w1_q_bf16.size(0);\\n    int64_t twoI64 = w1_q_bf16.size(1);\\n    int64_t D_w1_64 = w1_q_bf16.size(2);\\n\\n    int64_t E2_64 = w2_q_bf16.size(0);\\n    int64_t D_w2_64 = w2_q_bf16.size(1);\\n    int64_t I64 = w2_q_bf16.size(2);\\n\\n    int64_t K64 = topk_ids_i32.size(1);\\n\\n    TORCH_CHECK(D64 == D_w1_64, \\\"w1_q_bf16 last dim mismatch with input D\\\");\\n    TORCH_CHECK(E64 == E2_64, \\\"expert count mismatch between w1 and w2\\\");\\n    TORCH_CHECK(D64 == D_w2_64, \\\"w2_q_bf16 middle dim mismatch with input D\\\");\\n    TORCH_CHECK(twoI64 == 2 * I64, \\\"w1_q_bf16 second dim must equal 2*I\\\");\\n\\n    TORCH_CHECK(topk_weights_f32.size(0) == T64 && topk_weights_f32.size(1) == K64, \\\"topk_weights shape mismatch\\\");\\n    TORCH_CHECK(topk_ids_i32.size(0) == T64, \\\"topk_ids shape mismatch\\\");\\n\\n    TORCH_CHECK((D64 % BLOCK_K) == 0 && (D64 % BLOCK_N) == 0, \\\"D must be divisible by 128\\\");\\n    TORCH_CHECK((I64 % BLOCK_K) == 0, \\\"I must be divisible by 128\\\");\\n    TORCH_CHECK((twoI64 % BLOCK_N) == 0, \\\"2I must be divisible by 128\\\");\\n\\n    int D_blocks = static_cast<int>(D64 / BLOCK_K);\\n    int I_blocks = static_cast<int>(I64 / BLOCK_K);\\n\\n    int fc1_stride = static_cast<int>((twoI64 / BLOCK_N) * D_blocks);\\n    int fc2_stride = static_cast<int>((D64 / BLOCK_N) * I_blocks);\\n\\n    TORCH_CHECK(input_scale_f32.size(0) == T64 && input_scale_f32.size(1) == D_blocks, \\\"input_scale shape mismatch\\\");\\n    TORCH_CHECK(fc1_scale_f32.size(0) == E64 && fc1_scale_f32.size(1) == fc1_stride, \\\"fc1_scale shape mismatch\\\");\\n    TORCH_CHECK(fc2_scale_f32.size(0) == E64 && fc2_scale_f32.size(1) == fc2_stride, \\\"fc2_scale shape mismatch\\\");\\n\\n    int T = static_cast<int>(T64);\\n    int D = static_cast<int>(D64);\\n    int E = static_cast<int>(E64);\\n    int I = static_cast<int>(I64);\\n    int K = static_cast<int>(K64);\\n\\n    size_t smem_x_act = static_cast<size_t>(D + I) * sizeof(float);\\n    TORCH_CHECK(smem_x_act <= 64 * 1024, \\\"shared memory requirement exceeds 64KB\\\");\\n\\n    auto out_bf16 = torch::empty({T64, D64}, input_q_bf16.options().dtype(torch::kBFloat16));\\n\\n    const uint16_t* input_ptr = reinterpret_cast<const uint16_t*>(input_q_bf16.data_ptr<at::BFloat16>());\\n    const uint16_t* w1_ptr = reinterpret_cast<const uint16_t*>(w1_q_bf16.data_ptr<at::BFloat16>());\\n    const uint16_t* w2_ptr = reinterpret_cast<const uint16_t*>(w2_q_bf16.data_ptr<at::BFloat16>());\\n    uint16_t* out_ptr = reinterpret_cast<uint16_t*>(out_bf16.data_ptr<at::BFloat16>());\\n\\n    int threads = 256;\\n\\n    if (T > 0) {\\n        bool can_reg_out = (D <= threads * MAX_REG_OUT);\\n        size_t smem_smemout = static_cast<size_t>(2 * D + I) * sizeof(float);\\n\\n        if (can_reg_out) {\\n            switch (K) {\\n                case 1:\\n                    hipLaunchKernelGGL(\\n                        (fused_moe_token_kernel_reg_out_kfixed<1>),\\n                        dim3(T), dim3(threads), smem_x_act, 0,\\n                        input_ptr, w1_ptr, w2_ptr,\\n                        topk_weights_f32.data_ptr<float>(),\\n                        topk_ids_i32.data_ptr<int32_t>(),\\n                        input_scale_f32.data_ptr<float>(),\\n                        fc1_scale_f32.data_ptr<float>(),\\n                        fc2_scale_f32.data_ptr<float>(),\\n                        out_ptr,\\n                        T, D, E, I,\\n                        D_blocks, I_blocks,\\n          