ude <hip/hip_runtime.h>\\n#include <cstdint>\\n\\nconstexpr int BLOCK_M = 32;\\nconstexpr int BLOCK_N = 32;\\nconstexpr int BLOCK_K = 32;\\nconstexpr int THREADS_X = 16;\\nconstexpr int THREADS_Y = 16;\\n\\n__device__ __forceinline__ float bf16_to_float(uint16_t x) {\\n    union {\\n        uint32_t u;\\n        float f;\\n    } v;\\n    v.u = static_cast<uint32_t>(x) << 16;\\n    return v.f;\\n}\\n\\n__device__ __forceinline__ uint16_t float_to_bf16_rn(float x) {\\n    union {\\n        uint32_t u;\\n        float f;\\n    } v;\\n    v.f = x;\\n    uint32_t u = v.u;\\n    const uint32_t lsb = (u >> 16) & 1u;\\n    u += 0x7FFFu + lsb;\\n    return static_cast<uint16_t>(u >> 16);\\n}\\n\\n__global__ __launch_bounds__(256) void bf16_gemm_tiled_fp32_smem_kernel(\\n    const uint16_t* __restrict__ A,\\n    const uint16_t* __restrict__ B,\\n    uint16_t* __restrict__ C,\\n    int N, int K, int M\\n) {\\n    // Optimization: stage BF16 tiles as FP32 in LDS to remove BF16->FP32 conversion\\n    // from the inner MAC loop.\\n    __shared__ float As[BLOCK_M][BLOCK_K + 1];\\n    __shared__ float Bs[BLOCK_K][BLOCK_N + 1];\\n\\n    const int tx = threadIdx.x;\\n    const int ty = threadIdx.y;\\n    const int tid = ty * THREADS_X + tx;\\n\\n    const int block_row = blockIdx.y * BLOCK_M;\\n    const int block_col = blockIdx.x * BLOCK_N;\\n\\n    const int row0 = block_row + ty;\\n    const int row1 = row0 + THREADS_Y;\\n    const int col0 = block_col + tx;\\n    const int col1 = col0 + THREADS_X;\\n\\n    float acc00 = 0.0f, acc01 = 0.0f, acc10 = 0.0f, acc11 = 0.0f;\\n\\n    const bool block_row_in = (block_row + BLOCK_M - 1) < N;\\n    const bool block_col_in = (block_col + BLOCK_N - 1) < M;\\n\\n    for (int t = 0; t < K; t += BLOCK_K) {\\n        const bool k_in = (t + BLOCK_K - 1) < K;\\n        const bool a_full = block_row_in && k_in;\\n        const bool b_full = block_col_in && k_in;\\n\\n        #pragma unroll\\n        for (int i = 0; i < 4; ++i) {\\n            const 