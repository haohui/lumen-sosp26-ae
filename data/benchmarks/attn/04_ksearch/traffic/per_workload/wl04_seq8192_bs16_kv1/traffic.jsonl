onst int tid = static_cast<int>(threadIdx.x);\\n  const int h = tid / kWaveSize;           // 0..7\\n  const int lane = tid & (kWaveSize - 1);  // 0..63\\n\\n  const int d0 = lane * 2;\\n  const int d1 = d0 + 1;\\n\\n  __shared__ __align__(16) ushort2 s_k2[kTileK * kHeadDimPairs];\\n  __shared__ __align__(16) ushort2 s_v2[kTileK * kHeadDimPairs];\\n\\n  const int q_base = ((b * kNumQHeads + h) * seq_len + qi) * kHeadDim;\\n  const hip_bfloat16* q_ptr = q + q_base;\\n\\n  const ushort2* q_ptr2 = reinterpret_cast<const ushort2*>(q_ptr);\\n  const ushort2 qv = q_ptr2[lane];\\n  const float q0 = bf16_bits_to_float(static_cast<uint16_t>(qv.x)) * sm_scale;\\n  const float q1 = bf16_bits_to_float(static_cast<uint16_t>(qv.y)) * sm_scale;\\n\\n  const int kv_batch_base = b * seq_len * kHeadDim;\\n  const hip_bfloat16* k_batch_ptr = k + kv_batch_base;\\n  const hip_bfloat16* v_batch_ptr = v + kv_batch_base;\\n  const ushort2* k_batch2 = reinterpret_cast<const ushort2*>(k_batch_ptr);\\n  const ushort2* v_batch2 = reinterpret_cast<const ushort2*>(v_batch_ptr);\\n\\n  float acc0 = 0.0f;\\n  float acc1 = 0.0f;\\n\\n  float m = 0.0f;  // valid in lane0 per wave\\n  float l = 0.0f;  // valid in lane0 per wave\\n  bool have_state = false;\\n\\n  float mfma_sink = 0.0f;\\n  const int max_k = qi + 1;\\n\\n  for (int tile_start = 0; tile_start < max_k; tile_start += kTileK) {\\n    int tile_len = max_k - tile_start;\\n    if (tile_len > kTileK) tile_len = kTileK;\\n\\n    const int total_pairs = tile_len * kHeadDimPairs;\\n    const int src_pair_base = tile_start * kHeadDimPairs;\\n\\n    for (int idx = tid; idx < total_pairs; idx += kThreadsPerBlock) {\\n      const int src_idx = src_pair_base + idx;\\n      s_k2[idx] = k_batch2[src_idx];\\n      s_v2[idx] = v_batch2[src_idx];\\n    }\\n    __syncthreads();\\n\\n    if (tid == 0 && tile_start == 0 && tile_len > 0) {\\n      hip_bfloat16 sk0;\\n      hip_bfloat16 sk1;\\n      sk0.data = static_cast<uint16_t>(s_k2[0].x);\\n      sk1.data = static_cast<uint16_t>(s_k2[0].y);\\n      mfma_sink = maybe_mfma_probe_bf16(q_ptr[0], q_ptr[1], sk0, sk1);\\n    }\\n\\n    const ushort2* k_row2 = s_k2;\\n    const ushort2* v_row2 = s_v2;\\n    for (int tk = 0; tk < tile_len; ++tk) {\\n      const ushort2 kv = k_row2[lane];\\n      const float k0 = bf16_bits_to_float(static_cast<uint16_t>(kv.x));\\n      const float k1 = bf16_bits_to_float(static_cast<uint16_t>(kv.y));\\n      const float partial = fmaf(q0, k0, q1 * k1);\\n      const float score = warp_allreduce_sum(partial);\\n\\n      const ushort2 vv = v_row2[lane];\\n      const float vv0 = bf16_bits_to_float(static_cast<uint16_t>(vv.x));\\n      const float vv1 = bf16_bits_to_float(static_cast<uint16_t>(vv.y));\\n\\n      float alpha = 0.0f;\\n      float beta = 0.0f;\\n      if (lane == 0) {\\n        if (!have_state) {\\n          m = score;\\n          l = 1.0f;\\n          alpha = 0.0f;\\n          beta = 1.0f;\\n          have_state = true;\\n        } else if (score <= m) {\\n          alpha = 1.0f;\\n          beta = fast_exp(score - m);\\n          l += beta;\\n        } else {\\n          alpha = fast_exp(m - score);\\n          beta = 1.0f;\\n          l = l * alpha + 1.0f;\\n          m = score;\\n        }\\n      }\\n\\n      alpha = __shfl(alpha, 0);\\n      beta = __shfl(beta, 0);\\n\\n      acc0 = fmaf(beta, vv0, acc0 * alpha);\\n      acc1 = fmaf(beta, vv1, acc1 * alpha);\\n\\n      k_row2 += kHeadDimPairs;\\n      v_row2 += kHeadDimPairs;\\n    }\\n    __syncthreads();\\n  }\\n\\n  float inv_l = 0.0f;\\n  if (lane == 0) {\\n    inv_l = (have_state && l > 0.0f) ? (1.0f / l) : 0.0f;\\n  }\\n  inv_l = __shfl(inv_l, 0);\\n\\n  if (mfma_sink > 1.0e30f) {\\n    inv_l += mfma_sink * 0.0f;\\n  }\\n\\n  hip_bfloat16* out_ptr = out + q_base;\\n  ushort2 outv;\\n  outv.x = float_to_bf16_bits_rn(acc0 * inv_l);\\n  outv.y = float_to_bf16_bits_rn(acc1 * inv_l);\\n  reinterpret_cast<ushort2*>(out_ptr)[lane] = outv;\\n}\\n\\nhipError_t ksearch_launch_dense_qkv_prefill_causal_h8_kv1_d128_bs16(\\n    dim3 grid,\\n    dim3 block,\\n    size_t shared_mem,\\n    hipStream_t stream,\\n    const hip_bfloat16* q,\\n    const hip_bfloat16* k,\\n    const hip_bfloat16* v,\\n    hip_bfloat16* out,\\n    int seq_len,\\n    float sm_scale) {\\n  dense_qkv_prefill_causal_h8_kv1_d128_bs16_kernel<<<grid, block, shared_mem, stream>>>(\\n      q, k, v, out, seq_len, sm_scale);\\n  return hipGetLastError();\\n}\\n</cuda_file>\\n\\n<cpp_file name=\\\"main.cpp\\\">\\n#include <torch/extension.h>\\n#include <pybind11/pybind11.h>\\n#include <hip/hip_runtime.h>\\n\\n#include <cstdint>\\n#include <string>\\n\\n#include \\\"kernel.h\\\"\\n\\nnamespace py = pybind11;\\n\\ntorch::Tensor run(torch::Tensor q, torch::Tensor k, torch::Tensor v, double sm_scale) {\\n  TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4, \\\"q/k/v must be rank-4 tensors\\\");\\n\\n  const int64_t bq = q.size(0), hq = q.size(1), sq = q.size(2), dq = q.size(3);\\n  const int64_t bk = k.size(0), hk = k.size(1), sk = k.size(2), dk = k.size(3);\\n  const int64_t bv = v.size(0), hv = v.size(1), sv = v.size(2), dv = v.size(3);\\n\\n  TORCH_CHECK(bq == 16, \\\"batch_size must be 16\\\");\\n  TORCH_CHECK(hq == 8, \\\"num_q_heads must be 8\\\");\\n  TORCH_CHECK(hk == 1 && hv == 1, \\\"num_kv_heads must be 1\\\");\\n  TORCH_CHECK(dq == 128 && dk == 128 && dv == 128, \\\"head_dim must be 128\\\");\\n  TORCH_CHECK(bq == bk && bk == bv, \\\"batch sizes must match\\\");\\n  TORCH_CHECK(sq == sk && sk == sv, \\\"sequence lengths must match\\\");\\n  TORCH_CHECK(dq == dk && dk == dv, \\\"head dims must match\\\");\\n\\n  const bool q_was_cuda = q.is_cuda();\\n\\n  if (sq == 0) {\\n    auto opts = q.options().dtype(torch::kBFloat16);\\n    if (!q_was_cuda) {\\n      opts = opts.device(torch::kCPU);\\n    }\\n    return torch::empty({bq, hq, sq, dq}, opts);\\n  }\\n\\n  int device_count = 0;\\n  hipError_t devcnt_err = hipGetDeviceCount(&device_count);\\n  TORCH_CHECK(devcnt_e