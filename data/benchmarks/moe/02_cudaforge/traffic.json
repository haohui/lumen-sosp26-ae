hip/HIPException.h>\\n#define DEVICE_GUARD c10::hip::HIPGuard\\n#define GET_STREAM(idx) at::hip::getCurrentHIPStream(idx)\\n#define KERNEL_LAUNCH_CHECK() C10_HIP_KERNEL_LAUNCH_CHECK()\\n#else\\n#include <cuda_runtime.h>\\n#include <ATen/cuda/CUDAContext.h>\\n#include <c10/cuda/CUDAGuard.h>\\n#include <c10/cuda/CUDAException.h>\\n#define DEVICE_GUARD c10::cuda::CUDAGuard\\n#define GET_STREAM(idx) at::cuda::getCurrentCUDAStream(idx)\\n#define KERNEL_LAUNCH_CHECK() C10_CUDA_KERNEL_LAUNCH_CHECK()\\n#endif\\n\\nnamespace {\\n\\nconstexpr int BLOCK_Q = 128;\\nconstexpr int THREADS = 128;  // latency-tuned for CDNA3 wave64 scheduling\\nconstexpr int FC1_ROWS_PER_THREAD = 2;\\nconstexpr int FC2_ROWS_PER_THREAD = 2;\\n\\n__device__ __forceinline__ float fp8_e4m3fnuz_to_float_fast(uint8_t v) {\\n    const uint32_t sign = (uint32_t)(v & 0x80u) << 24;\\n    const uint32_t exp  = ((uint32_t)v >> 3) & 0x0Fu;\\n    const uint32_t man  = (uint32_t)(v & 0x07u);\\n\\n    if (exp != 0u) {\\n        union { uint32_t u; float f; } cvt;\\n        cvt.u = sign | ((exp + 119u) << 23) | (man << 20);\\n        return cvt.f;\\n    } else {\\n        float out = (float)man * 0.0009765625f;\\n        if (sign) out = -out;\\n        return out;\\n    }\\n}\\n\\n__device__ __forceinline__ float silu_f32(float x) {\\n    return x / (1.0f + expf(-x));\\n}\\n\\n__device__ __forceinline__ uint16_t float_to_bf16_bits(float x) {\\n    union { float f; uint32_t u; } v;\\n    v.f = x;\\n    uint32_t lsb = (v.u >> 16) & 1u;\\n    v.u += 0x7FFFu + lsb;\\n    return (uint16_t)(v.u >> 16);\\n}\\n\\ntemplate <bool CACHE_INPUT, typename index_t>\\n__global__ __launch_bounds__(THREADS, 2) void fused_moe_kernel_opt(\\n    const uint8_t* __restrict__ input_q,      // [T, D]\\n    const uint8_t* __restrict__ w1_q,         // [E, 2I, D]\\n    const uint8_t* __restrict__ w2_q,         // [E, D, I]\\n    const float* __restrict__ topk_weights,   // [T, K]\\n    const index_t* __restrict__ topk_ids,     // [T, K]\\n  