ckIdx.x;\\n    if (t >= tokens) return;\\n    const int tid = (int)threadIdx.x;\\n\\n    extern __shared__ float smem[];\\n    float* out_accum = smem;          // [dim]\\n    float* activated = smem + dim;    // [inter_dim]\\n\\n    for (int o = tid; o < dim; o += blockDim.x) {\\n        out_accum[o] = 0.0f;\\n    }\\n    __syncthreads();\\n\\n    const int dim_blocks = dim / BLOCK_Q;\\n    const int fc1_row_blocks = (2 * inter_dim) / BLOCK_Q;\\n    const int fc1_scale_stride = fc1_row_blocks * dim_blocks;\\n\\n    const int fc2_row_blocks = dim / BLOCK_Q;\\n    const int fc2_col_blocks = inter_dim / BLOCK_Q;\\n    const int fc2_scale_stride = fc2_row_blocks * fc2_col_blocks;\\n\\n    const int64_t input_base = (int64_t)t * (int64_t)dim;\\n    const int64_t topk_base = (int64_t)t * (int64_t)topk;\\n    const int64_t in_scale_base = (int64_t)t * (int64_t)dim_blocks;\\n\\n    const uint8_t* x_ptr = input_q + input_base;\\n    const float* in_s_ptr = input_scale + in_scale_base;\\n\\n    for (int k = 0; k < topk; ++k) {\\n        const int64_t e_raw = (int64_t)topk_ids[topk_base + k];\\n        const int e = (int)e_raw;\\n        const float rw = topk_weights[topk_base + k];\\n        const bool active = ((unsigned)e < (unsigned)experts) && (rw != 0.0f);\\n\\n        if (active) {\\n            const int64_t w1_e_base = (int64_t)e * (int64_t)(2 * inter_dim) * (int64_t)dim;\\n            const float* fc1_e = fc1_scale + (int64_t)e * (int64_t)fc1_scale_stride;\\n\\n            for (int base_i = tid; base_i < inter_dim; base_i += blockDim.x * FC1_ROWS_PER_THREAD) {\\n                const int i0 = base_i;\\n                const int i1 = base_i + blockDim.x;\\n                const bool v0 = (i0 < inter_dim);\\n                const bool v1 = (i1 < inter_dim);\\n\\n                float gate0 = 0.0f, up0 = 0.0f;\\n                float gate1 = 0.0f, up1 = 0.0f;\\n\\n                int rb_g0 = 0, rb_u0 = 0, rb_g1 = 0, rb_u1 = 0;\\n                int rb_g0_off = 0, rb_u0_off = 0, rb_g1_off = 0, rb_u1_off = 0;\\n                int64_t row_g0_base = 0, row_u0_base = 0, row_g1_base = 0, row_u1_base = 0;\\n\\n                if (v0) {\\n                    const int row_g0 = i0;\\n                    const int row_u0 = i0 + inter_dim;\\n                    rb_g0 = row_g0 >> 7;\\n                    rb_u0 = row_u0 >> 7;\\n                    rb_g0_off = rb_g0 * dim_blocks;\\n                    rb_u0_off = rb_u0 * dim_blocks;\\n                    row_g0_base = w1_e_base + (int64_t)row_g0 * (int64_t)dim;\\n                    row_u0_base = w1_e_base + (int64_t)row_u0 * (int64_t)dim;\\n                }\\n                if (v1) {\\n                    const int row_g1 = i1;\\n                    const int row_u1 = i1 + inter_dim;\\n                    rb_g1 = row_g1 >> 7;\\n                    rb_u1 = row_u1 >> 7;\\n                    rb_g1_off = rb_g1 * dim_blocks;\\n                    rb_u1_off = rb_u1 * dim_blocks;\\n                    row_g1_base = w1_e_base + (int64_t)row_g1 * (int64_t)dim;\\n                    row_u1_base = w1_e_base + (int64_t)row_u1 * (int64_t)dim;\\n                }\\n\\n                for (int d = 0; d < dim; ++d) {\\n                    const int cb = d >> 7;\\n                    const float xs = fp8_e4m3fnuz_to_float(x_ptr[d]) * in_s_ptr[cb];\\n\\n                    if (v0) {\\n                        const float sg = fc1_e[rb_g0_off + cb];\\n                        const float su = fc1_e[rb_u0_off + cb];\\n                        const float wg = fp8_e4m3fnuz_to_float(w1_q[row_g0_base + d]) * sg;\\n                        const float wu = fp8_e4m3fnuz_to_float(w1_q[row_u0_base + d]) * su;\\n                        gate0 += xs * wg;\\n                        up0 += xs * wu;\\n                    }\\n                    if (v1) {\\n                        const float sg = fc1_e[rb_g1_off + cb];\\n                        const float su = fc1_e[rb_u1_off + cb];\\n                        const float wg = fp8_e4m3fnuz_to_float(w1_q[row_g1_base + d]) * sg;\\n                        const float wu = fp8_e4m3fnuz_to_float(w1_q[row_u1_base + d]) * su;\\n                        gate1 += xs * wg;\\n                        up1 += xs * wu;\\n                    }\\n                }\\n\\n                if (v0) activated[i0] = silu_f32(gate0) * up0;\\n                if (v1) activated[i1] = silu_f32(gate1) * up1;\\n            }\\n        }\\n\\n        __syncthreads();\\n\\n        if (active) {\\n            const int64_t w2_e_base = (int64_t)e * (int64_t)dim * (int64_t)inter_dim;\\n            const float* fc2_e = fc2_scale + (int64_t)e * (int64_t)fc2_scale_stride;\\n\\n            for (int o = tid; o < dim; o += blockDim.x) {\\n                const int ob = o >> 7;\\n                const int ob_off = ob * fc2_col_blocks;\\n                float sum = 0.0f;\\n                const int64_t w2_row_base = w2_e_base + (int64_t)o * (int64_t)inter_dim;\\n\\n                for (int i = 0; i < inter_dim; ++i) {\\n                    const int ib = i >> 7;\\n                    const float ws = fc2_e[ob_off + ib];\\n                    const float w = fp8_e4m3fnuz_to_float(w2_q[w2_row_base + i]) * ws;\\n                    sum += activated[i] * w;\\n                }\\n                out_accum[o] += rw * sum;\\n            }\\n        }\\n\\n        __syncthreads();\\n    }\\n\\n    const int64_t out_base = (int64_t)t * (int64_t)dim;\\n    for (int o = tid; o < dim; o += blockDim.x) {\\n        out[out_base + o] = float_to_bf16_bits(out_accum[o]);\\n    }\\n}\\n\\n} // namespace\\n\\ntorch::Tensor fused_moe_forward(\\n    torch::Tensor input_q,\\n    torch::Tensor w1_q,\\n    torch::Tensor w2_q,\\n    torch::Tensor topk_weights,\\n    torch::Tensor topk_ids,\\n    torch::Tensor input_scale,\\n    torch::Tensor fc1_scale,\\n    torch::Tensor fc2_scale\\n) {\\n    TORCH_CHECK(input_q.is_cuda(), \\\"input_q must be a GPU tensor\\\");\\n    TORCH_CHECK(w1_q.is_cuda() && w2_q.is_cuda() && topk_weights.is_cuda() && topk_ids.is_cuda() &&\\n                input_scale.is_cuda() && fc1_scale.is_cuda() && fc2_scale.is_cuda(),\\n                \\\"All runtime tensors must be on GPU\\\");\\n\\n    const auto dev = input_q.device();\\n    TORCH_CHECK(w1_q.device() == dev && w2_q.device() == dev && topk_weights.device() == dev &&\\n                topk_ids.device() == dev && input_scale.device() == dev &&\\n                fc1_scale.device() == dev && fc2_scale.device() == dev,\\n                \\\"All runtime tensors must be on the same GPU device\\\");\\n\\n    TORCH_CHECK(input_q.element_size() == 1, \\\"input_q must be FP8/byte-backed tensor\\\");\\n    TORCH_CHECK(w1_q.element_size() == 1, \\\"w1_q must be FP8/byte-backed tensor\\\");\\n    TORCH_CHECK(w2_q.element_size() == 1, \\\"w2_q must be FP8/byte-backed tensor\\\");\\n\\n    TORCH_CHECK(topk_weights.scalar_type() == at::kFloat, \\\"topk_weights must be float32\\\");\\n    TORCH_CHECK(input_scale.scalar_type() == at::kFloat, \\\"input_scale must be float32\\\");\\n    TORCH_CHECK(fc1_scale.scalar_type() == at::kFloat, \\\"fc1_scale must be float32\\\");\\n    TORCH_CHECK(fc2_scale.scalar_type() == at::kFloat, \\\"fc2_scale must be float32\\\");\\n    TORCH_CHECK(topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,\\n                \\\"topk_ids must be int32 or int64\\\");\\n\\n    TORCH_CHECK(input_q.is_contiguous() && w1_q.is_contiguous() && w2_q.is_contiguous() &&\\n                topk_weights.is_contiguous() && topk_ids.is_contiguous() &&\\n                input_scale.is_contiguous() && fc1_scale.is_contiguous() && fc2_scale.is_contiguous(),\\n                \\\"All tensors must be contiguous\\\");\\n\\n    TORCH_CHECK(input_q.dim() == 2, \\\"input_q must be [T, D]\\\");\\n    TORCH_CHECK(w1_q.dim() == 3, \\\"w1_q must be [E, 2I, D]\\\");\\n    TORCH_CHECK(w2_q.dim() == 3, \\\"w2_q must be [E, D, I]\\\");\\n    TORCH_CHECK(topk_weights.dim() == 2 && topk_ids.dim() == 2, \\\"topk tensors must be [T, K]\\\");\\n    TORCH_CHECK(input_scale.dim() == 2 && fc1_scale.dim() == 2 && fc2_scale.dim() == 2, \\\"scale tensors must be 2D\\\");\\n\\n    const int64_t tokens = input_q.size(0);\\n    const int64_t dim = input_q.size(1);\\n    const int64_t experts = w1_q.size(0);\\n    const int64_t inter2 = w1_q.size(1);\\n    TORCH_CHECK(inter2 % 2 == 0, \\\"w1_q second dim must be 2*inter_dim\\\");\\n    const int64_t inter_dim = inter2 / 2;\\n\\n    TORCH_CHECK(w1_q.size(2) == dim, \\\"w1_q shape mismatch\\\");\\n    TORCH_CHECK(w2_q.size(0) == experts && w2_q.size(1) == dim && w2_q.size(2) == inter_dim, \\\"w2_q shape mismatch\\\");\\n    TORCH_CHECK(topk_weights.size(0) == tokens && topk_ids.size(0) == tokens, \\\"topk token mismatch\\\");\\n\\n    const int64_t topk = topk_ids.size(1);\\n    TORCH_CHECK(topk_weights.size(1) == topk, \\\"topk_weights/topk_ids mismatch\\\");\\n\\n    TORCH_CHECK(dim % BLOCK_Q == 0, \\\"dim must be divisible by 128\\\");\\n    TORCH_CHECK(inter_dim % BLOCK_Q == 0, \\\"inter_dim must be divisible by 128\\\");\\n    TORCH_CHECK((2 * inter_dim) % BLOCK_Q == 0, \\\"2*inter_dim must be divisible by 128\\\");\\n\\n    TORCH_CHECK(input_scale.size(0) == tokens && input_scale.size(1) == dim / BLOCK_Q, \\\"input_scale shape mismatch\\\");\\n\\n    const int64_t fc1_expected = ((2 * inter_dim) / BLOCK_Q) * (dim / BLOCK_Q);\\n    const int64_t fc2_expected = (dim / BLOCK_Q) * (inter_dim / BLOCK_Q);\\n    TORCH_CHECK(fc1_scale.size(0) == experts && fc1_scale.size(1) == fc1_expected, \\\"fc1_scale shape mismatch\\\");\\n    TORCH_CHECK(fc2_scale.size(0) == experts && fc2_scale.size(1) == fc2_expected, \\\"fc2_scale shape mismatch\\\");\\n\\n    const int64_t shared_bytes = (dim + inter_dim) * (int64_t)sizeof(float);\\n    TORCH_CHECK(shared_bytes <= 64 * 1024, \\\"Shared memory requirement exceeds 64KB\\\");\\n\\n    c10::cuda::CUDAGuard device_guard(dev);\\n    auto out = torch::empty({tokens, dim}, input_q.options().dtype(at::kBFloat16));\\n    auto stream = at::cuda::getCurrentCUDAStream(input_q.get_device()).stream();\\n\\n    const uint8_t* input_q_ptr = reinterpret_cast<const uint8_t*>(input_q.data_ptr());\\n    const uint8_t* w1_q_ptr = reinterpret_cast<const uint8_t*>(w1_q.data_ptr());\\n    const uint8_t* w2_q_ptr = reinterpret_cast<const uint8_t*>(w2_q.data_ptr());\\n    const float* topk_w_ptr = topk_weights.data_ptr<float>();\\n    const float* in_s_ptr = input_scale.data_ptr<float>();\\n    const float* fc1_s_ptr = fc1_scale.data_ptr<float>();\\n    const float* fc2_s_ptr = fc2_scale.data_ptr<float>();\\n    uint16_t* out_ptr = reinterpret_cast<uint16_t*>(out.data_ptr<at::BFloat16>());\\n\\n    if (topk_ids.scalar_type() == at::kInt) {\\n        const int32_t* topk_i_ptr = topk_ids.data_ptr<int32_t>();\\n        fused_moe_kernel_opt<int32_t><<<static_cast<int>(tokens), THREADS, static_cast<size_t>(shared_bytes), stream>>>(\\n            input_q_ptr, w1_q_ptr, w2_q_ptr, topk_w_ptr, topk_i_ptr,\\n            in_s_ptr, fc1_s_ptr, fc2_s_ptr, out_ptr,\\n            static_cast<int>(tokens), static_cast<int>(dim), static_cast<int>(inter_dim),\\n            static_cast<int>(experts), static_cast<int>(topk)\\n        );\\n    } else {\\n        const int64_t* topk_i_ptr = topk_ids.data_ptr<int64_t>();\\n        fused_moe_kernel_opt<int64_t><<<static_cast<int>(tokens), THREADS, static_cast<size_t>(shared_bytes), stream>>>(\\n            input_q_ptr, w1_q_ptr, w2_q_ptr, topk_w_ptr, topk_i_ptr,\\n            in_s_ptr, fc1_s_ptr, fc2_s_ptr, out_ptr,\\n            static_cast<int>(tokens), static_cast<int>(dim), static_cast<int>(inter_dim),\\n            static_cast<int>(experts), static_cast<int>(topk)\\n        );\\n    }\\n\\n    C10_CUDA_KERNEL_LAUNCH_CHECK();\\n    return out;\\n}\\n\\\"\\\"\\\"\\n\\ncpp_src = r\\\"\\\"\\\"\\n#include <torch/extension.h>\\n\\ntorch::Tensor fused_moe_forward(\\n    torch::Tensor input_q,\\n    torch::Tensor w1_q,\\n    torch::Tensor w2