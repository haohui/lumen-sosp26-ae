x / BK2;\\n    const int kk2 = idx - c * BK2;\\n    const uint16_t* bptr = B + (block_n + c) * K + (k0 + (kk2 << 1));\\n    const uint32_t packed = load_bf16x2_u32(bptr);\\n    float f0, f1;\\n    unpack_bf16x2(packed, f0, f1);\\n    const int kbase = (kk2 << 1);\\n    Bs[kbase * BN + c] = f0;\\n    Bs[(kbase + 1) * BN + c] = f1;\\n  }\\n}\\n\\n__device__ __forceinline__ void load_tiles_fullmn_tailk_vec(\\n    const uint16_t* __restrict__ A,\\n    const uint16_t* __restrict__ B,\\n    float* __restrict__ As,\\n    float* __restrict__ Bs,\\n    int tid,\\n    int64_t block_m,\\n    int64_t block_n,\\n    int64_t k0,\\n    int64_t K) {\\n  for (int idx = tid; idx < BM * BK2; idx += THREADS_PER_BLOCK) {\\n    const int r = idx / BK2;\\n    const int kk2 = idx - r * BK2;\\n    const int64_t gk = k0 + (kk2 << 1);\\n\\n    float f0 = 0.0f, f1 = 0.0f;\\n    const uint16_t* aptr = A + (block_m + r) * K + gk;\\n    if (gk + 1 < K) {\\n      const uint32_t packed = load_bf16x2_u32(aptr);\\n      unpack_bf16x2(packed, f0, f1);\\n    } else if (gk < K) {\\n      f0 = bf16_to_float(*aptr);\\n    }\\n\\n    const int aoff = r * BK + (kk2 << 1);\\n    As[aoff] = f0;\\n    As[aoff + 1] = f1;\\n  }\\n\\n  for (int idx = tid; idx < BN * BK2; idx += THREADS_PER_BLOCK) {\\n    const int c = idx / BK2;\\n    const int kk2 = idx - c * BK2;\\n    const int64_t gk = k0 + (kk2 << 1);\\n\\n    float f0 = 0.0f, f1 = 0.0f;\\n    const uint16_t* bptr = B + (block_n + c) * K + gk;\\n    if (gk + 1 < K) {\\n      const uint32_t packed = load_bf16x2_u32(bptr);\\n      unpack_bf16x2(packed, f0, f1);\\n    } else if (gk < K) {\\n      f0 = bf16_to_float(*bptr);\\n    }\\n\\n    const int kbase = (kk2 << 1);\\n    Bs[kbase * BN + c] = f0;\\n    Bs[(kbase + 1) * BN + c] = f1;\\n  }\\n}\\n\\n__device__ __forceinline__ void load_tiles_edge_vec(\\n    const uint16_t* __restrict__ A,\\n    const uint16_t* __restrict__ B,\\n    float* __restrict__ As,\\n    float* __restrict__ Bs,\\n    int tid,\\n    int64_t block_m,\\n    int64_t block_n,\\n    int64_t k0,\\n    int64_t M,\\n    int64_t N,\\n    int64_t K) {\\n  for (int idx = tid; idx < BM * BK2; idx += THREADS_PER_BLOCK) {\\n    const int r = idx / BK2;\\n    const int kk2 = idx - r * BK2;\\n    const int64_t gm = block_m + r;\\n    const int64_t gk = k0 + (kk2 << 1);\\n\\n    float f0 = 0.0f, f1 = 0.0f;\\n    if (gm < M) {\\n      const uint16_t* aptr = A + gm * K + gk;\\n      if (gk + 1 < K) {\\n        const uint32_t packed = load_bf16x2_u32(aptr);\\n        unpack_bf16x2(packed, f0, f1);\\n      } else if (gk < K) {\\n        f0 = bf16_to_float(*aptr);\\n      }\\n    }\\n\\n    const int aoff = r * BK + (kk2 << 1);\\n    As[aoff] = f0;\\n    As[aoff + 1] = f1;\\n  }\\n\\n  for (int idx = tid; idx < BN * BK2; idx += THREADS_PER_BLOCK) {\\n    const int c = idx / BK2;\\n    const int kk2 = idx - c * BK2;\\n    const int64_t gn = block_n + c;\\n    const int64_t gk = k0 + (kk2 << 1);\\n\\n    float f0 = 0.0f, f1 = 0.0f;\\n    if (gn < N) {\\n      const uint16_t* bptr = B + gn * K + gk;\\n      if (gk + 1 < K) {\\n        const uint32_t packed = load_bf16x2_u32(bptr);\\n        unpack_bf16x2(packed, f0, f1);\\n      } else if (gk < K) {\\n        f0 = bf16_to_float(*bptr);\\n      }\\n    }\\n\\n    const int kbase = (kk2 << 1);\\n    Bs[kbase * BN + c] = f0;\\n    Bs[(kbase + 1) * BN + c] = f1;\\n  }\\n}\\n\\n__device__ __forceinline__ void compute_tile(\\n    const float* __restrict__ As,\\n    const float* __restrict__ Bs,\\n    float acc[TM][TN],\\n    int local_row_base,\\n    int local_col_base) {\\n#pragma unroll\\n  for (int kk = 0; kk < BK; ++kk) {\\n    float a_frag[TM];\\n    float b_frag[TN];\\n\\n#pragma unroll\\n    for (int i = 0; i < TM; ++i) {\\n      a_frag[i] = As[(local_row_base + i) * BK + kk];\\n    }\\n#pragma unroll\\n    for (int j = 0; j < TN; ++j) {\\n      b_frag[j] = Bs[kk * BN + (local_col_base + j)];\\n    }\\n\\n#pragma unroll\\n    for (int i = 0; i < TM; ++i) {\\n#pragma unrol