+    @staticmethod
+    def _extract_compiler_diagnostics(
+        *,
+        exec_log_full: str,
+        max_lines: int = 120,
+        max_chars: int = 20000,
+    ) -> str:
+        """
+        Keep the most actionable compile diagnostics (file:line:error style, fatal
+        errors, linker errors, and framework BuildError/Traceback lines) so they
+        still reach the next-round prompt even when logs are long.
+        """
+        src = str(exec_log_full or "")
+        if not src:
+            return ""
+        keys = (
+            " error:",
+            " fatal error:",
+            "undefined reference",
+            "ld: error",
+            "ninja: build stopped",
+            "failed:",
+            "builderror:",
+            "traceback",
+        )
+        picked: list[str] = []
+        seen: set[str] = set()
+        for raw in src.splitlines():
+            line = str(raw.rstrip())
+            low = line.lower()
+            if any(k in low for k in keys):
+                if line not in seen:
+                    seen.add(line)
+                    picked.append(line)
+                    if len(picked) >= int(max_lines):
+                        break
+        out = "\n".join(picked).strip()
+        if not out:
+            return ""
+        if max_chars > 0 and len(out) > int(max_chars):
+            out = out[: int(max_chars)] + "\n...<compiler diagnostics truncated>..."
+        return out
