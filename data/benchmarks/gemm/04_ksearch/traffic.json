1;\\n  }\\n}\\n\\n__device__ __forceinline__ void compute_tile(\\n    const float* __restrict__ As,\\n    const float* __restrict__ Bs,\\n    float acc[TM][TN],\\n    int local_row_base,\\n    int local_col_base) {\\n#pragma unroll\\n  for (int kk = 0; kk < BK; ++kk) {\\n    float a_frag[TM];\\n    float b_frag[TN];\\n\\n#pragma unroll\\n    for (int i = 0; i < TM; ++i) {\\n      a_frag[i] = As[(local_row_base + i) * BK + kk];\\n    }\\n#pragma unroll\\n    for (int j = 0; j < TN; ++j) {\\n      b_frag[j] = Bs[kk * BN + (local_col_base + j)];\\n    }\\n\\n#pragma unroll\\n    for (int i = 0; i < TM; ++i) {\\n#pragma unroll\\n      for (int j = 0; j < TN; ++j) {\\n        acc[i][j] += a_frag[i] * b_frag[j];\\n      }\\n    }\\n  }\\n}\\n}  // namespace\\n\\n__global__ __launch_bounds__(THREADS_PER_BLOCK) void gemm_bf16_var_mnk_kernel(\\n    const uint16_t* __restrict__ A,\\n    const uint16_t* __restrict__ B,\\n    uint16_t* __restrict__ C,\\n    int64_t M,\\n    int64_t N,\\n    int64_t K) {\\n  const int tx = threadIdx.x;\\n  const int ty = threadIdx.y;\\n  const int tid = ty * THREADS_X + tx;\\n\\n  const int64_t block_m = static_cast<int64_t>(blockIdx.y) * BM;\\n  const int64_t block_n = static_cast<int64_t>(blockIdx.x) * BN;\\n\\n  const int local_row_base = ty * TM;\\n  const int local_col_base = tx * TN;\\n\\n  __shared__ float As[2][BM * BK];\\n  __shared__ float Bs[2][BK * BN];\\n\\n  float acc[TM][TN];\\n#pragma unroll\\n  for (int i = 0; i < TM; ++i) {\\n#pragma unroll\\n    for (int j = 0; j < TN; ++j) {\\n      acc[i][j] = 0.0f;\\n    }\\n  }\\n\\n  if (BK >= 2) {\\n    mfma_touch(0, 0, 0, 0);\\n  }\\n\\n  const bool full_m = (block_m + BM) <= M;\\n  const bool full_n = (block_n + BN) <= N;\\n\\n  if (K > 0) {\\n    int buf = 0;\\n    int64_t k0 = 0;\\n\\n    if (full_m && full_n) {\\n      if (k0 + BK <= K) {\\n        load_tiles_fullk_vec(A, B, As[buf], Bs[buf], tid, block_m, block_n, k0, K);\\n      } else {\\n        load_tiles_fullmn_tailk_vec(A, B,