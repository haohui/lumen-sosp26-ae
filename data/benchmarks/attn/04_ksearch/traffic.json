const int key_local = i >> 4;\\n                const int qd = kd + kk;\\n\\n                s_qrep[i] = s_qvec[qd];\\n\\n                const int s_idx = ks + key_local;\\n                if(s_idx < S && s_idx <= t)\\n                {\\n                    const int64_t k_base = idx4_bshd(b, s_idx, hkv, 0, S, Hkv, D);\\n                    s_kfrag[i] = k_b[k_base + qd];\\n                }\\n                else\\n                {\\n                    s_kfrag[i] = bfloat16_t{};\\n                }\\n            }\\n\\n            __syncthreads();\\n            load_matrix_sync(aFrag, s_qrep, WMMA_K);\\n            load_matrix_sync(bFrag, s_kfrag, WMMA_K);\\n            mma_sync(cFrag, aFrag, bFrag, cFrag);\\n            __syncthreads();\\n        }\\n\\n        store_matrix_sync(s_scores, cFrag, WMMA_N, mem_row_major);\\n        __syncthreads();\\n\\n        int key_limit = ks + WMMA_N;\\n        if(key_limit > t + 1)\\n            key_limit = t + 1;\\n        if(key_limit > S)\\n            key_limit = S;\\n\\n#pragma unroll\\n        for(int s_idx = ks; s_idx < key_limit; ++s_idx)\\n        {\\n            float alpha_lane = 1.0f;\\n            float beta_lane = 0.0f;\\n\\n            if(lane == 0)\\n            {\\n                const float score = s_scores[s_idx - ks] * sm_scale;\\n                const float m_new = fmaxf(m, score);\\n                alpha_lane = expf(m - m_new);\\n                beta_lane = expf(score - m_new);\\n                l = l * alpha_lane + beta_lane;\\n                m = m_new;\\n            }\\n\\n            const float alpha = __shfl(alpha_lane, 0);\\n            const float beta = __shfl(beta_lane, 0);\\n\\n            const int64_t v_base = idx4_bshd(b, s_idx, hkv, 0, S, Hkv, D);\\n            const float vv0 = __bfloat162float(v[v_base + d0]);\\n            const float vv1 = __bfloat162float(v[v_base + d1]);\\n\\n            acc0 = acc0 * alpha + beta * vv0;\\n            acc1 = acc1 * alpha + beta * vv1;\\n        }\\