new file mode 100644
index 0000000..d8d5344
--- /dev/null
+++ b/k_search/tasks/flashinfer_bench_amd_helpers.py
@@ -0,0 +1,114 @@
+"""AE MoE input compatibility for FlashInfer-Bench tasks."""
+
+from __future__ import annotations
+
+import sys
+from typing import Any, Dict, Optional
+
+_PATCH_INSTALLED = False
+
+
+def _is_target_moe_definition(definition: Any) -> bool:
+    try:
+        if str(getattr(definition, "op_type", "") or "").strip().lower() != "moe":
+            return False
+        inputs = getattr(definition, "inputs", None)
+        if not isinstance(inputs, dict):
+            return False
+        required = {
+            "input_q",
+            "w1_q",
+            "w2_q",
+            "topk_weights",
+            "topk_ids",
+            "input_scale",
+            "fc1_scale",
+            "fc2_scale",
+        }
+        return required.issubset(set(inputs.keys()))
+    except Exception:
+        return False
+
+
+def install_flashinfer_moe_inputs_patch() -> None:
+    """
+    Patch only AE MoE constrained random inputs.
+
+    FlashInfer-Bench's generic random generator is valid for GEMM/attention, but
+    it cannot express MoE routing/scaling constraints: topk_ids must be valid
+    expert IDs, topk_weights should be normalized routing weights, and block
+    scales must be positive.
+    """
+    global _PATCH_INSTALLED
+    if _PATCH_INSTALLED:
+        return
+
+    try:
+        import torch  # type: ignore
+        import flashinfer_bench.bench.utils as fb_utils  # type: ignore
+        from flashinfer_bench.utils import dtype_str_to_torch_dtype  # type: ignore
+    except Exception:
+        return
+
+    orig_gen_inputs = fb_utils.gen_inputs
+
+    def _patch_moe_constrained_inputs(
+        definition: Any,
+        wl: Any,
+        device: str,
+        out: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        shapes = definition.get_input_shapes(wl.axes)
+        dev = torch.device(device)
+        seed_base = 20260331
+        tokens = int(shapes["input_q"][0])
+        num_experts = int(shapes["w1_q"][0])
+        topk = int(shapes["topk_ids"][1])
+
+        def _dtype(name: str):
+            return dtype_str_to_torch_dtype(definition.inputs[name].dtype)
+
+        generator = torch.Generator(device=str(dev))
+        generator.manual_seed(seed_base + tokens)
+
+        def _rand_pos(name: str, mean: float, std: float) -> "torch.Tensor":
+            shape = tuple(int(x) for x in shapes[name])
+            value = torch.randn(shape, dtype=torch.float32, device=dev, generator=generator) * std + mean
+            return value.clamp_min(1e-8).to(_dtype(name))
+
+        scores = torch.randn(
+            (tokens, num_experts),
+            dtype=torch.float32,
+            device=dev,
+            generator=generator,
+        )
+        topk_val, topk_idx = torch.topk(scores, k=topk, dim=-1, largest=True, sorted=True)
+        out["topk_weights"] = torch.softmax(topk_val, dim=-1).to(_dtype("topk_weights"))
+        out["topk_ids"] = topk_idx.to(_dtype("topk_ids"))
+        out["input_scale"] = _rand_pos("input_scale", mean=1e-1, std=2e-2)
+        out["fc1_scale"] = _rand_pos("fc1_scale", mean=1e-2, std=2e-3)
+        out["fc2_scale"] = _rand_pos("fc2_scale", mean=1e-2, std=2e-3)
+        return out
+
+    def patched_gen_inputs(
+        definition: Any,
+        wl: Any,
+        device: str,
+        stensors: Optional[Dict[str, Any]] = None,
+    ) -> Dict[str, Any]:
+        out = orig_gen_inputs(definition, wl, device=device, stensors=stensors)
+        if _is_target_moe_definition(definition):
+            return _patch_moe_constrained_inputs(definition, wl, device, out)
+        return out
+
+    fb_utils.gen_inputs = patched_gen_inputs
+
+    for module_name in (
+        "flashinfer_bench.bench.evaluators.default",
+        "flashinfer_bench.bench.evaluators.sampling",
+    ):
+        module = sys.modules.get(module_name)
+        if module is not None:
+            setattr(module, "gen_inputs", patched_gen_inputs)
+
+    _PATCH_INSTALLED = True
