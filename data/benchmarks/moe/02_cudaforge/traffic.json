round\": false,\n  \"billing\": {\n    \"payer\": \"developer\"\n  },\n  \"completed_at\": 1774914597,\n  \"error\": null,\n  \"frequency_penalty\": 0.0,\n  \"incomplete_details\": null,\n  \"instructions\": null,\n  \"max_output_tokens\": 16384,\n  \"max_tool_calls\": null,\n  \"model\": \"gpt-5.3-codex\",\n  \"output\": [\n    {\n      \"id\": \"rs_096470f1a7722d150069cb0bacd50881948d78c297f672f125\",\n      \"type\": \"reasoning\",\n      \"summary\": []\n    },\n    {\n      \"id\": \"msg_096470f1a7722d150069cb0be1afcc819497b299b5186efc92\",\n      \"type\": \"message\",\n      \"status\": \"completed\",\n      \"content\": [\n        {\n          \"type\": \"output_text\",\n          \"annotations\": [],\n          \"logprobs\": [],\n          \"text\": \"```python\\nimport torch\\nimport torch.nn as nn\\nfrom torch.utils.cpp_extension import load_inline\\n\\nsource = r\\\"\\\"\\\"\\n#include <torch/extension.h>\\n#include <ATen/cuda/CUDAContext.h>\\n#include <c10/cuda/CUDAGuard.h>\\n#include <c10/cuda/CUDAException.h>\\n#include <stdint.h>\\n#include <math.h>\\n\\n#if defined(__HIP_PLATFORM_AMD__) || defined(__HIPCC__)\\n#include <hip/hip_runtime.h>\\n#endif\\n\\nnamespace {\\n\\nconstexpr int BLOCK_Q = 128;\\nconstexpr int THREADS = 256;\\nconstexpr int FC1_ROWS_PER_THREAD = 2;\\n\\n// Optimization: replace ldexpf/branch-heavy FP8 decode with bit-manip decode.\\n__device__ __forceinline__ float fp8_e4m3fnuz_to_float_fast(uint8_t v) {\\n    const uint32_t sign = (uint32_t)(v & 0x80u) << 24; // move sign to bit31\\n    const uint32_t exp  = ((uint32_t)v >> 3) & 0x0Fu;\\n    const uint32_t man  = (uint32_t)(v & 0x07u);\\n\\n    if (exp != 0u) {\\n        // value = (1 + man/8) * 2^(exp-8)\\n        // fp32 exponent = (exp - 8 + 127) = exp + 119\\n        union { uint32_t u; float f; } cvt;\\n        cvt.u = sign | ((exp + 119u) << 23) | (man << 20);\\n        return cvt.f;\\n    } else {\\n        // subnormal: man * 2^-10\\n        float out = (float)man * 0.0009765625f; // 2^-10\\n        if (sign) out = -out;\\n        return out;\\n    }\\n}\\n\\n__device__ __forceinline__ float silu_f32(float x) {\\n    return x / (1.0f + expf(-x));\\n}\\n\\n__device__ __forceinline__ uint16_t float_to_bf16_bits(float x) {\\n    union { float f; uint32_t u; } v;\\n    v.f = x;\\n    uint32_t lsb = (v.u >> 16) & 1u;\\n    v.u += 0x7FFFu + lsb;\\n    return (uint16_t)(v.u >> 16);\\n}\\n\\ntemplate <typename index_t>\\n__global__ __launch_bounds__(THREADS, 2) void fused_moe_kernel_opt(\\n    const uint8_t* __restrict__ input_q,      // [T, D] fp8 bytes\\n    const uint8_t* __restrict__ w1_q,         // [E, 2I, D] fp8 bytes\\n    const uint8_t* __restrict__ w2_q,         // [E, D, I] fp8 bytes\\n    const float* __restrict__ topk_weights,   // [T, K]\\n    const index_t* __restrict__ topk_ids,     // [T, K]\\n    const float* __restrict__ input_scale,    // [T, D/128]\\n    const float* __restrict__ fc1_scale,      // [E, (2I/128)*(D/128)]\\n    const float* __restrict__ fc2_scale,      // [E, (D/128)*(I/128)]\\n    uint16_t* __restrict__ out,               // [T, D] bf16 bits\\n    int tokens,\\n    int dim,\\n    int inter_dim,\\n    int experts,\\n    int topk\\n) {\\n    const int t = (int)blockIdx.x;\\n    if (t >= tokens) return;\\n    const int tid = (int)threadIdx.x;\\n\\n    extern __shared__ float smem[];\\n    float* out_accum = smem;          // [dim]\\n    float* activated = smem + dim;    // [inter_dim]\\n\\n    for (int o = tid; o < dim; o += blockDim.x) {\\n        out_accum[o] = 0.0f;\\n    }\\n    __syncthreads();\\n\\n    const int dim_blocks = dim / BLOCK_Q;\\n    const int fc1_row_blocks = (2 * inter_dim) / BLOCK_Q;\\n    const int fc1_scale_stride = fc1_row_blocks * dim_blocks;\\n\\n    const int fc2_row_blocks = dim / BLOCK_Q;\\n    const int fc2_col_blocks = inter_dim / BLOCK_Q;\\n    const int fc2_scale_stride = fc2_row_blocks * fc2_col_blocks;\\n\\n    const int64_t input_base = (int64_t)t * (int64_t)dim;\\n    const int64_t topk_base = (int64_t)t * (int64_t)topk;\\n    const int64_t in_scale_base = (int64_t)t * (int64_t)dim_blocks;\\n\\n    const uint8_t* x_ptr = input_q + input_base;\\n    const float* in_s_ptr = input_scale + in_scale_base;\\n\\n    for (int k = 0; k < topk; ++k) {\\n        const int64_t e_raw = (int64_t)topk_ids[topk_base + k];\\n        const int e = (int)e_raw;\\n        const float rw = topk_weights[topk_base + k];\\n        const bool active = ((unsigned)e < (unsigned)experts) && (rw != 0.0f);\\n\\n        if (active) {\\n            const int64_t w1_e_base = (int64_t)e * (int64_t)(2 * inter_dim) * (int64_t)dim;\\n            const float* fc1_e = fc1_scale + (int64_t)e * (int64_t)fc1_scale_stride;\\n\\n            for (int base_i = tid; base_i < inter_dim; base_i += blockDim.x * FC1_ROWS_PER_THREAD) {\\n                const int i0 = base_i;\\n                const int i1 = base_i + blockDim.x;\\n                const bool v0 = (i0 < inter_dim);\\n                const bool v1 = (i1 < inter_dim);\\n\\n                float gate0 = 0.0f, up0 = 0.0f;\\n                float gate1 = 0.0f, up1 = 0.0f;\\n\\n                int rb_g0 = 0, rb_u0 = 0, rb_g1 = 0, rb_u1 = 0;\\n                int64_t row_g0_base = 0, row_u0_base = 0, row_g1_base = 0, row_u1_base = 0;\\n\\n                if (v0) {\\n                    const int row_g0 = i0;\\n                    const int row_u0 = i0 + inter_dim;\\n                    rb_g0 = row_g0 >> 7;\\n                    rb_u0 = row_u0 >> 7;\\n                    row_g0_base = w1_e_base + (int64_t)row_g0 * (int64_t)dim;\\n                    row_u0_base = w1_e_base + (int64_t)row_u0 * (int64_t)dim;\\n                }\\n                if (v1) {\\n                    const int row_g1 = i1;\\n                    const int row_u1 = i1 + inter_dim;\\n                    rb_g1 = row_g1 >> 7;\\n                    rb_u1 = row_u1 >> 7;\\n                    row_g1_base = w1_e_base + (int64_t)row_g1 * (int64_t)dim;\\n       